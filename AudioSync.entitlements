<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- build.sh signs every build with the Hardened Runtime, which denies these
     unless they are granted here. -->
<plist version="1.0">
<dict>
    <!-- Input devices as a source (microphone, line-in, audio interface). -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Now Playing: Apple Events to Spotify and Music. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
