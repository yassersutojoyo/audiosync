// The About dialog, opened from Help > About AudioSync. OK or Escape closes
// it.
//
// It names AudioSync's copyright holder and license (GPL-3.0 for the built exe,
// no warranty), and credits Slint with its AboutSlint widget. Keep both.

import { AboutSlint, VerticalBox } from "std-widgets.slint";
import { Tokens } from "tokens.slint";
import { Strings } from "strings.slint";
import { BrandMark, DialogButton, Fluent, Wordmark } from "widgets.slint";

export component AboutDialog inherits Dialog {
    in property <string> version;
    in property <string> core-version;

    title: Strings.menu-about;
    icon: @image-url("../res/audiosync-256.png");
    background: Tokens.background;
    preferred-width: 360px;
    default-font-family: Fluent.font;
    // Key events go to the focused item, so Escape needs the scope focused.
    forward-focus: keys;

    // OK or Escape.
    callback closed();

    // Called each time the dialog opens, so Escape works before anything
    // inside is clicked.
    public function take-focus() {
        keys.focus();
    }

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.closed();
                return accept;
            }
            return reject;
        }

        VerticalBox {
            alignment: start;

            HorizontalLayout {
                alignment: center;
                padding-top: 8px;

                BrandMark {
                    running: true;
                    width: 48px;
                    height: 48px;
                }
            }

            // Narrator reads the wordmark as "AudioSync".
            HorizontalLayout {
                alignment: center;

                Wordmark {
                    size: 24px;
                }
            }

            Text {
                text: Strings.version(root.version);
                color: Tokens.text;
                horizontal-alignment: center;
            }

            Text {
                text: Strings.core-version(root.core-version);
                font-size: Tokens.font-size-caption;
                color: Tokens.secondary-text;
                horizontal-alignment: center;
            }

            Text {
                text: Strings.about-copyright;
                font-size: Tokens.font-size-caption;
                color: Tokens.secondary-text;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Text {
                text: Strings.about-license;
                font-size: Tokens.font-size-caption;
                color: Tokens.secondary-text;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            // The badge at its smallest height, its width kept to the
            // badge's own proportions (212 by 97) so it isn't stretched.
            HorizontalLayout {
                alignment: center;

                AboutSlint {
                    width: 129px;
                    height: self.min-height;
                }
            }
        }
    }

    DialogButton {
        text: Strings.ok;
        primary: true;
        dialog-button-role: accept;
        clicked => {
            root.closed();
        }
        escape-pressed => {
            root.closed();
        }
    }
}
