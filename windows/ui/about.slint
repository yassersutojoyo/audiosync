// The About dialog, opened from Help > About AudioSync.
//
// Slint is used under its royalty-free license, which asks for the AboutSlint
// widget in an About dialog reachable from the top-level menu. Keep it here.

import { AboutSlint, StandardButton, VerticalBox } from "std-widgets.slint";
import { Tokens } from "tokens.slint";
import { Strings } from "strings.slint";
import { Fluent } from "widgets.slint";

export component AboutDialog inherits Dialog {
    in property <string> version;
    in property <string> core-version;

    title: Strings.menu-about;
    icon: @image-url("../res/audiosync-256.png");
    background: Tokens.background;
    preferred-width: 360px;
    default-font-family: Fluent.font;

    VerticalBox {
        alignment: start;

        Text {
            text: Strings.app-name;
            font-size: Tokens.font-size-title;
            font-weight: 600;
            color: Tokens.text;
            horizontal-alignment: center;
        }

        Text {
            text: Strings.version(root.version);
            color: Tokens.text;
            horizontal-alignment: center;
        }

        Text {
            text: Strings.core-version(root.core-version);
            font-size: Tokens.font-size-caption;
            color: Tokens.secondary-text;
            horizontal-alignment: center;
        }

        AboutSlint { }
    }

    StandardButton {
        kind: ok;
    }
}
