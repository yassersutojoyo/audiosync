// Generated by scripts/brand/tokens.py from brand/tokens.json. Do not edit.
//
// AudioSync's design tokens (brand/tokens.json). Colors follow the system's
// light or dark mode through the style's palette.

import { Palette } from "std-widgets.slint";

export global Tokens {
    // True while Windows uses dark mode for apps.
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    // Brand teal: the mark, the app accent, filled indicators. Only 3.27:1 on white, so never for
    // small text.
    out property <color> teal: #1c9f91;

    // Brand mint: the mark and "sync" on dark backgrounds.
    out property <color> mint: #63dac2;

    // The mark and "sync" in the wordmark: teal on light, mint on dark.
    out property <color> logo: root.dark ? #63dac2 : #1c9f91;

    // Teal for small text and text-sized glyphs (WCAG AA): 5.85:1 on white, 5.07:1 on #323232.
    out property <color> teal-text: root.dark ? #20b6a6 : #147167;

    // Deep teal (website).
    out property <color> teal-deep: #0f574f;

    // Pastel accent (website backdrop).
    out property <color> sky: #8fd3e8;

    // Pastel accent (website backdrop).
    out property <color> aqua: #b5ece2;

    // Body text: charcoal on light, off-white on dark (the wordmark's "audio").
    out property <color> text: root.dark ? #f6f6f6 : #292929;

    // Secondary text on the website and the Windows app.
    out property <color> muted: root.dark ? #b8c2c0 : #525c5a;

    // Window and page background.
    out property <color> background: root.dark ? #1e1e1e : #f1f7f6;

    // Cards and the tray flyout.
    out property <color> surface: root.dark ? #2b2b2b : #ffffff;

    // A playing speaker's row: the brand teal at 8% on the surface, as on the Mac.
    out property <color> playing-row: root.dark ? #2a3433 : #edf7f6;

    // Notice background: the Mac's orange notice tint (12%) on the surface.
    out property <color> notice: root.dark ? #443927 : #fff2e0;

    // Card borders and dividers (decorative, no contrast requirement).
    out property <color> separator: root.dark ? #3d3d3d : #d9dedd;

    // Keyboard focus ring (3:1 against the surface and the background).
    out property <color> focus: root.dark ? #63dac2 : #147167;

    // Secondary text on the Mac is the primary label color at this opacity: 5.59:1 on a light
    // window, 6.64:1 on a dark one (Brand.swift).
    out property <float> secondary-text-opacity: 0.7;

    // Rows and controls that can't be used right now.
    out property <float> disabled-opacity: 0.45;

    // Secondary text: the text color at the secondary-text opacity, as on the Mac.
    out property <color> secondary-text: root.text.with-alpha(root.secondary-text-opacity);

    // The wordmark typeface (SIL OFL 1.1). Tracking is in em. User interface text uses the system
    // font (SF Pro on macOS, Segoe UI Variable on Windows).
    out property <string> brand-font: "Poppins";
    out property <int> brand-font-weight: 500;
    // Letter spacing of the wordmark, in em.
    out property <float> brand-tracking: -0.02;
    out property <length> font-size-wordmark: 21px;
    out property <length> font-size-title: 20px;
    out property <length> font-size-body: 14px;
    out property <length> font-size-callout: 13px;
    out property <length> font-size-caption: 12px;

    // Distances in points (macOS) and logical pixels (Windows), as the Mac main window uses them.
    out property <length> spacing-window-margin: 20px;
    out property <length> spacing-column-gap: 16px;
    out property <length> spacing-card-gap: 12px;
    out property <length> spacing-card-padding: 12px;
    out property <length> spacing-row-padding-x: 10px;
    out property <length> spacing-row-padding-y: 8px;
    out property <length> spacing-section-gap: 18px;
    out property <length> spacing-panel-padding: 12px;

    // Corner radii in points (macOS), logical pixels (Windows) and CSS pixels (website).
    out property <length> radius-card: 12px;
    out property <length> radius-row: 9px;
    out property <length> radius-control: 7px;
    out property <length> radius-panel: 14px;
    out property <length> radius-site-large: 30px;
    out property <length> radius-site-medium: 22px;
    out property <length> radius-pill: 999px;
}
