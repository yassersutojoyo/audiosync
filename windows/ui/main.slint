// The main window: the same sections as the macOS app's main window, in the
// same order. Header (mark, wordmark, status, streaming switch), notices,
// then a left column (audio source, Now Playing, master volume, equalizer)
// and the speaker list (This PC, Groups, Connected Speakers). The menu bar
// carries the Windows shortcuts. Tab order follows the reading order.

import { ComboBox, ScrollView } from "std-widgets.slint";
import { Tokens } from "tokens.slint";
import { Strings } from "strings.slint";
import { Appearance, CastList, GroupItem, NoticeItem, RowPart, RowState, SpeakerItem } from "types.slint";
import { AirPlayDelayControls, Announcer, BrandMark, Card, Divider, Fluent, Glyph, Glyphs, GroupRow, IconButton, NoticeStack, SecondaryText, SectionTitle, SpeakerRow, ToggleSwitch, VolumeSlider, Wordmark } from "widgets.slint";

export { AboutDialog } from "about.slint";
export { EqualizerWindow } from "equalizer.slint";
export { TrayFlyout } from "flyout.slint";
export { GroupNameDialog, PasswordDialog, PinDialog } from "dialogs.slint";
export { GuideWindow } from "guide.slint";
export { HelpWindow } from "help.slint";
export { RemoteWindow } from "remote.slint";
export { Strings } from "strings.slint";
// The style's palette, for the theme preview (src/view.rs).
export { Palette } from "std-widgets.slint";
// The brand teal, for the standard controls' accent (src/view.rs).
export { Tokens } from "tokens.slint";
export { AirPlayProblem, Appearance, Availability, CastList, CastProblem, CastState, DeviceVolumeHint, GroupItem, GuidePage, GuideStepItem, NoticeItem, NoticeKind, PinPhase, RowPart, RowState, SpeakerItem, SpeakerKind } from "types.slint";

// A titled card of speaker rows, with a note when it has none.
component SpeakerSection inherits VerticalLayout {
    in property <string> title;
    in property <[SpeakerItem]> speakers;
    in property <string> note;
    callback toggled(string);
    callback volume-changed(string, float);
    callback sync-toggled(string);
    callback blank-clicked();
    callback delay-stepped(string, int);
    callback delay-edited(string, string);
    callback delay-committed(string);
    callback delay-cancelled(string);
    callback auto-connect-toggled(string, bool);
    callback forget-pairing(string);
    callback device-volume-fix(string);
    callback cast-muted(string, bool);
    callback cast-resync(string);
    callback calibrate(string);
    callback cancel-calibration();
    callback calibration-privacy();
    // The part of a row with the keyboard focus changed; none: it lost it.
    callback focus-changed(string, RowPart);
    // A row built while this is its speaker's ID, or already built when it
    // becomes it, takes the keyboard focus on focus-part and clears the ID
    // (see MainWindow).
    in-out property <string> focus-id;
    in-out property <RowPart> focus-part;

    spacing: 8px;
    accessible-role: groupbox;
    accessible-label: root.title;

    SectionTitle {
        text: root.title;
    }

    Card {
        inner-padding: 4px;

        for speaker[index] in root.speakers: VerticalLayout {
            if index > 0: HorizontalLayout {
                padding-left: Fluent.name-inset;
                padding-right: 8px;
                Divider { }
            }

            SpeakerRow {
                item: speaker;
                init => {
                    if speaker.id == root.focus-id {
                        root.focus-id = "";
                        self.take-focus(root.focus-part);
                    }
                }
                property <bool> focus-asked: speaker.id == root.focus-id;
                changed focus-asked => {
                    if self.focus-asked {
                        root.focus-id = "";
                        self.take-focus(root.focus-part);
                    }
                }
                focus-changed(part) => {
                    root.focus-changed(speaker.id, part);
                }
                toggled => {
                    root.toggled(speaker.id);
                }
                volume-changed(value) => {
                    root.volume-changed(speaker.id, value);
                }
                sync-toggled => {
                    root.sync-toggled(speaker.id);
                }
                blank-clicked => {
                    root.blank-clicked();
                }
                delay-stepped(delta) => {
                    root.delay-stepped(speaker.id, delta);
                }
                delay-edited(text) => {
                    root.delay-edited(speaker.id, text);
                }
                delay-committed => {
                    root.delay-committed(speaker.id);
                }
                delay-cancelled => {
                    root.delay-cancelled(speaker.id);
                }
                auto-connect-toggled(on) => {
                    root.auto-connect-toggled(speaker.id, on);
                }
                forget-pairing => {
                    root.forget-pairing(speaker.id);
                }
                device-volume-fix => {
                    root.device-volume-fix(speaker.id);
                }
                cast-muted(muted) => {
                    root.cast-muted(speaker.id, muted);
                }
                cast-resync => {
                    root.cast-resync(speaker.id);
                }
                calibrate => {
                    root.calibrate(speaker.id);
                }
                cancel-calibration => {
                    root.cancel-calibration();
                }
                calibration-privacy => {
                    root.calibration-privacy();
                }
            }
        }

        if root.note != "": VerticalLayout {
            if root.speakers.length > 0: Divider { }

            // Under a list, the note belongs to the last row's box: a click
            // works like one on that row. Alone, it is outside every row.
            // Inside the scroll view, so the window's own TouchArea doesn't
            // get it.
            TouchArea {
                clicked => {
                    if root.speakers.length > 0 && root.speakers[root.speakers.length - 1].has-delay {
                        root.sync-toggled(root.speakers[root.speakers.length - 1].id);
                    } else {
                        root.blank-clicked();
                    }
                }

                HorizontalLayout {
                    padding: 12px;
                    SecondaryText {
                        text: root.note;
                        font-size: Tokens.font-size-callout;
                    }
                }
            }
        }
    }
}

// The Equalizer card: opens the equalizer window and says whether it is on.
component EqualizerCard inherits Rectangle {
    in property <bool> on;
    callback clicked();

    // A Windows 11 settings card: the whole card is the button.
    background: touch.pressed ? Tokens.surface.mix(Tokens.text, 0.97) : touch.has-hover ? Tokens.surface.mix(Tokens.text, 0.95) : Tokens.surface;
    animate background { duration: Fluent.fast; }
    border-radius: Fluent.radius-card;
    border-width: 1px;
    border-color: Fluent.stroke;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: Strings.equalizer;
    accessible-value: root.on ? Strings.on : Strings.off;
    accessible-action-default => {
        root.clicked();
    }

    focus := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding: Fluent.card-padding;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 12px;

        Glyph {
            glyph: Glyphs.equalizer;
            color: Tokens.teal-text;
            width: 20px;
        }

        Text {
            text: Strings.equalizer;
            color: Tokens.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
            accessible-role: none;
        }

        if root.on: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: Tokens.teal;
            }
        }

        Text {
            text: root.on ? Strings.on : Strings.off;
            color: Tokens.secondary-text;
            font-size: Tokens.font-size-callout;
            vertical-alignment: center;
            accessible-role: none;
        }

        Glyph {
            glyph: Glyphs.chevron-right;
            font-size: Tokens.font-size-caption;
            color: Tokens.secondary-text;
        }
    }

    Rectangle {
        border-width: focus.has-focus ? 2px : 0px;
        border-color: Tokens.focus;
        border-radius: root.border-radius;
    }
}

// The Now Playing card: the track of the media session that counts for the
// chosen source, with Previous, Play or Pause, and Next, as on the Mac.
component NowPlayingCard inherits Card {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> playing;
    in property <bool> has-artwork;
    in property <image> artwork;
    // Which button has the keyboard focus (0 to 2), -1 for none: the app
    // hands the focus on before the card hides.
    in-out property <int> focused-button: -1;
    // 0 Previous, 1 Play or Pause, 2 Next.
    callback transport(int);

    accessible-role: groupbox;
    accessible-label: Strings.now-playing;

    VerticalLayout {
        spacing: 10px;

        HorizontalLayout {
            spacing: 12px;

            Rectangle {
                width: 56px;
                height: 56px;
                border-radius: Fluent.radius-card;
                clip: true;
                background: Tokens.text.with-alpha(0.06);

                if root.has-artwork: Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.artwork;
                    image-fit: cover;
                    accessible-role: none;
                }

                if !root.has-artwork: Glyph {
                    width: parent.width;
                    height: parent.height;
                    glyph: Glyphs.music-note;
                    color: Tokens.secondary-text;
                    font-size: 20px;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 3px;
                horizontal-stretch: 1;

                Text {
                    text: root.title;
                    font-weight: 600;
                    color: Tokens.text;
                    wrap: word-wrap;
                    overflow: elide;
                    // Two lines at most, as on the Mac.
                    height: min(self.preferred-height, 2 * 19px);
                }

                if root.subtitle != "": Text {
                    text: root.subtitle;
                    font-size: Tokens.font-size-callout;
                    color: Tokens.secondary-text;
                    overflow: elide;
                }
            }
        }

        HorizontalLayout {
            alignment: center;
            spacing: 20px;

            IconButton {
                glyph: Glyphs.previous;
                label: Strings.previous-track;
                clicked => {
                    root.transport(0);
                }
                focus-changed(has) => {
                    root.note-focus(0, has);
                }
            }

            IconButton {
                width: 40px;
                height: 40px;
                glyph: root.playing ? Glyphs.pause : Glyphs.play;
                glyph-size: 20px;
                label: root.playing ? Strings.pause : Strings.play;
                clicked => {
                    root.transport(1);
                }
                focus-changed(has) => {
                    root.note-focus(1, has);
                }
            }

            IconButton {
                glyph: Glyphs.next;
                label: Strings.next-track;
                clicked => {
                    root.transport(2);
                }
                focus-changed(has) => {
                    root.note-focus(2, has);
                }
            }
        }
    }

    function note-focus(button: int, has: bool) {
        if has {
            root.focused-button = button;
        } else if root.focused-button == button {
            root.focused-button = -1;
        }
    }
}

export component MainWindow inherits Window {
    in property <bool> running;
    in property <string> status;
    in property <[string]> sources;
    in property <int> source-index;
    in property <float> master-volume;
    in property <bool> equalizer-on;
    // The Now Playing card, while a media session counts for the source.
    in property <bool> now-playing-shown;
    in property <string> now-playing-title;
    in property <string> now-playing-subtitle;
    in property <bool> now-playing-playing;
    in property <bool> now-playing-has-artwork;
    in property <image> now-playing-artwork;
    in-out property <int> now-playing-focused-button: -1;
    in property <[SpeakerItem]> this-pc;
    in property <[SpeakerItem]> connected;
    in property <[GroupItem]> groups;
    in property <[NoticeItem]> notices;
    // What Narrator says about a new notice, while the app wants it said
    // here (empty otherwise).
    in property <string> notice-announcement;
    // View > Show Virtual Devices: virtual outputs are listed even while off.
    in property <bool> show-virtual-devices;
    in property <Appearance> appearance;
    in property <bool> switch-source-on-quit;
    // File > Launch at Sign-In: what the Run key says, read again by Rust.
    in property <bool> launch-at-login;
    // The AirPlay delay, shown while an AirPlay sender runs: what its field
    // shows (the applied value, or what is being typed).
    in property <bool> airplay-delay-shown;
    // Connected Speakers lists nothing only because Show Virtual Devices is
    // off and its outputs are virtual.
    in property <bool> connected-virtual-hidden;
    // AirPlay discovery runs but has found no speaker for 20 seconds.
    in property <bool> airplay-none-found;
    // What the Google Cast search says while it lists no speaker.
    in property <CastList> cast-list;
    in property <string> airplay-delay-text;
    // The AirPlay delay field holds typing not yet applied.
    in property <bool> airplay-delay-pending;
    // The AirPlay delay field holds a number out of range: the range and
    // what Enter applies; empty otherwise.
    in property <string> airplay-delay-range-hint;
    // A delay field, a speaker's or the AirPlay one, holds typing not yet
    // applied: File > Apply Typed Delay is enabled only then.
    in property <bool> delay-typing;

    callback power-toggled(bool);
    callback source-selected(int);
    callback master-volume-changed(float);
    callback equalizer-requested();
    // A Now Playing button: 0 Previous, 1 Play or Pause, 2 Next.
    callback now-playing-transport(int);
    callback speaker-toggled(string);
    callback speaker-volume-changed(string, float);
    callback sync-toggled(string);
    callback delay-stepped(string, int);
    callback delay-edited(string, string);
    // Enter in the speaker's delay field: apply what was typed.
    callback delay-committed(string);
    // Escape in the speaker's sync controls: drop every typed delay.
    callback delay-cancelled(string);
    callback airplay-delay-stepped(int);
    callback airplay-delay-edited(string);
    callback airplay-delay-committed();
    callback airplay-delay-cancelled();
    // A click on the window outside every speaker row: apply every typed
    // delay and close the sync controls.
    callback blank-clicked();
    // File > Apply Typed Delay (Ctrl+S, wherever the focus is): apply every
    // typed delay and keep the sync controls open.
    callback delay-apply-requested();
    callback auto-connect-toggled(string, bool);
    callback forget-pairing-requested(string);
    // The fix under a speaker's device-volume hint.
    callback device-volume-fix-requested(string);
    // A Google Cast speaker's Mute or Unmute, and its Resync.
    callback cast-muted-requested(string, bool);
    callback cast-resync-requested(string);
    // Calibrate with Microphone on a speaker's row, and its Cancel.
    callback calibrate-requested(string);
    callback cancel-calibration-requested();
    callback calibration-privacy-requested();
    callback group-toggled(string);

    callback group-rename-requested(string);
    callback group-deleted(string);
    callback new-group-requested();
    callback refresh-devices();
    callback show-virtual-devices-toggled(bool);
    callback appearance-chosen(Appearance);
    callback switch-source-on-quit-toggled(bool);
    callback launch-at-login-toggled(bool);
    // File > Web Remote…
    callback remote-requested();
    callback notice-dismissed(int);
    callback notices-dismissed-all();
    // Show How on a notice: open its guide.
    callback notice-guide-requested(int);
    // Retry on a notice: start AirPlay again.
    callback notice-retry-requested(int);
    // Open Privacy Settings on a notice.
    callback notice-privacy-requested(int);
    callback close-requested();
    callback exit-requested();
    callback about-requested();
    // Help > AudioSync Guide: open the Guide.
    callback help-requested();

    // Slint leaves nothing focused when a refresh removes the focused
    // control (a notice dismissed with the keyboard, a speaker unplugged):
    // Narrator goes quiet and Tab starts over. So the rows report their
    // keyboard focus, and when a refresh rebuilds the list that has it, the
    // app (src/view.rs) asks for the focus back: on the notice at this
    // index, or the speaker or group row with this ID (the same row, or its
    // neighbour when it went), which takes it on the given part as it is
    // built and clears the request. A row of another list, which isn't
    // rebuilt, takes it when the request names it (a list's last row went:
    // the other list's first row). Else the streaming switch takes it.
    callback notice-focus-changed(int, bool);
    callback dismiss-all-focus-changed(bool);
    callback speaker-focus-changed(string, RowPart);
    callback group-focus-changed(string, RowPart);
    in-out property <int> focus-notice-index: -1;
    in-out property <string> focus-speaker-id;
    in-out property <RowPart> focus-speaker-part;
    in-out property <string> focus-group-id;
    in-out property <RowPart> focus-group-part;

    public function focus-streaming-switch() {
        power.focus();
    }

    // The Now Playing card is about to hide with the focus on a button.
    public function focus-source() {
        source.focus();
    }

    title: Strings.main-window-title;
    icon: @image-url("../res/audiosync-256.png");
    // Wide enough for a speaker row next to the left column, and
    // short enough for a 1366 x 768 screen at 150 % (both columns scroll).
    min-width: 860px;
    min-height: 440px;
    preferred-width: 980px;
    preferred-height: 680px;
    background: Tokens.background;
    default-font-family: Fluent.font;
    default-font-size: Tokens.font-size-body;

    // Rust sets these; a user's click or drag replaces the controls' bindings,
    // so each control's handler also sets it back to the state after its
    // callback (a change the engine refused doesn't fire these).
    changed running => {
        power.checked = root.running;
    }
    changed source-index => {
        source.current-index = root.source-index;
    }

    MenuBar {
        Menu {
            title: Strings.menu-file;

            MenuItem {
                title: Strings.menu-apply-delay;
                shortcut: @keys(Control + S);
                enabled: root.delay-typing;
                activated => {
                    root.delay-apply-requested();
                }
            }

            MenuItem {
                title: Strings.menu-close-window;
                shortcut: @keys(Control + W);
                activated => {
                    root.close-requested();
                }
            }

            MenuSeparator { }

            MenuItem {
                title: Strings.switch-source-on-quit;
                checkable: true;
                checked: root.switch-source-on-quit;
                activated => {
                    root.switch-source-on-quit-toggled(!root.switch-source-on-quit);
                }
            }

            MenuItem {
                title: Strings.launch-at-login;
                checkable: true;
                checked: root.launch-at-login;
                activated => {
                    root.launch-at-login-toggled(!root.launch-at-login);
                }
            }

            MenuItem {
                title: Strings.menu-remote;
                activated => {
                    root.remote-requested();
                }
            }

            MenuSeparator { }

            MenuItem {
                title: Strings.menu-exit;
                shortcut: @keys(Control + Q);
                activated => {
                    root.exit-requested();
                }
            }
        }

        Menu {
            title: Strings.menu-speakers;

            MenuItem {
                title: root.running ? Strings.menu-turn-streaming-off : Strings.menu-turn-streaming-on;
                activated => {
                    root.power-toggled(!root.running);
                }
            }

            MenuSeparator { }

            MenuItem {
                title: Strings.new-group;
                shortcut: @keys(Control + N);
                activated => {
                    root.new-group-requested();
                }
            }

            MenuItem {
                title: Strings.refresh-devices;
                shortcut: @keys(F5);
                activated => {
                    root.refresh-devices();
                }
            }
        }

        Menu {
            title: Strings.menu-view;

            MenuItem {
                title: Strings.equalizer;
                shortcut: @keys(Control + E);
                activated => {
                    root.equalizer-requested();
                }
            }

            MenuSeparator { }

            MenuItem {
                title: Strings.show-virtual-devices;
                checkable: true;
                checked: root.show-virtual-devices;
                activated => {
                    root.show-virtual-devices-toggled(!root.show-virtual-devices);
                }
            }

            MenuSeparator { }

            Menu {
                title: Strings.appearance;

                MenuItem {
                    title: Strings.appearance-system;
                    checkable: true;
                    checked: root.appearance == Appearance.system;
                    activated => {
                        root.appearance-chosen(Appearance.system);
                    }
                }

                MenuItem {
                    title: Strings.appearance-light;
                    checkable: true;
                    checked: root.appearance == Appearance.light;
                    activated => {
                        root.appearance-chosen(Appearance.light);
                    }
                }

                MenuItem {
                    title: Strings.appearance-dark;
                    checkable: true;
                    checked: root.appearance == Appearance.dark;
                    activated => {
                        root.appearance-chosen(Appearance.dark);
                    }
                }
            }
        }

        Menu {
            title: Strings.menu-help;

            MenuItem {
                title: Strings.help-title;
                shortcut: @keys(F1);
                activated => {
                    root.help-requested();
                }
            }

            MenuSeparator { }

            MenuItem {
                title: Strings.menu-about;
                activated => {
                    root.about-requested();
                }
            }
        }
    }

    // Under everything else, so only clicks no control takes reach it.
    TouchArea {
        clicked => {
            root.blank-clicked();
        }
    }

    VerticalLayout {
        padding-left: Tokens.spacing-window-margin + 4px;
        padding-right: Tokens.spacing-window-margin + 4px;
        padding-top: 16px;
        padding-bottom: Tokens.spacing-window-margin;
        spacing: 20px;

        // Header: the brand and the state on the left, the switch on the right.
        HorizontalLayout {
            spacing: 12px;
            min-height: 44px;
            vertical-stretch: 0;

            VerticalLayout {
                alignment: center;
                BrandMark {
                    running: root.running;
                    width: 34px;
                    height: 34px;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 0px;

                Wordmark { }

                SecondaryText {
                    text: root.status;
                    font-size: Tokens.font-size-caption;
                    accessible-role: text;
                    accessible-label: self.text;
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            VerticalLayout {
                alignment: center;
                power := ToggleSwitch {
                    text: Strings.streaming-switch;
                    checked: root.running;
                    accessible-label: Strings.streaming-switch;
                    toggled => {
                        root.power-toggled(self.checked);
                        // Show what the engine did, even if it refused.
                        self.checked = root.running;
                    }
                }
            }
        }

        if root.notices.length > 0: NoticeStack {
            notices: root.notices;
            focus-index <=> root.focus-notice-index;
            notice-focus-changed(id, focused) => {
                root.notice-focus-changed(id, focused);
            }
            dismiss-all-focus-changed(focused) => {
                root.dismiss-all-focus-changed(focused);
            }
            dismissed(id) => {
                root.notice-dismissed(id);
            }
            dismissed-all => {
                root.notices-dismissed-all();
            }
            guide-requested(id) => {
                root.notice-guide-requested(id);
            }
            retry-requested(id) => {
                root.notice-retry-requested(id);
            }
            privacy-requested(id) => {
                root.notice-privacy-requested(id);
            }
        }

        HorizontalLayout {
            spacing: Tokens.spacing-window-margin;
            vertical-stretch: 1;

            // Left column: what plays and how loud, each in its own card. It
            // scrolls when the window is shorter than its cards (a small
            // screen, or notices showing), as the speaker list does.
            left-column := ScrollView {
                width: 268px;

                VerticalLayout {
                    // Room for the scroll bar, as in the speaker list.
                    padding-right: 4px;
                    spacing: 8px;
                    alignment: start;

                    Card {
                        VerticalLayout {
                            spacing: 10px;

                            HorizontalLayout {
                                spacing: 10px;

                                Glyph {
                                    glyph: Glyphs.source;
                                    color: Tokens.teal-text;
                                    width: 20px;
                                }

                                SectionTitle {
                                    text: Strings.source-label;
                                }
                            }

                            source := ComboBox {
                                model: root.sources;
                                current-index: root.source-index;
                                accessible-label: Strings.source-label;
                                selected => {
                                    root.source-selected(self.current-index);
                                    self.current-index = root.source-index;
                                }
                            }
                        }
                    }

                    if root.now-playing-shown: NowPlayingCard {
                        title: root.now-playing-title;
                        subtitle: root.now-playing-subtitle;
                        playing: root.now-playing-playing;
                        has-artwork: root.now-playing-has-artwork;
                        artwork: root.now-playing-artwork;
                        focused-button <=> root.now-playing-focused-button;
                        transport(button) => {
                            root.now-playing-transport(button);
                        }
                    }

                    Card {
                        VerticalLayout {
                            spacing: 6px;

                            HorizontalLayout {
                                spacing: 10px;

                                Glyph {
                                    glyph: Glyphs.volume-high;
                                    color: Tokens.teal-text;
                                    width: 20px;
                                }

                                SectionTitle {
                                    text: Strings.master-volume-title;
                                }
                            }

                            VolumeSlider {
                                volume: root.master-volume;
                                label: Strings.master-volume;
                                changed(value) => {
                                    root.master-volume-changed(value);
                                }
                            }
                        }
                    }

                    EqualizerCard {
                        on: root.equalizer-on;
                        clicked => {
                            root.equalizer-requested();
                        }
                    }
                }
            }

            // Speakers: this PC first (few, stable rows), then groups, then
            // every connected speaker by name.
            scroll := ScrollView {
                horizontal-stretch: 1;

                speaker-list := VerticalLayout {
                    spacing: Tokens.spacing-section-gap;
                    padding-bottom: 4px;
                    // The Fluent scroll bar is 14 px wide and drawn over the content.
                    padding-right: 14px;
                    // Rows keep their height when the list is shorter than the view.
                    alignment: start;

                    SpeakerSection {
                        title: Strings.this-pc-section;
                        speakers: root.this-pc;
                        forget-pairing(id) => {
                            root.forget-pairing-requested(id);
                        }
                        device-volume-fix(id) => {
                            root.device-volume-fix-requested(id);
                        }
                        focus-id <=> root.focus-speaker-id;
                        focus-part <=> root.focus-speaker-part;
                        focus-changed(id, part) => {
                            root.speaker-focus-changed(id, part);
                        }
                        note: root.this-pc.length == 0 ? Strings.this-pc-none : "";
                        toggled(id) => {
                            root.speaker-toggled(id);
                        }
                        volume-changed(id, value) => {
                            root.speaker-volume-changed(id, value);
                        }
                        sync-toggled(id) => {
                            root.sync-toggled(id);
                        }
                        blank-clicked => {
                            root.blank-clicked();
                        }
                        delay-stepped(id, delta) => {
                            root.delay-stepped(id, delta);
                        }
                        delay-edited(id, text) => {
                            root.delay-edited(id, text);
                        }
                        delay-committed(id) => {
                            root.delay-committed(id);
                        }
                        delay-cancelled(id) => {
                            root.delay-cancelled(id);
                        }
                        calibrate(id) => {
                            root.calibrate-requested(id);
                        }
                        cancel-calibration => {
                            root.cancel-calibration-requested();
                        }
                        calibration-privacy => {
                            root.calibration-privacy-requested();
                        }
                        auto-connect-toggled(id, on) => {
                            root.auto-connect-toggled(id, on);
                        }
                    }

                    if root.groups.length > 0: VerticalLayout {
                        spacing: 8px;
                        accessible-role: groupbox;
                        accessible-label: Strings.groups;

                        SectionTitle {
                            text: Strings.groups;
                        }

                        Card {
                            inner-padding: 4px;

                            for group[index] in root.groups: VerticalLayout {
                                if index > 0: HorizontalLayout {
                                    padding-left: Fluent.name-inset;
                                    padding-right: 8px;
                                    Divider { }
                                }

                                GroupRow {
                                    item: group;
                                    blank-clicked => {
                                        root.blank-clicked();
                                    }
                                    init => {
                                        if group.id == root.focus-group-id {
                                            root.focus-group-id = "";
                                            self.take-focus(root.focus-group-part);
                                        }
                                    }
                                    property <bool> focus-asked: group.id == root.focus-group-id;
                                    changed focus-asked => {
                                        if self.focus-asked {
                                            root.focus-group-id = "";
                                            self.take-focus(root.focus-group-part);
                                        }
                                    }
                                    focus-changed(part) => {
                                        root.group-focus-changed(group.id, part);
                                    }
                                    toggled => {
                                        root.group-toggled(group.id);
                                    }
                                    rename => {
                                        root.group-rename-requested(group.id);
                                    }
                                    delete => {
                                        root.group-deleted(group.id);
                                    }
                                }
                            }
                        }
                    }

                    SpeakerSection {
                        title: Strings.connected-section;
                        speakers: root.connected;
                        forget-pairing(id) => {
                            root.forget-pairing-requested(id);
                        }
                        device-volume-fix(id) => {
                            root.device-volume-fix-requested(id);
                        }
                        focus-id <=> root.focus-speaker-id;
                        focus-part <=> root.focus-speaker-part;
                        focus-changed(id, part) => {
                            root.speaker-focus-changed(id, part);
                        }
                        cast-muted(id, muted) => {
                            root.cast-muted-requested(id, muted);
                        }
                        cast-resync(id) => {
                            root.cast-resync-requested(id);
                        }
                        // While AirPlay finds nothing, the note says what to
                        // check, after the hidden virtual outputs' note; the
                        // Google Cast search's note comes last, or one sentence
                        // when neither finds a speaker.
                        property <bool> both-none: root.airplay-none-found && root.cast-list == CastList.none-found;
                        property <string> none-found: self.both-none ? Strings.network-none-found : Strings.airplay-none-found;
                        property <string> list-note: root.airplay-none-found ? (root.connected-virtual-hidden ? Strings.connected-none-virtual-hidden + " " + self.none-found : self.none-found) : root.connected.length > 0 ? "" : root.connected-virtual-hidden ? Strings.connected-none-virtual-hidden : Strings.connected-none;
                        property <string> cast-note: self.both-none ? "" : Strings.cast-list(root.cast-list);
                        note: self.cast-note == "" ? self.list-note : self.list-note == "" || self.list-note == Strings.connected-none ? self.cast-note : self.list-note + " " + self.cast-note;
                        toggled(id) => {
                            root.speaker-toggled(id);
                        }
                        volume-changed(id, value) => {
                            root.speaker-volume-changed(id, value);
                        }
                        sync-toggled(id) => {
                            root.sync-toggled(id);
                        }
                        blank-clicked => {
                            root.blank-clicked();
                        }
                        delay-stepped(id, delta) => {
                            root.delay-stepped(id, delta);
                        }
                        delay-edited(id, text) => {
                            root.delay-edited(id, text);
                        }
                        delay-committed(id) => {
                            root.delay-committed(id);
                        }
                        delay-cancelled(id) => {
                            root.delay-cancelled(id);
                        }
                        calibrate(id) => {
                            root.calibrate-requested(id);
                        }
                        cancel-calibration => {
                            root.cancel-calibration-requested();
                        }
                        calibration-privacy => {
                            root.calibration-privacy-requested();
                        }
                        auto-connect-toggled(id, on) => {
                            root.auto-connect-toggled(id, on);
                        }
                    }

                    if root.airplay-delay-shown: AirPlayDelayControls {
                        delay-text: root.airplay-delay-text;
                        pending: root.airplay-delay-pending;
                        range-hint: root.airplay-delay-range-hint;
                        stepped(delta) => {
                            root.airplay-delay-stepped(delta);
                        }
                        edited(text) => {
                            root.airplay-delay-edited(text);
                        }
                        committed => {
                            root.airplay-delay-committed();
                        }
                        cancelled => {
                            root.airplay-delay-cancelled();
                        }
                    }
                }
            }
        }
    }

    Announcer {
        said: root.notice-announcement;
    }
}
