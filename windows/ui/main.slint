// The main window: the same sections as the macOS app's main window, in the
// same order. Header (mark, wordmark, status, streaming switch), notices,
// then a left column (audio source, master volume, equalizer) and the
// speaker list (This PC, Groups, Connected Speakers). The menu bar carries
// the Windows shortcuts. Tab order follows the reading order.

import { ComboBox, ScrollView } from "std-widgets.slint";
import { Tokens } from "tokens.slint";
import { Strings } from "strings.slint";
import { GroupItem, NoticeItem, RowState, SpeakerItem } from "types.slint";
import { AirPlayDelayControls, BrandMark, Card, Divider, Fluent, Glyph, Glyphs, GroupRow, NoticeStack, SecondaryText, SectionTitle, SpeakerRow, ToggleSwitch, VolumeSlider, Wordmark } from "widgets.slint";

export { AboutDialog } from "about.slint";
export { EqualizerWindow } from "equalizer.slint";
export { TrayFlyout } from "flyout.slint";
export { GroupNameDialog, PinDialog } from "dialogs.slint";
export { GuideWindow } from "guide.slint";
export { Strings } from "strings.slint";
// The style's palette, for the theme preview (src/view.rs).
export { Palette } from "std-widgets.slint";
export { AirPlayProblem, Availability, DeviceVolumeHint, GroupItem, GuidePage, GuideStepItem, NoticeItem, PinPhase, RowState, SpeakerItem, SpeakerKind } from "types.slint";

// A titled card of speaker rows, with a note when it has none.
component SpeakerSection inherits VerticalLayout {
    in property <string> title;
    in property <[SpeakerItem]> speakers;
    in property <string> note;
    in property <bool> compact;
    callback toggled(string);
    callback volume-changed(string, float);
    callback sync-toggled(string);
    callback delay-stepped(string, int);
    callback delay-edited(string, string);
    callback auto-connect-toggled(string, bool);
    callback forget-pairing(string);
    callback device-volume-fix(string);

    spacing: 8px;
    accessible-role: groupbox;
    accessible-label: root.title;

    SectionTitle {
        text: root.title;
    }

    Card {
        inner-padding: 4px;

        for speaker[index] in root.speakers: VerticalLayout {
            if index > 0: HorizontalLayout {
                padding-left: Fluent.name-inset;
                padding-right: 8px;
                Divider { }
            }

            SpeakerRow {
                item: speaker;
                compact: root.compact;
                toggled => {
                    root.toggled(speaker.id);
                }
                volume-changed(value) => {
                    root.volume-changed(speaker.id, value);
                }
                sync-toggled => {
                    root.sync-toggled(speaker.id);
                }
                delay-stepped(delta) => {
                    root.delay-stepped(speaker.id, delta);
                }
                delay-edited(text) => {
                    root.delay-edited(speaker.id, text);
                }
                auto-connect-toggled(on) => {
                    root.auto-connect-toggled(speaker.id, on);
                }
                forget-pairing => {
                    root.forget-pairing(speaker.id);
                }
                device-volume-fix => {
                    root.device-volume-fix(speaker.id);
                }
            }
        }

        if root.note != "": VerticalLayout {
            if root.speakers.length > 0: Divider { }

            HorizontalLayout {
                padding: 12px;
                SecondaryText {
                    text: root.note;
                    font-size: Tokens.font-size-callout;
                }
            }
        }
    }
}

// The Equalizer card: opens the equalizer window and says whether it is on.
component EqualizerCard inherits Rectangle {
    in property <bool> on;
    callback clicked();

    // A Windows 11 settings card: the whole card is the button.
    background: touch.pressed ? Tokens.surface.mix(Tokens.text, 0.97) : touch.has-hover ? Tokens.surface.mix(Tokens.text, 0.95) : Tokens.surface;
    animate background { duration: Fluent.fast; }
    border-radius: Fluent.radius-card;
    border-width: 1px;
    border-color: Fluent.stroke;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: Strings.equalizer;
    accessible-value: root.on ? Strings.on : Strings.off;
    accessible-action-default => {
        root.clicked();
    }

    focus := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding: Fluent.card-padding;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 12px;

        Glyph {
            glyph: Glyphs.equalizer;
            color: Tokens.teal-text;
            width: 20px;
        }

        Text {
            text: Strings.equalizer;
            color: Tokens.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
            accessible-role: none;
        }

        if root.on: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: Tokens.teal;
            }
        }

        Text {
            text: root.on ? Strings.on : Strings.off;
            color: Tokens.secondary-text;
            font-size: Tokens.font-size-callout;
            vertical-alignment: center;
            accessible-role: none;
        }

        Glyph {
            glyph: Glyphs.chevron-right;
            font-size: 10px;
            color: Tokens.secondary-text;
        }
    }

    Rectangle {
        border-width: focus.has-focus ? 2px : 0px;
        border-color: Tokens.focus;
        border-radius: root.border-radius;
    }
}

export component MainWindow inherits Window {
    in property <bool> running;
    in property <string> status;
    in property <[string]> sources;
    in property <int> source-index;
    in property <float> master-volume;
    in property <bool> equalizer-on;
    in property <[SpeakerItem]> this-pc;
    in property <[SpeakerItem]> connected;
    in property <[GroupItem]> groups;
    in property <[NoticeItem]> notices;
    // View > Show Virtual Devices: virtual outputs are listed even while off.
    in property <bool> show-virtual-devices;
    // The AirPlay delay, shown while an AirPlay sender runs: what its field
    // shows (the applied value, or what is being typed).
    in property <bool> airplay-delay-shown;
    // Connected Speakers lists nothing only because Show Virtual Devices is
    // off and its outputs are virtual.
    in property <bool> connected-virtual-hidden;
    in property <string> airplay-delay-text;

    callback power-toggled(bool);
    callback source-selected(int);
    callback master-volume-changed(float);
    callback equalizer-requested();
    callback speaker-toggled(string);
    callback speaker-volume-changed(string, float);
    callback sync-toggled(string);
    callback delay-stepped(string, int);
    callback delay-edited(string, string);
    callback airplay-delay-stepped(int);
    callback airplay-delay-edited(string);
    callback airplay-delay-committed();
    callback auto-connect-toggled(string, bool);
    callback forget-pairing-requested(string);
    // The fix under a speaker's device-volume hint.
    callback device-volume-fix-requested(string);
    callback group-toggled(string);

    callback group-rename-requested(string);
    callback group-deleted(string);
    callback new-group-requested();
    callback refresh-devices();
    callback show-virtual-devices-toggled(bool);
    callback notice-dismissed(int);
    callback notices-dismissed-all();
    // Show How on a notice: open its guide.
    callback notice-guide-requested(int);
    // Retry on a notice: start AirPlay again.
    callback notice-retry-requested(int);
    callback close-requested();
    callback exit-requested();
    callback about-requested();

    title: Strings.main-window-title;
    icon: @image-url("../res/audiosync-256.png");
    // Wide enough for a speaker row's columns next to the left column.
    min-width: 860px;
    min-height: 520px;
    preferred-width: 980px;
    preferred-height: 680px;
    // Below this width the volume sliders in the speaker rows are shorter.
    property <bool> compact: root.width < 960px;
    background: Tokens.background;
    default-font-family: Fluent.font;
    default-font-size: Tokens.font-size-body;

    // Rust sets these; a user's click or drag replaces the controls' bindings,
    // so each control's handler also sets it back to the state after its
    // callback (a change the engine refused doesn't fire these).
    changed running => {
        power.checked = root.running;
    }
    changed source-index => {
        source.current-index = root.source-index;
    }

    MenuBar {
        Menu {
            title: Strings.menu-file;

            MenuItem {
                title: Strings.menu-close-window;
                shortcut: @keys(Control + W);
                activated => {
                    root.close-requested();
                }
            }

            MenuSeparator { }

            MenuItem {
                title: Strings.menu-exit;
                activated => {
                    root.exit-requested();
                }
            }
        }

        Menu {
            title: Strings.menu-speakers;

            MenuItem {
                title: root.running ? Strings.menu-turn-streaming-off : Strings.menu-turn-streaming-on;
                activated => {
                    root.power-toggled(!root.running);
                }
            }

            MenuSeparator { }

            MenuItem {
                title: Strings.new-group;
                shortcut: @keys(Control + N);
                activated => {
                    root.new-group-requested();
                }
            }

            MenuItem {
                title: Strings.refresh-devices;
                shortcut: @keys(F5);
                activated => {
                    root.refresh-devices();
                }
            }
        }

        Menu {
            title: Strings.menu-view;

            MenuItem {
                title: Strings.equalizer;
                shortcut: @keys(Control + E);
                activated => {
                    root.equalizer-requested();
                }
            }

            MenuSeparator { }

            MenuItem {
                title: Strings.show-virtual-devices;
                checkable: true;
                checked: root.show-virtual-devices;
                activated => {
                    root.show-virtual-devices-toggled(!root.show-virtual-devices);
                }
            }
        }

        Menu {
            title: Strings.menu-help;

            MenuItem {
                title: Strings.menu-about;
                activated => {
                    root.about-requested();
                }
            }
        }
    }

    VerticalLayout {
        padding-left: Tokens.spacing-window-margin + 4px;
        padding-right: Tokens.spacing-window-margin + 4px;
        padding-top: 16px;
        padding-bottom: Tokens.spacing-window-margin;
        spacing: 20px;

        // Header: the brand and the state on the left, the switch on the right.
        HorizontalLayout {
            spacing: 12px;
            min-height: 44px;
            vertical-stretch: 0;

            VerticalLayout {
                alignment: center;
                BrandMark {
                    running: root.running;
                    width: 34px;
                    height: 34px;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 0px;

                Wordmark { }

                SecondaryText {
                    text: root.status;
                    font-size: Tokens.font-size-caption;
                    accessible-role: text;
                    accessible-label: self.text;
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            VerticalLayout {
                alignment: center;
                power := ToggleSwitch {
                    text: Strings.streaming-switch;
                    checked: root.running;
                    accessible-label: Strings.streaming-switch;
                    toggled => {
                        root.power-toggled(self.checked);
                        // Show what the engine did, even if it refused.
                        self.checked = root.running;
                    }
                }
            }
        }

        if root.notices.length > 0: NoticeStack {
            notices: root.notices;
            dismissed(id) => {
                root.notice-dismissed(id);
            }
            dismissed-all => {
                root.notices-dismissed-all();
            }
            guide-requested(id) => {
                root.notice-guide-requested(id);
            }
            retry-requested(id) => {
                root.notice-retry-requested(id);
            }
        }

        HorizontalLayout {
            spacing: Tokens.spacing-window-margin;
            vertical-stretch: 1;

            // Left column: what plays and how loud, each in its own card.
            VerticalLayout {
                width: 264px;
                spacing: 8px;
                alignment: start;

                Card {
                    VerticalLayout {
                        spacing: 10px;

                        HorizontalLayout {
                            spacing: 10px;

                            Glyph {
                                glyph: Glyphs.source;
                                color: Tokens.teal-text;
                                width: 20px;
                            }

                            SectionTitle {
                                text: Strings.source-label;
                            }
                        }

                        source := ComboBox {
                            model: root.sources;
                            current-index: root.source-index;
                            accessible-label: Strings.source-label;
                            selected => {
                                root.source-selected(self.current-index);
                                self.current-index = root.source-index;
                            }
                        }
                    }
                }

                Card {
                    VerticalLayout {
                        spacing: 6px;

                        HorizontalLayout {
                            spacing: 10px;

                            Glyph {
                                glyph: Glyphs.volume-high;
                                color: Tokens.teal-text;
                                width: 20px;
                            }

                            SectionTitle {
                                text: Strings.master-volume-title;
                            }
                        }

                        VolumeSlider {
                            volume: root.master-volume;
                            label: Strings.master-volume;
                            changed(value) => {
                                root.master-volume-changed(value);
                            }
                        }
                    }
                }

                EqualizerCard {
                    on: root.equalizer-on;
                    clicked => {
                        root.equalizer-requested();
                    }
                }
            }

            // Speakers: this PC first (few, stable rows), then groups, then
            // every connected speaker by name.
            scroll := ScrollView {
                horizontal-stretch: 1;

                speaker-list := VerticalLayout {
                    spacing: Tokens.spacing-section-gap;
                    padding-bottom: 4px;
                    padding-right: 4px;
                    // Rows keep their height when the list is shorter than the view.
                    alignment: start;

                    SpeakerSection {
                        title: Strings.this-pc-section;
                        speakers: root.this-pc;
                        forget-pairing(id) => {
                            root.forget-pairing-requested(id);
                        }
                        device-volume-fix(id) => {
                            root.device-volume-fix-requested(id);
                        }
                        compact: root.compact;
                        note: root.this-pc.length == 0 ? Strings.this-pc-none : "";
                        toggled(id) => {
                            root.speaker-toggled(id);
                        }
                        volume-changed(id, value) => {
                            root.speaker-volume-changed(id, value);
                        }
                        sync-toggled(id) => {
                            root.sync-toggled(id);
                        }
                        delay-stepped(id, delta) => {
                            root.delay-stepped(id, delta);
                        }
                        delay-edited(id, text) => {
                            root.delay-edited(id, text);
                        }
                        auto-connect-toggled(id, on) => {
                            root.auto-connect-toggled(id, on);
                        }
                    }

                    if root.groups.length > 0: VerticalLayout {
                        spacing: 8px;
                        accessible-role: groupbox;
                        accessible-label: Strings.groups;

                        SectionTitle {
                            text: Strings.groups;
                        }

                        Card {
                            inner-padding: 4px;

                            for group[index] in root.groups: VerticalLayout {
                                if index > 0: HorizontalLayout {
                                    padding-left: Fluent.name-inset;
                                    padding-right: 8px;
                                    Divider { }
                                }

                                GroupRow {
                                    item: group;
                                    toggled => {
                                        root.group-toggled(group.id);
                                    }
                                    rename => {
                                        root.group-rename-requested(group.id);
                                    }
                                    delete => {
                                        root.group-deleted(group.id);
                                    }
                                }
                            }
                        }
                    }

                    SpeakerSection {
                        title: Strings.connected-section;
                        speakers: root.connected;
                        forget-pairing(id) => {
                            root.forget-pairing-requested(id);
                        }
                        device-volume-fix(id) => {
                            root.device-volume-fix-requested(id);
                        }
                        compact: root.compact;
                        note: root.connected.length > 0 ? "" : root.connected-virtual-hidden ? Strings.connected-none-virtual-hidden : Strings.connected-none;
                        toggled(id) => {
                            root.speaker-toggled(id);
                        }
                        volume-changed(id, value) => {
                            root.speaker-volume-changed(id, value);
                        }
                        sync-toggled(id) => {
                            root.sync-toggled(id);
                        }
                        delay-stepped(id, delta) => {
                            root.delay-stepped(id, delta);
                        }
                        delay-edited(id, text) => {
                            root.delay-edited(id, text);
                        }
                        auto-connect-toggled(id, on) => {
                            root.auto-connect-toggled(id, on);
                        }
                    }

                    if root.airplay-delay-shown: AirPlayDelayControls {
                        delay-text: root.airplay-delay-text;
                        stepped(delta) => {
                            root.airplay-delay-stepped(delta);
                        }
                        edited(text) => {
                            root.airplay-delay-edited(text);
                        }
                        committed => {
                            root.airplay-delay-committed();
                        }
                    }
                }
            }
        }
    }
}
