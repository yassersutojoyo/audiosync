// Every user-facing string of the Windows app, worded like the macOS app's
// AppText (Sources/AudioSync/Localization.swift), with Windows words where the
// platform differs ("This PC", "Exit"). The Rust side reads the tray menu and
// tooltip from here too, so nothing is spelled out anywhere else.
//
// English only for now. @tr marks each string for Slint's gettext translation
// when a second language is added.

import { SpeakerKind, Availability, AirPlayProblem, GuidePage, PinPhase, RowState } from "types.slint";

export global Strings {
    // Main window
    out property <string> app-name: "AudioSync";
    out property <string> main-window-title: "AudioSync";
    out property <string> streaming-switch: @tr("Streaming");
    out property <string> turn-on: @tr("Turn On");
    out property <string> turn-off: @tr("Turn Off");
    out property <string> on: @tr("On");
    out property <string> off: @tr("Off");
    out property <string> will-play: @tr("Will play");
    out property <string> will-play-help: @tr("Plays when streaming starts. Select to start streaming.");
    out property <string> status-off: @tr("Off");
    out property <string> connected-none: @tr("No connected speakers");
    out property <string> master-volume-title: @tr("Master Volume");
    out property <string> master-volume: @tr("Master volume");
    out property <string> dismiss-notice: @tr("Dismiss Notice");
    out property <string> dismiss-all-notices: @tr("Dismiss All");
    out property <string> notices: @tr("Notices");
    // The button on the double-audio notice that opens its guide.
    out property <string> notice-show-how: @tr("Show How");
    out property <string> notice-show-how-label: @tr("Show how to hear it only once");
    out property <string> delay-field-label: @tr("Delay in milliseconds");
    out property <string> source-label: @tr("Audio Source");
    out property <string> equalizer: @tr("Equalizer");
    out property <string> groups: @tr("Groups");
    out property <string> this-pc-section: @tr("This PC");
    out property <string> connected-section: @tr("Connected Speakers");
    out property <string> this-pc-none: @tr("No built-in output");
    out property <string> sync-adjust: @tr("Adjust sync");
    // Beside the sync controls when no output is the reference.
    out property <string> sync-hint-no-reference: @tr("The speaker with the lowest value plays first, and the others wait by the difference. Heard this speaker first? Raise the value.");
    out property <string> milliseconds-unit: @tr("ms");
    // The AirPlay delay (L): how long the local speakers wait for the
    // AirPlay speakers.
    out property <string> airplay-delay-title: @tr("AirPlay Delay");
    out property <string> airplay-delay-hint: @tr("The speakers on this PC wait this long for the AirPlay speakers. Heard the AirPlay speakers late? Raise it.");
    out property <string> auto-connect: @tr("Auto-connect when available");
    out property <string> source-system: @tr("All System Audio");

    // Notices: what happened and what to do about it
    out property <string> notice-no-speaker: @tr("Turn on at least one speaker first (under This PC or Connected Speakers).");
    out property <string> notice-capture-failed: @tr("AudioSync couldn't capture audio from the selected source. Turn streaming off and on again, or pick another source. If it keeps happening, restart your PC.");
    out property <string> notice-capture-lost: @tr("AudioSync lost the audio from the selected source, so streaming has stopped. Turn streaming on again, or pick another source.");

    // Pairing with an Apple TV that asks for a code: the dialog and the
    // speaker menu.
    out property <string> pin-dialog-title: @tr("Pair with Apple TV");
    out property <string> pin-field-label: @tr("Code");
    out property <string> pin-field-placeholder: @tr("4 digits");
    out property <string> pair: @tr("Pair");
    out property <string> forget-pairing: @tr("Forget Pairing");
    // The made-up Apple TV of the PIN dialog preview (debug only).
    out property <string> pin-preview-speaker: @tr("Living Room");

    // What the dialog says while the TV is asked for a code, shows one, or
    // checks the one typed; after a wrong code the TV shows a new one.
    public pure function pin-message(speaker: string, phase: PinPhase, wrong-pin: bool) -> string {
        if phase == PinPhase.checking {
            return @tr("Checking the code with {}…", speaker);
        }
        if phase == PinPhase.starting {
            if wrong-pin {
                return @tr("That code didn't work. Asking {} for a new one…", speaker);
            }
            return @tr("Asking {} to show a code…", speaker);
        }
        if wrong-pin {
            return @tr("That code didn't work. Type the new code {} shows.", speaker);
        }
        return @tr("Type the 4-digit code {} shows on the screen.", speaker);
    }

    // Groups
    out property <string> new-group: @tr("New Group from Active Speakers…");
    out property <string> new-group-title: @tr("New Speaker Group");
    out property <string> new-group-message: @tr("The speakers that are on right now become this group. Select the group later to switch them all at once.");
    out property <string> new-group-placeholder: @tr("Living room, Office…");
    out property <string> new-group-field-label: @tr("Group name");
    out property <string> new-group-needs-speakers: @tr("Turn on the speakers you want in the group first, then create it.");
    out property <string> ok: @tr("OK");
    out property <string> create: @tr("Create");
    out property <string> cancel: @tr("Cancel");
    out property <string> delete-group: @tr("Delete Group");
    out property <string> rename-group: @tr("Rename Group…");
    out property <string> rename-group-title: @tr("Rename Group");
    out property <string> rename: @tr("Rename");
    out property <string> refresh-devices: @tr("Refresh Devices");
    out property <string> show-virtual-devices: @tr("Show Virtual Devices");

    // Menu bar (Windows names: File > Exit, View)
    out property <string> menu-file: @tr("File");
    out property <string> menu-close-window: @tr("Close Window");
    out property <string> menu-exit: @tr("Exit");
    out property <string> menu-speakers: @tr("Speakers");
    out property <string> menu-turn-streaming-on: @tr("Turn Streaming On");
    out property <string> menu-turn-streaming-off: @tr("Turn Streaming Off");
    out property <string> menu-view: @tr("View");
    out property <string> menu-help: @tr("Help");
    out property <string> menu-about: @tr("About AudioSync");

    // Tray icon and its flyout (the macOS menu bar panel)
    out property <string> open-app: @tr("Open AudioSync");
    out property <string> exit-app: @tr("Exit AudioSync");
    out property <string> exit-short: @tr("Exit");
    out property <string> flyout-title: @tr("AudioSync quick settings");

    // Equalizer
    out property <string> equalizer-title: @tr("Equalizer");
    out property <string> equalizer-custom: @tr("Custom");
    out property <string> equalizer-reset: @tr("Reset");
    out property <string> equalizer-preamp: @tr("Pre");
    out property <string> equalizer-preamp-accessibility: @tr("Preamp");
    out property <string> equalizer-presets: @tr("Presets");

    // About dialog
    public pure function version(version: string) -> string {
        return @tr("Version {}", version);
    }

    public pure function core-version(version: string) -> string {
        return @tr("Audio core {}", version);
    }

    // A window or dialog that failed to open; `detail` is the system's reason.
    public pure function window-failed(detail: string) -> string {
        return @tr("AudioSync couldn't open a window: {}", detail);
    }

    // Windows audio couldn't be reached at startup, so AudioSync exits;
    // `detail` is the system's reason.
    public pure function audio-failed(detail: string) -> string {
        return @tr("AudioSync couldn't reach Windows audio, so it can't start. Restart your PC, then open AudioSync again.\n\nDetails: {}", detail);
    }

    // The status under the wordmark (and the tray icon's tooltip).
    public pure function status(running: bool, speakers: int) -> string {
        if !running {
            return root.status-off;
        }
        if speakers == 0 {
            return @tr("Streaming");
        }
        return @tr("Streaming to {n} speaker" | "Streaming to {n} speakers" % speakers);
    }

    public pure function tray-tooltip(running: bool, speakers: int) -> string {
        return @tr("{} – {}", root.app-name, root.status(running, speakers));
    }

    // The link under the newest notice in the flyout to the window that lists the others.
    public pure function more-notices(count: int) -> string {
        return @tr("{n} more notice…" | "{n} more notices…" % count);
    }

    // The app being captured quit while streaming.
    public pure function notice-source-quit(source: string) -> string {
        return @tr("{} quit, so streaming has stopped.", source);
    }

    // Streaming was turned on while the chosen app wasn't running.
    public pure function notice-source-not-running(source: string) -> string {
        return @tr("{} is not running. Open it first, or pick another source.", source);
    }

    // The chosen app started AudioSync, or AudioSync started it, so capturing
    // it would capture AudioSync's own output and echo.
    public pure function notice-source-refused(source: string) -> string {
        return @tr("AudioSync can't capture {} without capturing its own sound too. Pick another source.", source);
    }

    // A speaker that couldn't start was turned off.
    public pure function notice-speaker-failed(speaker: string) -> string {
        return @tr("Could not start output for this speaker, so it was turned off: {}\nAnother app may be using it exclusively, or the format may be incompatible.", speaker);
    }

    // A speaker was unplugged or switched off while it played; it stays on.
    public pure function notice-speaker-lost(speaker: string) -> string {
        return @tr("{} was disconnected. It plays again as soon as it's back.", speaker);
    }

    // An AirPlay speaker stopped playing or can't play. For the first four
    // problems it stays on and AudioSync keeps trying; for the others it is
    // off, because AudioSync for Windows can't play to it (yet).
    public pure function notice-airplay(problem: AirPlayProblem, speaker: string) -> string {
        if problem == AirPlayProblem.not-responding {
            return @tr("{} isn't responding. AudioSync keeps trying to reach it.", speaker);
        }
        if problem == AirPlayProblem.connection-lost {
            return @tr("{} lost its connection. AudioSync keeps trying to reconnect.", speaker);
        }
        if problem == AirPlayProblem.busy {
            return @tr("{} seems to be playing from another device. AudioSync keeps trying.", speaker);
        }
        if problem == AirPlayProblem.refused {
            return @tr("{} turned the stream down. AudioSync tries again shortly.", speaker);
        }
        if problem == AirPlayProblem.password-not-yet {
            return @tr("{} asks for a password, which AudioSync for Windows can't send yet, so it's off.", speaker);
        }
        if problem == AirPlayProblem.needs-pin {
            return @tr("{} needs pairing with a code. Switch it on to pair.", speaker);
        }
        if problem == AirPlayProblem.pairing-failed {
            return @tr("{} couldn't be paired, so it's off. Make sure the TV is on, then switch {} on in AudioSync to try again.", speaker, speaker);
        }
        if problem == AirPlayProblem.pairing-not-yet {
            return @tr("{} needs pairing with a code, which AudioSync for Windows can't do yet, so it's off.", speaker);
        }
        if problem == AirPlayProblem.airplay2-not-yet {
            return @tr("{} plays only AirPlay 2, which AudioSync for Windows doesn't support yet, so it's off.", speaker);
        }
        return @tr("AudioSync can't play to {}, so it's off.", speaker);
    }

    // Windows can't mute the captured app, so it also plays straight from
    // some outputs, undelayed, next to AudioSync's delayed copies. `mute`
    // names the ones AudioSync doesn't play to (muting them helps), `shared`
    // the ones AudioSync plays to as well (only moving the app helps); each is
    // one output's name, several as "A, B and C" (list-and), or empty.
    public pure function notice-heard-twice-app(source: string, mute: string, shared: string) -> string {
        if shared == "" {
            return @tr("You may hear {0} twice: it also plays straight from {1}. Send it to an output you don't listen to (Volume mixer), or mute {1}.", source, mute);
        }
        if mute == "" {
            return @tr("You may hear {0} twice: it also plays straight from {1}, where AudioSync plays too. Send it to an output you don't listen to (Volume mixer).", source, shared);
        }
        return @tr("You may hear {0} twice: it also plays straight from {1}, and from {2}, where AudioSync plays too. Send it to an output you don't listen to (Volume mixer). Muting {1} alone isn't enough.", source, mute, shared);
    }

    // The same while the whole system is captured: what Windows plays on its
    // default output, or another app plays elsewhere, is heard there too.
    public pure function notice-heard-twice-system(mute: string, shared: string) -> string {
        if shared == "" {
            return @tr("You may hear your PC's sound twice: it also plays straight from {0}. Make an output you don't listen to the Windows default (Sound settings), or mute {0}.", mute);
        }
        if mute == "" {
            return @tr("You may hear your PC's sound twice: it also plays straight from {0}, where AudioSync plays too. Make an output you don't listen to the Windows default (Sound settings).", shared);
        }
        return @tr("You may hear your PC's sound twice: it also plays straight from {0}, and from {1}, where AudioSync plays too. Make an output you don't listen to the Windows default (Sound settings). Muting {0} alone isn't enough.", mute, shared);
    }

    // The double-audio guide, opened from Show How on that notice. Each list
    // is output names as "A, B and C" (list-and). AudioSync changes none of these
    // settings itself; a step's button opens the Settings page where the
    // user does.
    out property <string> guide-title: @tr("Avoid Double Audio");
    out property <string> guide-steps: @tr("Steps");
    out property <string> guide-footer: @tr("AudioSync doesn't change these settings itself. The notice goes away on its own once the sound plays only through AudioSync.");
    out property <string> guide-close: @tr("Close");
    // Shown in the guide when the shell didn't open the Settings page.
    out property <string> guide-settings-failed: @tr("Couldn't open Settings. Open it from the Start menu: Settings > System > Sound.");

    // Joins a list of names: `head` is all but the last, already joined by
    // commas ("TV, Speakers"), `last` the last one.
    public pure function list-and(head: string, last: string) -> string {
        return @tr("{0} and {1}", head, last);
    }

    public pure function guide-intro-app(source: string, outputs: string) -> string {
        return @tr("Windows keeps playing {0} straight from {1}, next to AudioSync's synced copies. To hear it only once:", source, outputs);
    }

    public pure function guide-intro-system(outputs: string) -> string {
        return @tr("Windows keeps playing your PC's sound straight from {0}, next to AudioSync's synced copies. To hear it only once:", outputs);
    }

    public pure function guide-route-app(source: string) -> string {
        return @tr("Open the Volume mixer, find {0} and set its output to one you don't listen to, such as a monitor's speakers you keep muted or an unused jack. AudioSync keeps playing to the speakers you turned on.", source);
    }

    public pure function guide-change-default(current: string) -> string {
        return @tr("Open Sound settings and make an output you don't listen to the default instead of {0}, such as a monitor's speakers you keep muted or an unused jack. AudioSync keeps playing to the speakers you turned on.", current);
    }

    public pure function guide-route-other-apps(outputs: string) -> string {
        return @tr("Some apps play straight to {0}. In the Volume mixer, set them to an output you don't listen to as well.", outputs);
    }

    // `count` is how many outputs `outputs` names.
    public pure function guide-mute-outputs(outputs: string, count: int) -> string {
        if count == 1 {
            return @tr("Or, if you don't need {0}, mute it: in Sound settings, open it and turn its volume all the way down. AudioSync doesn't play there, so its copies stay as they are.", outputs);
        }
        return @tr("Or, if you don't need {0}, mute them: in Sound settings, open each of them and turn its volume all the way down. AudioSync doesn't play there, so its copies stay as they are.", outputs);
    }

    public pure function guide-shared-outputs(outputs: string) -> string {
        return @tr("Muting {0} won't help: AudioSync plays there too, so its copies would go quiet as well.", outputs);
    }

    public pure function guide-keep-app-unmuted(source: string) -> string {
        return @tr("Don't mute {0} itself in the Volume mixer: AudioSync would capture silence.", source);
    }

    // The label of a guide step's button.
    public pure function guide-open(page: GuidePage) -> string {
        if page == GuidePage.volume-mixer {
            return @tr("Open Volume Mixer");
        }
        if page == GuidePage.sound {
            return @tr("Open Sound Settings");
        }
        return "";
    }

    public pure function speaker-options(name: string) -> string {
        return @tr("Options for {}", name);
    }

    // A row's accessible value.
    public pure function value(state: RowState) -> string {
        if state == RowState.off {
            return root.off;
        }
        if state == RowState.will-play {
            return root.will-play;
        }
        return root.on;
    }

    // What selecting a row does, read after its value.
    public pure function help(state: RowState) -> string {
        if state == RowState.off {
            return root.turn-on;
        }
        if state == RowState.will-play {
            return root.will-play-help;
        }
        return root.turn-off;
    }

    // The note next to an AirPlay speaker that can't simply play.
    public pure function availability(a: Availability) -> string {
        if a == Availability.needs-code {
            return @tr("Asks for a code");
        }
        if a == Availability.pairing {
            return @tr("Pairing…");
        }
        if a == Availability.password-not-yet {
            return @tr("Password not supported yet");
        }
        if a == Availability.pairing-not-yet {
            return @tr("Pairing not supported yet");
        }
        if a == Availability.airplay2-not-yet {
            return @tr("AirPlay 2 not supported yet");
        }
        if a == Availability.unsupported {
            return @tr("Not supported");
        }
        return "";
    }

    public pure function speaker-kind(kind: SpeakerKind) -> string {
        if kind == SpeakerKind.airplay {
            return @tr("AirPlay");
        }
        if kind == SpeakerKind.built-in {
            return @tr("Built-in");
        }
        if kind == SpeakerKind.headphones {
            return @tr("Headphones");
        }
        if kind == SpeakerKind.bluetooth {
            return @tr("Bluetooth");
        }
        if kind == SpeakerKind.usb {
            return @tr("USB");
        }
        if kind == SpeakerKind.hdmi {
            return @tr("HDMI");
        }
        if kind == SpeakerKind.display-port {
            return @tr("DisplayPort");
        }
        if kind == SpeakerKind.virtual {
            return @tr("Virtual");
        }
        return @tr("Other");
    }

    // A speaker row's accessible label: "Kitchen, AirPlay".
    public pure function speaker-label(name: string, kind: SpeakerKind, show-kind: bool) -> string {
        if !show-kind {
            return name;
        }
        return @tr("{}, {}", name, root.speaker-kind(kind));
    }

    // The line under a speaker's name: its kind, its note, or both
    // ("AirPlay · Asks for a code"); either may be empty.
    public pure function speaker-caption(kind: string, note: string) -> string {
        if kind == "" {
            return note;
        }
        if note == "" {
            return kind;
        }
        return @tr("{} · {}", kind, note);
    }

    public pure function volume-of(name: string) -> string {
        return @tr("{} volume", name);
    }

    public pure function volume-value(volume: float) -> string {
        return round(volume);
    }

    public pure function delay-of(name: string) -> string {
        return @tr("{} delay", name);
    }

    // An offset relative to the reference, with its sign: "+150 ms",
    // "−250 ms", "0 ms".
    public pure function delay-value(ms: int) -> string {
        if ms > 0 {
            return @tr("+{} {}", ms, root.milliseconds-unit);
        }
        if ms < 0 {
            return @tr("−{} {}", -ms, root.milliseconds-unit);
        }
        return @tr("{} {}", ms, root.milliseconds-unit);
    }

    // The hint beside the sync controls: what the values are relative to.
    public pure function sync-hint(reference: string) -> string {
        if reference == "" {
            return root.sync-hint-no-reference;
        }
        return @tr("Relative to {}. Heard this speaker first? Raise the value. Heard it late, like a Bluetooth speaker? Go below 0.", reference);
    }

    // The label of a delay step button: "−100", "+10".
    public pure function delay-step(delta: int) -> string {
        return delta < 0 ? "−" + (-delta) : "+" + delta;
    }

    public pure function delay-step-accessibility(delta: int) -> string {
        if delta < 0 {
            return @tr("Decrease delay by {} {}", -delta, root.milliseconds-unit);
        }
        return @tr("Increase delay by {} {}", delta, root.milliseconds-unit);
    }

    public pure function group-members(available: int, total: int) -> string {
        if available == total {
            return @tr("{n} speaker" | "{n} speakers" % total);
        }
        return @tr("{} of {} speakers available", available, total);
    }

    // A new group's name when none was typed.
    public pure function numbered-group(n: int) -> string {
        return @tr("Group {}", n);
    }

    public pure function rename-group-message(name: string) -> string {
        return @tr("Enter a new name for “{}”.", name);
    }

    public pure function equalizer-caption(max-gain: int) -> string {
        return @tr("±{} dB · applied to every speaker", max-gain);
    }

    public pure function equalizer-preset(id: string) -> string {
        if id == "flat" {
            return @tr("Flat");
        }
        if id == "bassBoost" {
            return @tr("Bass Boost");
        }
        if id == "bassCut" {
            return @tr("Bass Cut");
        }
        if id == "trebleBoost" {
            return @tr("Treble Boost");
        }
        if id == "vocal" {
            return @tr("Vocal");
        }
        if id == "rock" {
            return @tr("Rock");
        }
        if id == "pop" {
            return @tr("Pop");
        }
        if id == "jazz" {
            return @tr("Jazz");
        }
        if id == "classical" {
            return @tr("Classical");
        }
        if id == "electronic" {
            return @tr("Electronic");
        }
        if id == "loudness" {
            return @tr("Loudness");
        }
        if id == "smallSpeakers" {
            return @tr("Small Speakers");
        }
        return id;
    }

    // A band's short label under its slider: "32", "125", "1k", "16k".
    public pure function equalizer-band-short(hz: float) -> string {
        return hz >= 1000 ? floor(hz / 1000) + "k" : floor(hz);
    }

    // A band's spoken name: "125 Hz", "1 kHz".
    public pure function equalizer-band-name(hz: float) -> string {
        return hz >= 1000 ? @tr("{} kHz", floor(hz / 1000)) : @tr("{} Hz", floor(hz));
    }

    // A gain above its slider: "+2.5", "+3", "0", "−1.5" (0.5 dB steps).
    public pure function equalizer-gain(db: float) -> string {
        if round(db * 10) == 0 {
            return "0";
        }
        return (db > 0 ? "+" : "−") + (round(abs(db) * 10) / 10);
    }

    // A gain as Narrator reads it: "+2.5 dB".
    public pure function equalizer-gain-value(db: float) -> string {
        return @tr("{} dB", root.equalizer-gain(db));
    }
}
