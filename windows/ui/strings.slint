    // Notices: what happened and what to do about it
    out property <string> notice-no-speaker: @tr("Turn on at least one speaker first (under This PC or Connected Speakers).");
    out property <string> notice-capture-failed: @tr("AudioSync couldn't capture audio from the selected source. Turn streaming off and on again, or pick another source. If it keeps happening, restart your PC.");
    out property <string> notice-capture-lost: @tr("AudioSync lost the audio from the selected source, so streaming has stopped. Turn streaming on again, or pick another source.");
    out property <string> notice-airplay-stopped: @tr("AirPlay stopped or couldn't start. Select Retry to try again. If it keeps happening, restart AudioSync.");
    // The settings file in the app's data folder couldn't be written.
    out property <string> notice-settings-not-saved: @tr("AudioSync couldn't save your settings, so changes you make now won't be kept after AudioSync quits.");
    // Another app holds a PTP port, so AirPlay 2 speakers that need PTP timing can't play.
    out property <string> notice-airplay-ptp-ports-taken: @tr("Another app is using port 319 or 320, so AirPlay speakers that need PTP timing can't play. Close that app, then turn the speaker on again.");
    // The file with the AirPlay pairings couldn't be written.
    out property <string> notice-pairings-not-saved: @tr("AudioSync couldn't save your AirPlay pairings, so pairings you add or forget now won't be kept after AudioSync quits.");
    // Launch at Sign-In: Windows refused to add AudioSync to its startup
    // apps, refused to remove it, or has it turned off in Task Manager or
    // Settings (AudioSync then opens Settings > Apps > Startup).
    out property <string> notice-launch-at-login-failed: @tr("Windows didn't let AudioSync add itself to the startup apps, so Launch at Sign-In stays off. To start AudioSync at sign-in anyway, put a shortcut to it in your Startup folder (press Windows+R and enter shell:startup), then add a space and --background at the end of the shortcut's Target so AudioSync starts in the tray.");
    out property <string> notice-launch-at-login-not-removed: @tr("Windows didn't let AudioSync remove itself from the startup apps. To stop it launching at sign-in, turn AudioSync off in Settings > Apps > Startup.");
    out property <string> notice-launch-at-login-off-in-settings: @tr("AudioSync is turned off in Windows' startup apps. Turn it on in Settings > Apps > Startup to finish turning on Launch at Sign-In.");
    // Windows lists no active sound output (none connected, or all turned
    // off) while a network speaker is on: apps have nowhere to play.
    // File > AirPlay 2 (Experimental) was turned on or off; the AirPlay
    // sender keeps the mode it started with until the next launch.
    out property <string> notice-airplay2-on-next-launch: @tr("AirPlay 2 (Experimental) is on. AudioSync plays to AirPlay 2 speakers, stereo pairs and home theater groups once you quit and reopen it.");
    out property <string> notice-airplay2-off-next-launch: @tr("AirPlay 2 (Experimental) is off. AudioSync stops playing to AirPlay 2 speakers, stereo pairs and home theater groups once you quit and reopen it.");
    out property <string> notice-no-sound-output: @tr("Windows has no working sound output, so apps have nowhere to play and AudioSync has nothing to send to your speakers. Connect or turn on an output in Sound settings.");

    // Pairing with an Apple TV that asks for a PIN: the dialog and the
    // speaker menu.
    public pure function pin-dialog-title(speaker: string) -> string {
        return @tr("Pair with {}", speaker);
    }

    public pure function pin-field-label(speaker: string) -> string {
        return @tr("PIN for {}", speaker);
    }

    out property <string> pin-field-placeholder: @tr("PIN");
    out property <string> pair: @tr("Pair");
    out property <string> forget-pairing: @tr("Forget Pairing");
    // The made-up Apple TV of the PIN dialog preview (debug only).
    out property <string> pin-preview-speaker: @tr("Living Room");

    // What the dialog says while the TV is asked for a PIN, shows one, or
    // checks the one typed; after a wrong PIN the TV shows a new one.
    public pure function pin-message(speaker: string, phase: PinPhase, wrong-pin: bool) -> string {
        if phase == PinPhase.checking {
            return @tr("Checking the PIN with {}…", speaker);
        }
        if phase == PinPhase.starting {
            if wrong-pin {
                return @tr("That PIN didn't work. Asking {} for a new one…", speaker);
            }
            return @tr("Asking {} to show a PIN…", speaker);
        }
        if wrong-pin {
            return @tr("That PIN didn't work. Enter the PIN {} shows now. Cancel turns the speaker off; turn it on again to retry.", speaker);
        }
        return @tr("{} shows a 4-digit PIN on its screen. Enter it to pair; after that, it connects without a PIN. Cancel turns the speaker off; turn it on again to retry.", speaker);
    }

    // The password prompt of an AirPlay speaker protected by a password; the
    // password is kept until AudioSync quits.
    public pure function password-dialog-title(speaker: string) -> string {
        return @tr("Pair with {}", speaker);
    }

    public pure function password-field-label(speaker: string) -> string {
        return @tr("Password for {}", speaker);
    }

    out property <string> password-field-placeholder: @tr("Password");

    public pure function password-message(speaker: string, wrong: bool) -> string {
        if wrong {
            return @tr("{} didn't accept that password. Enter the password set for it in the Home app or in the speaker's settings. Cancel turns the speaker off; turn it on again to retry.", speaker);
        }
        return @tr("{} is protected by a password. Enter the password set for it in the Home app or in the speaker's settings. Cancel turns the speaker off; turn it on again to retry.", speaker);
    }

