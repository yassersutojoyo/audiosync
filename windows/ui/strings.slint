    public pure function version(version: string) -> string {
        return @tr("Version {}", version);
    }

    public pure function core-version(version: string) -> string {
        return @tr("Audio core {}", version);
    }

    // A window or dialog that failed to open; `detail` is the system's reason.
    public pure function window-failed(detail: string) -> string {
        return @tr("AudioSync couldn't open a window: {}", detail);
    }

    // Windows audio couldn't be reached at startup, so AudioSync exits;
    // `detail` is the system's reason.
    public pure function audio-failed(detail: string) -> string {
        return @tr("AudioSync couldn't reach Windows audio, so it can't start. Restart your PC, then open AudioSync again.\n\nDetails: {}", detail);
    }

    // The source menu's name for "all apps except" these, by name.
    public pure function source-all-except(names: string) -> string {
        return @tr("All apps except {}", names);
    }

    // The status under the wordmark (and the tray icon's tooltip).
    public pure function status(running: bool, speakers: int) -> string {
        if !running {
            return root.status-off;
        }
        if speakers == 0 {
            return @tr("Streaming");
        }
        return @tr("Streaming to {n} speaker" | "Streaming to {n} speakers" % speakers);
    }

    public pure function tray-tooltip(running: bool, speakers: int) -> string {
        return @tr("{} – {}", root.app-name, root.status(running, speakers));
    }

    // The tray icon's tooltip while there are notices: the usual tooltip,
    // then the newest notice's title (`notice-title`) on a second line.
    public pure function tray-tooltip-notice(running: bool, speakers: int, title: string) -> string {
        return @tr("{}\nNotice: {}", root.tray-tooltip(running, speakers), title);
    }

    // What Narrator says when a new notice appears, without the focus
    // moving: the notice's title (`notice-title`).
    public pure function notice-announcement(title: string) -> string {
        return @tr("Notice: {}", title);
    }

    // A notice and a delay field's range line that arrive together: Narrator
    // says both, in turn.
    public pure function announcements(first: string, second: string) -> string {
        return @tr("{}. {}", first, second);
    }

    // The link under the newest notice in the flyout to the window that lists the others.
    public pure function more-notices(count: int) -> string {
        return @tr("{n} more notice…" | "{n} more notices…" % count);
    }

    // The app being captured quit while streaming.
    public pure function notice-source-quit(source: string) -> string {
        return @tr("{} quit, so streaming has stopped.", source);
    }

    // The app being captured quit while streaming, and the setting switched
    // the source to the whole system.
    public pure function notice-source-switched(source: string) -> string {
        return @tr("{} quit, so AudioSync switched to All System Audio.", source);
    }

    // Streaming was turned on while the chosen app wasn't running.
    public pure function notice-source-not-running(source: string) -> string {
        return @tr("{} is not running. Open it first, or pick another source.", source);
    }

    // Streaming was turned on while the chosen input device was unplugged.
    public pure function notice-input-not-connected(source: string) -> string {
        return @tr("{} is not connected. Plug it in, or pick another source.", source);
    }

    // Windows' privacy settings block microphone access for desktop apps.
    public pure function notice-microphone-blocked(source: string) -> string {
        return @tr("Windows is blocking microphone access for desktop apps, so AudioSync can't capture {}. Open Privacy Settings and turn on microphone access for desktop apps.", source);
    }

    // The input device being captured was unplugged while streaming.
    public pure function notice-input-disconnected(source: string) -> string {
        return @tr("{} was disconnected, so streaming has stopped. Plug it in again, or pick another source.", source);
    }

    // The chosen app started AudioSync, or AudioSync started it, so capturing
    // it would capture AudioSync's own output and echo.
    public pure function notice-source-refused(source: string) -> string {
        return @tr("AudioSync can't capture {} without capturing its own sound too. Pick another source.", source);
    }

    // The settings file couldn't be read when the app started (another
    // program held it, or it was damaged), so the defaults applied; it was
    // kept under this file name in %LOCALAPPDATA%\AudioSync before the
    // first save over it.
    public pure function notice-settings-kept-aside(file: string) -> string {
        return @tr("AudioSync couldn't read your saved settings when it started, so it's using the default settings. The old file was kept as {} in AudioSync's data folder (type %LOCALAPPDATA% in File Explorer's address bar, then open AudioSync).", file);
    }

    // The same for the file with the AirPlay pairings: those speakers ask
    // for a PIN again.
    public pure function notice-pairings-kept-aside(file: string) -> string {
        return @tr("AudioSync couldn't read your AirPlay pairings when it started, so AirPlay speakers you paired ask for a PIN again. The old file was kept as {} in AudioSync's data folder (type %LOCALAPPDATA% in File Explorer's address bar, then open AudioSync).", file);
    }

    // A speaker that couldn't start was turned off.
    public pure function notice-speaker-failed(speaker: string) -> string {
        return @tr("Could not start output for this speaker, so it was turned off: {}\nAnother app may be using it exclusively, or the format may be incompatible.", speaker);
    }

    // A speaker was unplugged or switched off while it played; it stays on.
    public pure function notice-speaker-lost(speaker: string) -> string {
        return @tr("{} was disconnected. It plays again as soon as it's back.", speaker);
    }

    // Another app holds a speaker's device for itself (exclusive mode); the
    // speaker stays on and plays once that app lets go of it. Windows calls
    // the setting "Allow applications to take exclusive control of this
    // device", in the device's properties under Sound settings.
    public pure function notice-speaker-busy(speaker: string) -> string {
        return @tr("{} is in use by another app. Close that app, or stop apps from taking exclusive control of it in Sound settings. AudioSync plays to it as soon as it's free.", speaker);
    }

    // A member of the stereo pair or home theater group `target` stays off
    // by itself while the target is listed, on or off.
    public pure function notice-airplay-plays-in-group(speaker: string, target: string) -> string {
        return @tr("{0} plays as part of {1}, so it stays off by itself.", speaker, target);
    }

    // A member of a stereo pair or home theater group asks for a password,
    // so the target is off.
    public pure function notice-airplay-member-password(member: string, target: string) -> string {
        return @tr("{0} in {1} asks for a password, so {1} is off. Turn {1} on again to enter it.", member, target);
    }

    // An AirPlay speaker stopped playing or can't play. For the first four
    // problems it stays on and AudioSync keeps trying, and one waiting for
    // the AirPlay 2 slot stays on too; for the others it is off, because
    // AudioSync for Windows can't play to it (yet).
    public pure function notice-airplay(problem: AirPlayProblem, speaker: string) -> string {
        if problem == AirPlayProblem.not-responding {
            return @tr("{} isn't responding. AudioSync keeps trying to reach it.", speaker);
        }
        if problem == AirPlayProblem.connection-lost {
            return @tr("{} lost its connection. AudioSync keeps trying to reconnect.", speaker);
        }
        if problem == AirPlayProblem.busy {
            return @tr("{} seems to be playing from another device. AudioSync keeps trying.", speaker);
        }
        if problem == AirPlayProblem.refused {
            return @tr("{} declined the stream. AudioSync tries again shortly.", speaker);
        }
        if problem == AirPlayProblem.needs-password {
            return @tr("{} asks for a password, so it's off. Turn it on again to enter it. To use it without a password, set Allow Speaker & TV Access on the speaker (or in the Home app) to \"Anyone on the Same Network\" and turn off Require Password.", speaker);
        }
        if problem == AirPlayProblem.needs-pin {
            return @tr("{} needs pairing with a PIN, so it's off. Turn it on again to pair.", speaker);
        }
        if problem == AirPlayProblem.pairing-failed {
            return @tr("Pairing with {} didn't finish, so it's off. To try again, turn it on and enter the PIN it shows.", speaker);
        }
        if problem == AirPlayProblem.pairing-not-yet {
            return @tr("{} needs a kind of pairing AudioSync for Windows can't do yet, so it's off.", speaker);
        }
        if problem == AirPlayProblem.airplay2-not-yet {
            return @tr("{} plays only AirPlay 2, so it's off. Turn on File > AirPlay 2 (Experimental), then quit and reopen AudioSync.", speaker);
        }
        if problem == AirPlayProblem.timing-unavailable {
            return @tr("{} needs PTP timing, which isn't available, so it's off. Another app may be using ports 319 and 320.", speaker);
        }
        if problem == AirPlayProblem.one-airplay2-speaker {
            return @tr("AudioSync plays one AirPlay 2 speaker at a time, so {} waits. It starts once the other one stops.", speaker);
        }
        // An Apple TV and its home theater group never play at once.
        if problem == AirPlayProblem.plays-through-speakers {
            return @tr("{} plays through its home theater speakers, and AudioSync already plays to them, so it's off. Turn the group off to play to the Apple TV itself.", speaker);
        }
        if problem == AirPlayProblem.apple-tv-plays {
            return @tr("AudioSync already plays to {}'s Apple TV, so the group is off. Turn the Apple TV off to play to the group.", speaker);
        }
        if problem == AirPlayProblem.plays-in-group {
            return @tr("{} plays as part of its stereo pair or home theater group, so it stays off by itself.", speaker);
        }
        return @tr("AudioSync can't play to {}, so it's off.", speaker);
    }

    // AirPlay speakers wait for a Google Cast speaker whose delay is longer
    // than theirs, but at most 20 s, so a longer Cast delay leaves them ahead.
    // `seconds` is a number with one decimal, such as "1.5".
    public pure function notice-airplay-ahead(seconds: string, speaker: string) -> string {
        return @tr("AirPlay speakers can wait at most 20 s for a Google Cast speaker, so they play about {} s ahead of {}. Lower its offset to keep them together.", seconds, speaker);
    }

    // A Google Cast speaker can't play, so it is off.
    public pure function notice-cast(problem: CastProblem, speaker: string) -> string {
        if problem == CastProblem.busy {
            return @tr("Only one Google Cast speaker can play at a time, so {} stays off. Turn the other one off first.", speaker);
        }
        if problem == CastProblem.not-responding {
            return @tr("{} isn't responding, so it's off. Check that it's on and on this PC's network, then turn it on again.", speaker);
        }
        if problem == CastProblem.refused {
            return @tr("{} declined the stream, so it's off. Turn it on again to try once more.", speaker);
        }
        if problem == CastProblem.taken-over {
            return @tr("Another app started casting to {}, so it's off in AudioSync.", speaker);
        }
        if problem == CastProblem.blocked {
            return @tr("{} couldn't reach the stream on this PC, so it's off. Allow AudioSync in Windows Firewall on Private networks, or on Public networks if this network is set to Public, then turn it on again.", speaker);
        }
        return @tr("{} lost its connection, so it's off. Turn it on again to reconnect.", speaker);
    }

    // Windows can't mute the captured app, so it also plays straight from
    // some outputs, undelayed, next to AudioSync's delayed copies. `mute`
    // names the ones AudioSync doesn't play to (muting them helps), `shared`
    // the ones AudioSync plays to as well (only moving the app helps); each is
    // one output's name, several as "A, B and C" (list-and), or empty.
    public pure function notice-heard-twice-app(source: string, mute: string, shared: string) -> string {
        if shared == "" {
            return @tr("You may hear {0} twice: it also plays straight from {1}. Send it to an output you don't listen to (Volume mixer), or mute {1}.", source, mute);
        }
        if mute == "" {
            return @tr("You may hear {0} twice: it also plays straight from {1}, where AudioSync plays too. Send it to an output you don't listen to (Volume mixer).", source, shared);
        }
        return @tr("You may hear {0} twice: it also plays straight from {1}, and from {2}, where AudioSync plays too. Send it to an output you don't listen to (Volume mixer). Muting {1} alone isn't enough.", source, mute, shared);
    }

    // The same while the whole system is captured: what Windows plays on its
    // default output, or another app plays elsewhere, is heard there too.
    public pure function notice-heard-twice-system(mute: string, shared: string) -> string {
        if shared == "" {
            return @tr("You may hear your PC's sound twice: it also plays straight from {0}. Make an output you don't listen to the Windows default (Sound settings), or mute {0}.", mute);
        }
        if mute == "" {
            return @tr("You may hear your PC's sound twice: it also plays straight from {0}, where AudioSync plays too. Make an output you don't listen to the Windows default (Sound settings).", shared);
        }
        return @tr("You may hear your PC's sound twice: it also plays straight from {0}, and from {1}, where AudioSync plays too. Make an output you don't listen to the Windows default (Sound settings). Muting {0} alone isn't enough.", mute, shared);
    }

    // The double-audio guide, opened from Show How on that notice. Each list
    // is output names as "A, B and C" (list-and). AudioSync changes none of these
    // settings itself; a step's button opens the Settings page where the
    // user does.
    out property <string> guide-title: @tr("Avoid Double Audio");
    out property <string> guide-steps: @tr("Steps");
    out property <string> guide-footer: @tr("AudioSync doesn't change these settings itself. The notice goes away on its own once the sound plays only through AudioSync.");
    out property <string> guide-close: @tr("Close");
    // Shown in the guide when the shell didn't open the Settings page.
    out property <string> guide-settings-failed: @tr("Couldn't open Settings. Open it from the Start menu: Settings > System > Sound.");

    // Joins a list of names: `head` is all but the last, already joined by
    // commas ("TV, Speakers"), `last` the last one.
    public pure function list-and(head: string, last: string) -> string {
        return @tr("{0} and {1}", head, last);
    }

    public pure function guide-intro-app(source: string, outputs: string) -> string {
        return @tr("Windows keeps playing {0} straight from {1}, next to AudioSync's synced copies. To hear it only once:", source, outputs);
    }

    public pure function guide-intro-system(outputs: string) -> string {
        return @tr("Windows keeps playing your PC's sound straight from {0}, next to AudioSync's synced copies. To hear it only once:", outputs);
    }

    public pure function guide-route-app(source: string) -> string {
        return @tr("Open the Volume mixer, find {0} and set its output to one you don't listen to, such as a monitor's speakers you keep muted or an unused jack. AudioSync keeps playing to the speakers you turned on.", source);
    }

    // For an "all apps except" source: `names` are the apps it leaves out.
    public pure function guide-route-all-except(names: string) -> string {
        return @tr("Open the Volume mixer, find every app other than {0} and set each one's output to one you don't listen to, such as a monitor's speakers you keep muted or an unused jack. AudioSync keeps playing to the speakers you turned on.", names);
    }

    public pure function guide-change-default(current: string) -> string {
        return @tr("Open Sound settings and make an output you don't listen to the default instead of {0}, such as a monitor's speakers you keep muted or an unused jack. AudioSync keeps playing to the speakers you turned on.", current);
    }

    public pure function guide-route-other-apps(outputs: string) -> string {
        return @tr("Some apps play straight to {0}. In the Volume mixer, set them to an output you don't listen to as well.", outputs);
    }

    // `count` is how many outputs `outputs` names.
    public pure function guide-mute-outputs(outputs: string, count: int) -> string {
        if count == 1 {
            return @tr("Or, if you don't need {0}, mute it: in Sound settings, open it and turn its volume all the way down. AudioSync doesn't play there, so its copies stay as they are.", outputs);
        }
        return @tr("Or, if you don't need {0}, mute them: in Sound settings, open each of them and turn its volume all the way down. AudioSync doesn't play there, so its copies stay as they are.", outputs);
    }

    public pure function guide-shared-outputs(outputs: string) -> string {
        return @tr("Muting {0} won't help: AudioSync plays there too, so its copies would go quiet as well.", outputs);
    }

    public pure function guide-keep-app-unmuted(source: string) -> string {
        return @tr("Don't mute {0} itself in the Volume mixer: AudioSync would capture silence.", source);
    }

    public pure function guide-keep-all-except-unmuted(names: string) -> string {
        return @tr("Don't mute any app other than {0} in the Volume mixer: AudioSync would capture silence from it.", names);
    }

    // The label of a guide step's button.
    public pure function guide-open(page: GuidePage) -> string {
        if page == GuidePage.volume-mixer {
            return @tr("Open Volume Mixer");
        }
        if page == GuidePage.sound {
            return @tr("Open Sound Settings");
        }
        return "";
    }

    // The Guide (Help > AudioSync Guide): how to use the Windows app, one
    // heading and one text per section, paragraphs split by a blank line.
    // Each claim follows what windows/src does; nothing the Mac app alone does.
    out property <string> help-title: @tr("AudioSync Guide");
    out property <string> help-intro: @tr("AudioSync plays your PC's sound on AirPlay and Google Cast speakers and on the outputs connected to this PC at the same time, and lines them up with a delay for each speaker.");
    out property <string> help-start-title: @tr("First Steps");
    out property <string> help-start: @tr("The main window holds every control. The AudioSync icon in the notification area opens AudioSync quick settings, with the Streaming switch, the source, the volume and the speakers. Closing the window keeps AudioSync running there, and streaming goes on. To quit, choose File > Exit.\n\nUnder Audio Source, pick what to play: All System Audio, one app that plays sound, or an input device, such as a microphone or line in. If Windows blocks microphone access for desktop apps, a notice says so, with a button that opens those privacy settings.\n\nThe speakers are listed under This PC (the PC's own speakers or line out, and headphones on its jack), then your groups, then Connected Speakers: AirPlay and Google Cast speakers and every other output, such as USB, Bluetooth or HDMI, with its kind under its name.\n\nSelect a speaker's round button to turn it on; streaming starts with it. Select it again to turn it off. When you turn the Streaming switch off, your speakers stay chosen with an outlined button, and they play again when you turn streaming on or select any speaker.");
    out property <string> help-sync-title: @tr("Sync");
    out property <string> help-sync: @tr("The PC's own speakers are the reference and have no delay. Every other local speaker shows its delay relative to them. Without a reference, the speaker with the lowest value plays first and the others wait by the difference.\n\nTo change a delay, select the speaker's row or its value. The −100, −10, +10 and +100 buttons apply at once. You can also type a number, with + or − in front if you like, and apply it with Enter or Ctrl+S (File > Apply Typed Delay); the controls stay open. Selecting the row again, or clicking outside every speaker row, applies what you typed and closes the controls. Escape drops what you typed. A number out of range gets a red outline and a line that gives the range.\n\nHeard a speaker before the others? Raise its delay. Heard it late? Lower it, below 0 if needed.\n\nThe AirPlay Delay card under Connected Speakers sets how long the speakers on this PC wait for the AirPlay speakers. If the AirPlay speakers sound late, raise it; if they sound early, lower it. AudioSync keeps the AirPlay speakers in step with each other, so they have no delay of their own.");
    // The Sync section's second part, after the delay illustration.
    out property <string> help-sync-cast: @tr("Local and AirPlay speakers play in step: once their delays are set, AudioSync keeps them together. It can't sync Google Cast speakers automatically, so each one has an offset you set by ear in its row. If the Cast speaker sounds late, raise it, and the other speakers wait longer; if it sounds early, lower it. AudioSync keeps the offset for that speaker. If a Google Cast speaker doesn't show up, choose Speakers > Add by Address… and enter its IP address or host name. One Google Cast speaker plays at a time. A speaker group made in the Google Home app plays as one speaker, with one volume and one offset, and its speakers stay listed on their own. While a Google Cast speaker plays, Resync under its volume restarts the stream, with a short gap, so it lines up at its offset again.");
    // The Sync section's last part, after the illustration of the two kinds of timing.
    out property <string> help-sync-tune: @tr("Tune with two speakers at first, then add the others one at a time. A track with sharp sounds, such as drums or speech, makes an offset easy to hear.");
    // What each Guide illustration shows, for Narrator, worded as in the Mac Guide.
    out property <string> help-art-source: @tr("The sound of the whole system or one app going into AudioSync, which plays it on several speakers and headphones at once.");
    out property <string> help-art-delay: @tr("Two speakers playing the same sound toward a listener. The second starts later, held back by its delay, so their waves line up.");
    out property <string> help-art-classes: @tr("Left: local and AirPlay speakers playing in step. Right: a Google Cast speaker starting after an offset you set by ear.");
    out property <string> help-calibration-title: @tr("Calibration");
    out property <string> help-calibration: @tr("A microphone can measure delays for you. Put it where you listen and keep the room quiet. Each measurement compares a speaker with the PC's own speakers, so they have to be on and playing, and streaming has to be on too.\n\nTo measure one local speaker, turn it on, select its row or its delay, and select Calibrate with Microphone under the delay controls. Headphones and virtual outputs don't have that button. AudioSync fades the music out, plays a short, quiet sweep on the PC's own speakers and then on this speaker, and sets its delay from the difference. Cancel stops it and leaves the delay as it was.\n\nCalibrate All Speakers, on the Calibration card under Equalizer, measures every speaker that is on, AirPlay and Google Cast included. Headphones, headsets, earbuds and virtual outputs are left out, since the microphone can't hear them, and their delay stays yours to set; the card lists them with the reason. If a speaker reports itself as headphones or a virtual output, Include Anyway measures it with the others until you close the results. AudioSync fades the music out, plays a sweep on each speaker in turn, twice each, and fades the music back in. The results show each speaker's old and new delay; the AirPlay speakers share one AirPlay delay, the middle of their values. Nothing changes until you choose Apply. Undo puts the old delays back, and Measure Again repeats one speaker.\n\nIf Windows blocks microphone access for desktop apps, AudioSync says so and where to allow it.");
    out property <string> help-volume-title: @tr("Volume");
    out property <string> help-volume: @tr("Each speaker has its own volume slider, and Master Volume sets the level of all of them at once, AirPlay and Google Cast speakers included. A Google Cast speaker's slider sets the speaker's own volume, and Master Volume scales it like every other speaker. Mute under it mutes the speaker itself.\n\nWhen a local speaker that is on is turned down low or muted in Windows, a line under its slider says so, with a button that fixes it. AudioSync changes the Windows volume only when you select that button.");
    out property <string> help-bluetooth-title: @tr("Bluetooth");
    out property <string> help-bluetooth: @tr("Bluetooth speakers and headphones add a lag of their own, so they often need a delay below 0. They also take a little longer to start playing.\n\nFor a headset, AudioSync lists its stereo output and leaves out its Hands-Free output and microphone, which carry call audio.");
    out property <string> help-double-title: @tr("Hearing Sound Twice");
    out property <string> help-double: @tr("Windows keeps playing the source on its own outputs while AudioSync plays its synced copies, so you may hear it twice. For one app, open the Volume mixer and send the app to an output you don't listen to. For All System Audio, make such an output the Windows default in Sound settings. Don't mute the app itself in the Volume mixer: AudioSync would capture silence.\n\nWhen AudioSync detects this, it shows a notice. Its Show How button opens the steps for your setup.");
    out property <string> help-more-title: @tr("More Controls");
    out property <string> help-more: @tr("To make a group, turn on the speakers you want, then choose Speakers > New Group from Active Speakers (Ctrl+N). Select the group to turn them all on or off at once. To rename or delete it, right-click it or use its … button.\n\nTo rename a speaker, double-click its name, or right-click it or use its … button and choose Rename. Type a name and press Enter. Leave it empty to use the device's own name; while a speaker is renamed, its tooltip shows that name.\n\nTo have a speaker turn on whenever it appears, right-click it or use its … button, and choose Auto-connect when available. At launch, AudioSync starts streaming only when such a speaker is there.\n\nTo keep a speaker you never use out of the lists, choose Hide Speaker in its menu. A speaker that is on turns off first. Hidden Speakers in the Speakers menu lists what you hid; choose one to show it again, off, with its volume and delay as you left them.\n\nThe equalizer shapes the sound on every speaker at once, with ten bands, a preamp and presets. Open it from its card or with View > Equalizer (Ctrl+E).\n\nAirPlay speakers with a screen, such as a TV, show the track's title, artist, album and artwork, taken from the media controls Windows shows for apps that support them. With All System Audio, that's the track that is playing; with one app, that app's track, even while paused. Otherwise they show AudioSync, the source's name, the album From your PC and AudioSync's icon.\n\nVirtual outputs, such as loopback drivers, are hidden unless one is on. View > Show Virtual Devices lists them all. Speakers > Refresh Devices (F5) reads the sources and outputs again.\n\nTo start AudioSync when you sign in to Windows, choose File > Launch at Sign-In, or Launch at Sign-In in the menu of the AudioSync icon in the notification area. AudioSync then starts there without opening its window. If AudioSync is turned off in Settings > Apps > Startup, that page opens with a notice: turn AudioSync on there.\n\nView > Appearance: Match System follows Windows; Light or Dark keeps AudioSync's windows that way. The AudioSync icon in the notification area always follows the Windows theme.\n\nAudioSync saves the source, each speaker's switch, delay, volume and name, the speakers you hid, your groups and the equalizer, and restores them the next time it starts.");
    out property <string> help-airplay-title: @tr("AirPlay");
    out property <string> help-airplay: @tr("AudioSync finds AirPlay speakers on your network by itself. If none show up, check that this PC is on the same network as your speakers and that the network is set to Private. If it has to stay Public, allow AudioSync on Public networks in Windows Firewall.\n\nAudioSync for Windows plays to AirPlay 1 receivers. A speaker that plays only AirPlay 2, or needs something else AudioSync for Windows can't do yet, is listed with a note saying so, and stays off unless AirPlay 2 (Experimental) is on.\n\nAn Apple TV that asks for a PIN shows \"Asks for a code\". When you turn it on, the TV shows a PIN: type it in the dialog that opens. AudioSync keeps the pairing, so the PIN isn't asked again. Forget Pairing in the speaker's … menu removes it. Auto-connect never starts a pairing: it shows a notice instead.\n\nA speaker protected by a password shows \"Asks for a code\" too. When you turn it on, type the password set for it in the Home app or in the speaker's settings. AudioSync keeps it in memory until it quits, so it asks once each time AudioSync starts. A wrong password brings the dialog back; Cancel leaves the speaker off. If a speaker turns the password down after it has started playing, it goes off with a notice. A speaker that auto-connect turned on goes off with a notice instead: turn it on yourself to type the password.\n\nIf AudioSync's AirPlay sender stops or can't start, a notice says so, with a Retry button.\n\n'AirPlay 2 (Experimental)', in the File menu, lets AudioSync play to AirPlay 2 speakers, stereo pairs and home theater groups. It's off at first; turn it on, then quit and reopen AudioSync. With it on, a stereo pair or home theater group shows as one row, and its note names the speakers in it.");
    out property <string> help-remote-title: @tr("Web Remote");
    out property <string> help-remote: @tr("A phone on the same network as this PC can switch your speakers on and off and set their volume and delay and the master volume, and it shows what's playing. Choose File > Web Remote…, turn Web Remote on, and open the address it shows on the phone (or scan its QR code). Add the page to the Home Screen before you enter the code, then open AudioSync from the new icon and pair there: on iPhone, a pairing made in Safari doesn't carry over to the Home Screen app. The window shows these steps for iPhone and Android. Each code works once and for 10 minutes; the window shows the next one, and New Code makes a fresh one.\n\nThe page uses plain HTTP, so use the web remote only on your home network. On a network Windows calls Public, the window and a notice say so. Forget All Remote Devices unpairs every phone, also while the remote is off. If another app already uses the port, the window says so and lets you pick another one.");
    out property <string> help-notices-title: @tr("Notices");
    out property <string> help-notices: @tr("When something needs your attention, such as a speaker that was disconnected or an app that quit, a notice appears at the top of the main window, and the newest one in quick settings. Use its close button to dismiss it, or Dismiss All. Many notices also clear themselves once the cause is gone.\n\nWhen the app you picked as the source quits, streaming stops and a notice says so. To keep playing instead, turn on File > Switch to All System Audio When the Source App Quits: AudioSync then moves to All System Audio, and stays there when the app opens again.");

    // A notice's dismiss button, for Narrator: it names the notice in a few
    // words (its title), so the next notice's button, which takes the focus
    // after a dismiss, says which notice it closes without reading it all
    // again.
    public pure function dismiss-notice(title: string) -> string {
        return @tr("Dismiss: {}", title);
    }

    // A notice's title: a few words after "Dismiss:", with the app or
    // speaker it is about as `name`.
    public pure function notice-title(kind: NoticeKind, name: string) -> string {
        if kind == NoticeKind.no-speaker {
            return @tr("no speaker on");
        }
        if kind == NoticeKind.source-quit || kind == NoticeKind.source-switched {
            return @tr("{} quit", name);
        }
        if kind == NoticeKind.source-not-running {
            return @tr("{} not running", name);
        }
        if kind == NoticeKind.source-refused {
            return @tr("can't capture {}", name);
        }
        if kind == NoticeKind.input-not-connected {
            return @tr("{} not connected", name);
        }
        if kind == NoticeKind.input-disconnected {
            return @tr("{} was disconnected, streaming stopped", name);
        }
        if kind == NoticeKind.microphone-blocked {
            return @tr("microphone access blocked");
        }
        if kind == NoticeKind.capture-failed {
            return @tr("capture didn't start");
        }
        if kind == NoticeKind.capture-lost {
            return @tr("capture stopped");
        }
        if kind == NoticeKind.speaker-failed {
            return @tr("{} didn't start, turned off", name);
        }
        if kind == NoticeKind.speaker-lost {
            return @tr("{} disconnected", name);
        }
        if kind == NoticeKind.speaker-busy {
            return @tr("{} in use", name);
        }
        if kind == NoticeKind.airplay-retrying {
            return @tr("{} reconnecting", name);
        }
        if kind == NoticeKind.airplay-waiting {
            return @tr("{} waiting", name);
        }
        if kind == NoticeKind.airplay-cant-play {
            return @tr("{} can't play", name);
        }
        if kind == NoticeKind.airplay-stopped {
            return @tr("AirPlay stopped");
        }
        if kind == NoticeKind.airplay-ptp-ports-taken {
            return @tr("PTP ports in use");
        }
        if kind == NoticeKind.settings-not-saved {
            return @tr("settings not saved");
        }
        if kind == NoticeKind.pairings-not-saved {
            return @tr("pairings not saved");
        }
        if kind == NoticeKind.settings-kept-aside {
            return @tr("settings unreadable, copy kept");
        }
        if kind == NoticeKind.pairings-kept-aside {
            return @tr("pairings unreadable, copy kept");
        }
        if kind == NoticeKind.no-sound-output {
            return @tr("no sound output");
        }
        if kind == NoticeKind.launch-at-login-failed {
            return @tr("launch at sign-in failed");
        }
        if kind == NoticeKind.launch-at-login-not-removed {
            return @tr("launch at sign-in still on");
        }
        if kind == NoticeKind.launch-at-login-off-in-settings {
            return @tr("startup app turned off");
        }
        if kind == NoticeKind.airplay2-next-launch {
            return @tr("AirPlay 2 after restart");
        }
        if kind == NoticeKind.remote-public-network {
            return @tr("web remote on Public network");
        }
        if kind == NoticeKind.cast-cant-play {
            return @tr("{} can't play", name);
        }
        if kind == NoticeKind.airplay-ahead-of-cast {
            return @tr("AirPlay ahead of {}", name);
        }
        return @tr("double audio");
    }

    // An entry of Hidden Speakers; `present`: listed now, only hidden.
    public pure function hidden-speaker-entry(name: string, kind: string, present: bool) -> string {
        if present {
            return kind == "" ? name : @tr("{} ({})", name, kind);
        }
        return kind == "" ? @tr("{} (not found)", name) : @tr("{} ({}, not found)", name, kind);
    }

    // What Narrator says after Hide Speaker, and after a Hidden Speakers entry.
    public pure function speaker-hidden(name: string) -> string {
        return @tr("{} hidden", name);
    }

    public pure function speaker-shown(name: string) -> string {
        return @tr("{} shown", name);
    }

    public pure function speaker-options(name: string) -> string {
        return @tr("Options for {}", name);
    }

    // A row's accessible value.
    public pure function value(state: RowState) -> string {
        if state == RowState.off {
            return root.off;
        }
        if state == RowState.will-play {
            return root.will-play;
        }
        if state == RowState.waiting-for-device || state == RowState.reconnecting
                || state == RowState.waiting-for-airplay2 {
            return root.row-note(state);
        }
        return root.on;
    }

    // The note under the name of a speaker that is on but can't play right
    // now; empty otherwise.
    public pure function row-note(state: RowState) -> string {
        if state == RowState.waiting-for-device {
            return root.waiting-for-device;
        }
        if state == RowState.reconnecting {
            return root.reconnecting;
        }
        if state == RowState.waiting-for-airplay2 {
            return root.waiting-for-airplay2;
        }
        return "";
    }

    // What selecting a row does, read after its value.
    public pure function help(state: RowState) -> string {
        if state == RowState.off {
            return root.turn-on;
        }
        if state == RowState.will-play {
            return root.will-play-help;
        }
        return root.turn-off;
    }

    // The note next to an AirPlay speaker that can't simply play.
    public pure function availability(a: Availability) -> string {
        if a == Availability.needs-code {
            return @tr("Asks for a code");
        }
        if a == Availability.pairing {
            return @tr("Pairing…");
        }
        if a == Availability.waiting-to-pair {
            return @tr("Waiting to pair…");
        }
        if a == Availability.pairing-not-yet {
            return @tr("Pairing not supported yet");
        }
        if a == Availability.airplay2-not-yet {
            return @tr("AirPlay 2 is off");
        }
        if a == Availability.airplay2-next-launch {
            return @tr("AirPlay 2 is off until AudioSync reopens");
        }
        if a == Availability.unsupported {
            return @tr("Not supported");
        }
        return "";
    }

    // The note under a Google Cast speaker's name: where one that is on is,
    // else a group's `group-note` (empty for a single speaker).
    public pure function cast-note(state: CastState, muted: bool, group-note: string) -> string {
        if state == CastState.connecting {
            return @tr("Connecting…");
        }
        if muted && group-note != "" {
            return @tr("Muted on the group");
        }
        if muted {
            return @tr("Muted on the speaker");
        }
        return group-note;
    }

    // Under a Google Cast group's name: its members as "A, B and C"
    // (list-and) once a session named them; `unknown` once one played
    // without naming them.
    public pure function cast-group-note(members: string, unknown: bool) -> string {
        if members != "" {
            return @tr("Google Cast group: {}", members);
        }
        if unknown {
            return @tr("Google Cast group, members unknown");
        }
        return @tr("Google Cast group");
    }

    // What Narrator reads for a Google Cast group's switch: "Attic, Google
    // Cast group: Kitchen and Living Room", the group's note after its name.
    public pure function cast-group-label(name: string, note: string) -> string {
        return @tr("{0}, {1}", name, note);
    }

    // Under a Google Cast speaker's volume while it connects or plays.
    out property <string> cast-mute: @tr("Mute");
    out property <string> cast-unmute: @tr("Unmute");
    out property <string> cast-mute-help: @tr("Mutes the speaker itself");
    out property <string> cast-unmute-help: @tr("Unmutes the speaker itself");
    out property <string> cast-resync: @tr("Resync");
    out property <string> cast-resync-help: @tr("Restarts the stream, with a short gap, so this speaker plays at its delay again");

    // What Narrator reads for those buttons: what the button shows, so speech
    // input finds it by its text, then the speaker ("Mute, Kitchen").
    public pure function cast-button-label(text: string, name: string) -> string {
        return @tr("{0}, {1}", text, name);
    }

    // Under a Google Cast speaker's volume when the device locks it.
    out property <string> cast-volume-fixed: @tr("This speaker's volume can't be changed from AudioSync.");

    // Beside a Google Cast speaker's delay, in place of the sync hint.
    out property <string> cast-sync-hint: @tr("AudioSync can't sync Google Cast speakers automatically, so it keeps the others only roughly in step with this one. Set this by ear: heard this speaker late? Raise the value, and the other speakers wait longer. Heard it early? Lower it. AudioSync keeps it for this speaker; check it again when you start it.");

    public pure function speaker-kind(kind: SpeakerKind) -> string {
        if kind == SpeakerKind.airplay {
            return @tr("AirPlay");
        }
        if kind == SpeakerKind.airplay2 {
            return @tr("AirPlay 2");
        }
        if kind == SpeakerKind.cast {
            return @tr("Google Cast");
        }
        if kind == SpeakerKind.built-in {
            return @tr("Built-in");
        }
        if kind == SpeakerKind.headphones {
            return @tr("Headphones");
        }
        if kind == SpeakerKind.bluetooth {
            return @tr("Bluetooth");
        }
        if kind == SpeakerKind.usb || kind == SpeakerKind.usb-headphones || kind == SpeakerKind.usb-speakers {
            return @tr("USB");
        }
        if kind == SpeakerKind.hdmi {
            return @tr("HDMI");
        }
        if kind == SpeakerKind.display-port {
            return @tr("DisplayPort");
        }
        if kind == SpeakerKind.virtual {
            return @tr("Virtual");
        }
        return @tr("Other");
    }

    // A speaker row's accessible label: "Kitchen, AirPlay", followed for a
    // renamed speaker by the name its device reports (`system`, else empty).
    public pure function speaker-label(name: string, kind: SpeakerKind, show-kind: bool, system: string) -> string {
        if system == "" && !show-kind {
            return name;
        }
        if system == "" {
            return @tr("{}, {}", name, root.speaker-kind(kind));
        }
        if !show-kind {
            return @tr("{}, device name {}", name, system);
        }
        return @tr("{}, {}, device name {}", name, root.speaker-kind(kind), system);
    }

    // The name field's accessible label; its placeholder is the device's
    // own name, which an empty field brings back.
    public pure function speaker-name-field(system: string) -> string {
        return @tr("Name for {}", system);
    }

    // What the name field says about its keys.
    out property <string> speaker-name-field-hint: @tr("Press Enter to apply or Escape to cancel. Leave it empty for the device's own name.");

    // The tooltip on a speaker's name: the full name, which the row may
    // elide, then how to rename it. `system` is empty unless renamed.
    public pure function speaker-name-tooltip(name: string, system: string) -> string {
        if system != "" {
            return @tr("{}\nDevice name: {}. Double-click to rename.", name, system);
        }
        return @tr("{}\nDouble-click to rename.", name);
    }

    // What a stereo pair or home theater group row says after its kind:
    // what it is and its members ("Stereo pair: Left and Right"), or the
    // members out of view or playing nothing. `members` and `missing` are
    // names joined by list-and; `missing` is empty when no name is known.
    public pure function group-note(group: SpeakerGroup, members: string, missing: string, incomplete: bool) -> string {
        if group == SpeakerGroup.stereo-pair {
            if !incomplete && members == "" {
                return @tr("Stereo pair");
            }
            if !incomplete {
                return @tr("Stereo pair: {}", members);
            }
            if missing != "" {
                return @tr("Stereo pair, missing {}", missing);
            }
            return @tr("Stereo pair, a speaker is missing");
        }
        if group == SpeakerGroup.home-theater {
            if !incomplete && members == "" {
                return @tr("Home theater group");
            }
            if !incomplete {
                return @tr("Home theater group: {}", members);
            }
            if missing != "" {
                return @tr("Home theater group, missing {}", missing);
            }
            return @tr("Home theater group, a speaker is missing");
        }
        return "";
    }

    // What Narrator reads after a row's name: a group's note first, then
    // the row's own description.
    public pure function with-group-note(group-note: string, description: string) -> string {
        if group-note == "" {
            return description;
        }
        return @tr("{}. {}", group-note, description);
    }

    // The line under a speaker's name: its kind, its note, or both
    // ("AirPlay · Asks for a code"); either may be empty.
    public pure function speaker-caption(kind: string, note: string) -> string {
        if kind == "" {
            return note;
        }
        if note == "" {
            return kind;
        }
        return @tr("{} · {}", kind, note);
    }

    public pure function volume-of(name: string) -> string {
        return @tr("{} volume", name);
    }

    public pure function volume-value(volume: float) -> string {
        return round(volume);
    }

    public pure function delay-of(name: string) -> string {
        return @tr("{} delay", name);
    }

    // Under a delay field, in place of the Enter hint, while it holds a
    // number out of the delay's range; also the field's Narrator
    // description then.
    public pure function delay-out-of-range(lowest: string, highest: string, applies: string) -> string {
        return @tr("The range is {} to {} ms. Enter applies {}.", lowest, highest, applies);
    }

    // An offset relative to the reference, with its sign: "+150 ms",
    // "−250 ms", "0 ms".
    public pure function delay-value(ms: int) -> string {
        if ms > 0 {
            return @tr("+{} {}", ms, root.milliseconds-unit);
        }
        if ms < 0 {
            return @tr("−{} {}", -ms, root.milliseconds-unit);
        }
        return @tr("{} {}", ms, root.milliseconds-unit);
    }

    // A switched-on output's own volume in Windows, under its volume slider
    // when it is low or muted (spec S199); `percent` is its whole percent.
    // The fix sets this volume, which the core decides (FIX_VOLUME).
    out property <int> device-volume-fix-percent: 75;

    public pure function device-volume-hint(hint: DeviceVolumeHint, percent: int) -> string {
        if hint == DeviceVolumeHint.low {
            return @tr("Windows volume is {}%", percent);
        }
        if hint == DeviceVolumeHint.muted {
            return @tr("Muted in Windows");
        }
        if hint == DeviceVolumeHint.muted-low {
            return @tr("Muted in Windows, volume {}%", percent);
        }
        return "";
    }

    // The button after the hint that fixes it.
    public pure function device-volume-fix(hint: DeviceVolumeHint) -> string {
        if hint == DeviceVolumeHint.low {
            return @tr("Set to {}%", root.device-volume-fix-percent);
        }
        if hint == DeviceVolumeHint.muted {
            return @tr("Unmute");
        }
        if hint == DeviceVolumeHint.muted-low {
            return @tr("Unmute at {}%", root.device-volume-fix-percent);
        }
        return "";
    }

    // What Narrator reads for the hint: the output, then the hint
    // ("Speakers: Windows volume is 13%").
    public pure function device-volume-hint-label(name: string, hint: DeviceVolumeHint, percent: int) -> string {
        if hint == DeviceVolumeHint.low {
            return @tr("{0}: Windows volume is {1}%", name, percent);
        }
        if hint == DeviceVolumeHint.muted {
            return @tr("{}: muted in Windows", name);
        }
        if hint == DeviceVolumeHint.muted-low {
            return @tr("{0}: muted in Windows, volume {1}%", name, percent);
        }
        return "";
    }

    // What Narrator reads for the fix: what the button shows, so speech
    // input finds it by its text, then the output ("Set to 75%, Speakers").
    public pure function device-volume-fix-label(name: string, hint: DeviceVolumeHint) -> string {
        return @tr("{0}, {1}", root.device-volume-fix(hint), name);
    }

    // A speaker row's description in the tray flyout: the device-volume
    // hint, when there is one, then what selecting the row does.
    public pure function flyout-speaker-description(help: string, hint: string) -> string {
        if hint == "" {
            return help;
        }
        return @tr("{0}. {1}", hint, help);
    }

    // The hint beside the sync controls: what the values are relative to.
    public pure function sync-hint(reference: string) -> string {
        if reference == "" {
            return root.sync-hint-no-reference;
        }
        return @tr("Relative to {}. Heard this speaker first? Raise the value. Heard it late? Lower it.", reference);
    }

    // Microphone calibration of a local speaker against the reference (spec
    // S232), under its sync controls.
    out property <string> calibrate-with-microphone: @tr("Calibrate with Microphone");
    out property <string> calibration-cancel: @tr("Cancel");
    out property <string> calibration-preparing: @tr("Fading the music out…");
    out property <string> calibration-listening-chosen: @tr("Listening to this speaker…");
    out property <string> calibration-estimating: @tr("Working out the delay…");
    out property <string> calibration-cancelled: @tr("Calibration cancelled. The delay wasn't changed.");
    out property <string> calibration-this-speaker: @tr("this speaker");
    out property <string> calibration-a-speaker: @tr("a speaker");
    out property <string> calibration-no-reference: @tr("Calibration measures against the PC's own speakers, and they aren't listed.");
    out property <string> calibration-turn-on: @tr("Turn on streaming and this speaker to calibrate it.");
    out property <string> calibration-microphone-denied: @tr("Windows is blocking microphone access for desktop apps. Turn on \"Let desktop apps access your microphone\" in Settings > Privacy & security > Microphone, and try again.");
    out property <string> calibration-no-microphone: @tr("AudioSync couldn't record from the microphone. Check the input in Settings > System > Sound.");
    out property <string> calibration-unsupported-rate: @tr("The microphone runs at a sample rate calibration can't use. Set its format to 48 kHz in Settings > System > Sound, and try again.");
    out property <string> calibration-source-silent: @tr("The test sound couldn't start because streaming stalled. Turn streaming off and on, and try again.");
    out property <string> calibration-interrupted: @tr("Streaming, the speakers or their delays changed during the measurement.");
    out property <string> calibration-microphone-changed: @tr("The microphone changed between the two measurements. Keep one microphone as the default input, and try again.");
    out property <string> calibration-microphone-skipped: @tr("The microphone dropped audio during the measurement, so its timing can't be trusted. Try again.");
    out property <string> calibration-hands-free: @tr("The default microphone is a Bluetooth headset's hands-free input, and recording from it would switch the headset to call mode. Choose another input in Settings > System > Sound, and try again.");
    out property <string> calibration-microphone-in-use: @tr("Another app has the microphone to itself. Close that app, or under Settings > System > Sound > More sound settings > Recording, open the microphone's Properties and turn off \"Allow applications to take exclusive control of this device\" on the Advanced tab, and try again.");
    out property <string> calibration-unfinished: @tr("AudioSync couldn't finish working out the delay. Try again.");
    out property <string> calibration-too-short: @tr("The recording was too short. Try again.");
    out property <string> calibration-too-long: @tr("The delays are too long to measure in one recording at the microphone's sample rate. Lower the largest delay, or set the microphone's format to 48 kHz in Settings > System > Sound, and try again.");
    out property <string> calibration-implausible: @tr("The two speakers were too far apart to measure.");

    public pure function calibrate-label(name: string) -> string {
        return @tr("Calibrate {} with the microphone", name);
    }

    public pure function calibration-cancel-label(name: string) -> string {
        return @tr("Cancel calibrating {}", name);
    }

    public pure function calibration-hint(reference: string) -> string {
        if reference == "" {
            return @tr("Put the microphone where you listen. AudioSync fades the music out, plays a short, quiet sweep on the PC's own speakers and then on this speaker, sets this speaker's delay from the difference and fades the music back in.");
        }
        return @tr("Put the microphone where you listen. AudioSync fades the music out, plays a short, quiet sweep on {} and then on this speaker, sets this speaker's delay from the difference and fades the music back in.", reference);
    }

    public pure function calibration-listening(name: string) -> string {
        return @tr("Listening to {}…", name);
    }

    public pure function calibration-not-playing(reference: string) -> string {
        return @tr("Turn on streaming, this speaker and {} first.", reference);
    }

    public pure function calibration-clipped(subject: string) -> string {
        return @tr("The microphone was overloaded while {} played. Turn the volume down or move the microphone farther away, and try again.", subject);
    }

    public pure function calibration-too-quiet(subject: string) -> string {
        return @tr("The microphone barely heard {}. Turn the volume up or move the microphone closer, and try again.", subject);
    }

    public pure function calibration-echo(subject: string) -> string {
        return @tr("An echo or another sound was almost as loud as {}. Give the microphone a clear line to both speakers and try again.", subject);
    }

    public pure function calibration-done(ms: int) -> string {
        return @tr("Delay set to {}.", root.delay-value(ms));
    }

    public pure function calibration-done-clamped(ms: int) -> string {
        return @tr("Delay set to {}, the end of the range. The measured difference is larger, so this speaker stays a little out of sync.", root.delay-value(ms));
    }

    // A calibration that changed nothing: why, then that the delay stays.
    public pure function calibration-failed(reason: string) -> string {
        return @tr("{} The delay wasn't changed.", reason);
    }

    // Calibrate All Speakers (spec S235 to S240), a card in the main window:
    // every speaker that is on, measured against the reference, then a list
    // of results to apply.
    out property <string> calibrate-all-title: @tr("Calibration");
    out property <string> calibrate-all: @tr("Calibrate All Speakers");
    out property <string> calibrate-all-cancel-label: @tr("Cancel calibrating all speakers");
    out property <string> calibrate-all-results: @tr("Results");
    out property <string> calibrate-all-apply: @tr("Apply");
    out property <string> calibrate-all-apply-help: @tr("Sets the new delays of the speakers that were measured clearly. Undo puts them all back.");
    out property <string> calibrate-all-undo: @tr("Undo");
    out property <string> calibrate-all-undo-help: @tr("Puts back every delay that Apply replaced.");
    out property <string> calibrate-all-close: @tr("Close");
    out property <string> calibrate-all-close-label: @tr("Close the calibration results");
    out property <string> calibrate-all-again: @tr("Measure Again");
    out property <string> calibrate-all-reference: @tr("The reference. The other speakers are measured against it.");
    out property <string> calibrate-all-not-measured: @tr("Not measured.");
    // A delay never stored: "Was none."
    out property <string> calibrate-all-none: @tr("none");
    out property <string> calibrate-all-airplay-waits: @tr("AirPlay isn't playing, so the AirPlay delay can't be set now. Apply and Undo work again once it plays.");
    out property <string> calibrate-all-busy: @tr("Another calibration is still running.");
    out property <string> calibrate-all-nothing-certain: @tr("No speaker was measured clearly, so there is nothing to apply.");
    out property <string> calibrate-all-estimating: @tr("Working out the delays…");
    out property <string> calibrate-all-applied: @tr("New delays applied.");
    out property <string> calibrate-all-undone: @tr("The delays are back to what they were.");
    out property <string> calibrate-all-stale: @tr("A delay changed after the measurement, so nothing was applied. Calibrate again.");
    out property <string> calibrate-all-ended-cancelled: @tr("Calibration cancelled.");
    out property <string> calibrate-all-ended-speakers: @tr("The speakers or their delays changed during the measurement.");
    out property <string> calibrate-all-ended-off: @tr("A speaker was turned off during the measurement.");
    out property <string> calibrate-all-ended-source: @tr("Streaming stopped or the source changed during the measurement.");

    public pure function calibrate-all-hint(reference: string) -> string {
        if reference == "" {
            return @tr("Put the microphone where you listen. AudioSync fades the music out, plays a short sweep on the PC's own speakers and then on every other speaker that is on, one at a time, twice each, and fades the music back in. Headphones and virtual outputs are left out. Nothing changes until you choose Apply.");
        }
        return @tr("Put the microphone where you listen. AudioSync fades the music out, plays a short sweep on {} and then on every other speaker that is on, one at a time, twice each, and fades the music back in. Headphones and virtual outputs are left out. Nothing changes until you choose Apply.", reference);
    }

    public pure function calibrate-all-turn-on(reference: string) -> string {
        if reference == "" {
            return @tr("Turn on streaming and at least one speaker besides the PC's own speakers first.");
        }
        return @tr("Turn on streaming and at least one speaker besides {} first.", reference);
    }

    // Measure Again was refused: the reference or that row's speaker doesn't play.
    public pure function calibrate-all-cannot-again(reference: string, name: string) -> string {
        if reference == "" {
            return @tr("Turn on streaming, the PC's own speakers and {} to measure it again.", name);
        }
        return @tr("Turn on streaming, {} and {} to measure it again.", reference, name);
    }

    public pure function calibrate-all-nothing(reference: string) -> string {
        if reference == "" {
            return @tr("Only the PC's own speakers are on. Turn on another speaker to calibrate it.");
        }
        return @tr("Only {} is on. Turn on another speaker to calibrate it.", reference);
    }

    // Every other speaker that is on is left out by its kind.
    out property <string> calibrate-all-only-left-out: @tr("The other speakers that are on are headphones or virtual outputs, which the microphone can't hear. Turn on another speaker, or choose Include Anyway for one below.");
    out property <string> calibrate-all-included: @tr("Included anyway: measured in this run.");
    out property <string> calibrate-all-left-out-title: @tr("Left out");
    out property <string> include-anyway: @tr("Include Anyway");
    out property <string> include-anyway-help-headphones: @tr("For a speaker that reports itself as headphones. It counts until you close the calibration results.");
    out property <string> include-anyway-help-virtual: @tr("For a virtual output that passes the sound on to a speaker. It counts until you close the calibration results.");
    out property <string> leave-out: @tr("Leave Out");

    public pure function include-anyway-label(name: string) -> string {
        return @tr("Include {} anyway", name);
    }

    public pure function leave-out-label(name: string) -> string {
        return @tr("Leave {} out", name);
    }

    // In a left-out output's delay controls, instead of Calibrate with
    // Microphone, and under its name in Calibrate All's left-out list.
    out property <string> calibration-left-out-headphones: @tr("Left out of microphone calibration: the microphone can't hear headphones.");
    out property <string> calibration-left-out-virtual: @tr("Left out of microphone calibration: a virtual output has nothing for the microphone to hear.");

    // Take is 1 or 2: each speaker plays the sweep twice.
    public pure function calibrate-all-sweep(name: string, take: int) -> string {
        return @tr("Listening to {}, sweep {} of 2…", name, take);
    }

    // A Cast speaker without a stored delay: its first recording is the
    // longest one, since nothing says when it plays.
    public pure function calibrate-all-searching(name: string) -> string {
        return @tr("Listening to {}, sweep 1 of 2. AudioSync doesn't know this speaker's delay yet, so this can take up to a minute.", name);
    }

    public pure function calibrate-all-ms(ms: int) -> string {
        return @tr("{} {}", ms, root.milliseconds-unit);
    }

    public pure function calibrate-all-certain(old: string, new: string, uncertainty: int) -> string {
        return @tr("Was {}. New: {} ± {} ms.", old, new, uncertainty);
    }

    public pure function calibrate-all-clamped(old: string, new: string, uncertainty: int) -> string {
        return @tr("Was {}. New: {} ± {} ms, the end of the range, so this speaker stays a little out of sync.", old, new, uncertainty);
    }

    public pure function calibrate-all-uncertain(old: string, new: string, uncertainty: int) -> string {
        return @tr("Was {}. Measured {} ± {} ms. The two sweeps differ too much, so the delay stays. Select Measure Again.", old, new, uncertainty);
    }

    public pure function calibrate-all-refused(reason: string) -> string {
        return @tr("{} The delay stays.", reason);
    }

    // Old is a delay ("2000 ms") or calibrate-all-none.
    public pure function calibrate-all-airplay-one(old: string, new: int) -> string {
        return @tr("AirPlay delay: was {}. New: {} ms.", old, new);
    }

    public pure function calibrate-all-airplay-median(old: string, new: int, count: int, spread: int) -> string {
        return @tr("AirPlay delay: was {}. New: {} ms, the middle value of {} AirPlay speakers, which are {} ms apart.", old, new, count, spread);
    }

    public pure function calibrate-all-airplay-spread(spread: int) -> string {
        return @tr("The AirPlay speakers differ by {} ms. AudioSync sets one delay for all AirPlay speakers, so they can't all line up exactly.", spread);
    }

    public pure function calibrate-all-airplay-none(old: string) -> string {
        return @tr("No AirPlay speaker was measured clearly, so the AirPlay delay stays at {}.", old);
    }

    public pure function calibrate-all-finished(clear: int, total: int) -> string {
        return @tr("Calibration finished. {} of {} measured clearly.", clear, total);
    }

    // A run that ended early: why, then that nothing changed.
    public pure function calibrate-all-stopped(reason: string) -> string {
        return @tr("{} No delay was changed.", reason);
    }

    // A Measure Again that ended early: why, then that its row stays.
    public pure function calibrate-all-again-stopped(reason: string) -> string {
        return @tr("{} That row stays as it was.", reason);
    }

    public pure function calibrate-all-again-label(name: string) -> string {
        return @tr("Measure {} again", name);
    }

    // The label of a delay step button: "−100", "+10".
    public pure function delay-step(delta: int) -> string {
        return delta < 0 ? "−" + (-delta) : "+" + delta;
    }

    public pure function delay-step-accessibility(delta: int) -> string {
        if delta < 0 {
            return @tr("Decrease delay by {} {}", -delta, root.milliseconds-unit);
        }
        return @tr("Increase delay by {} {}", delta, root.milliseconds-unit);
    }

    public pure function group-members(available: int, total: int) -> string {
        if available == total {
            return @tr("{n} speaker" | "{n} speakers" % total);
        }
        return @tr("{} of {} speakers available", available, total);
    }

    // A new group's name when none was typed.
    public pure function numbered-group(n: int) -> string {
        return @tr("Group {}", n);
    }

    public pure function rename-group-message(name: string) -> string {
        return @tr("Enter a new name for “{}”.", name);
    }

    public pure function equalizer-caption(max-gain: int) -> string {
        return @tr("±{} dB · applied to every speaker", max-gain);
    }

    public pure function equalizer-preset(id: string) -> string {
        if id == "flat" {
            return @tr("Flat");
        }
        if id == "bassBoost" {
            return @tr("Bass Boost");
        }
        if id == "bassCut" {
            return @tr("Bass Cut");
        }
        if id == "trebleBoost" {
            return @tr("Treble Boost");
        }
        if id == "vocal" {
            return @tr("Vocal");
        }
        if id == "rock" {
            return @tr("Rock");
        }
        if id == "pop" {
            return @tr("Pop");
        }
        if id == "jazz" {
            return @tr("Jazz");
        }
        if id == "classical" {
            return @tr("Classical");
        }
        if id == "electronic" {
            return @tr("Electronic");
        }
        if id == "loudness" {
            return @tr("Loudness");
        }
        if id == "smallSpeakers" {
            return @tr("Small Speakers");
        }
        return id;
    }

    // A band's short label under its slider: "32", "125", "1k", "16k".
    public pure function equalizer-band-short(hz: float) -> string {
        return hz >= 1000 ? floor(hz / 1000) + "k" : floor(hz);
    }

    // A band's spoken name: "125 Hz", "1 kHz".
    public pure function equalizer-band-name(hz: float) -> string {
        return hz >= 1000 ? @tr("{} kHz", floor(hz / 1000)) : @tr("{} Hz", floor(hz));
    }

    // A gain above its slider: "+2.5", "+3", "0", "−1.5" (0.5 dB steps).
    public pure function equalizer-gain(db: float) -> string {
        if round(db * 10) == 0 {
            return "0";
        }
        return (db > 0 ? "+" : "−") + (round(abs(db) * 10) / 10);
    }

    // A gain as Narrator reads it: "+2.5 dB".
    public pure function equalizer-gain-value(db: float) -> string {
        return @tr("{} dB", root.equalizer-gain(db));
    }
}
