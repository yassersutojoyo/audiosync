    out property <string> previous-track: @tr("Previous Track");
    out property <string> next-track: @tr("Next Track");
    out property <string> play: @tr("Play");
    out property <string> pause: @tr("Pause");
    // What AirPlay receivers with a screen show while no track counts: the
