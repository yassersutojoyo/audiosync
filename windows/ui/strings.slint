// Every user-facing string of the Windows app, worded like the macOS app's
// UIStrings (Sources/AudioSync/Localization.swift), with Windows words where the
// platform differs ("This PC", "Exit"). The Rust side reads the tray menu and
// tooltip from here too, so nothing is spelled out anywhere else.
//
// English only for now. @tr marks each string for Slint's gettext translation
// when a second language is added.

import { SpeakerKind, Availability, AirPlayProblem, CastList, CastProblem, CastState, DeviceVolumeHint, GuidePage, NoticeKind, PinPhase, RowState } from "types.slint";

export global Strings {
    // Main window
    out property <string> app-name: "AudioSync";
    out property <string> main-window-title: "AudioSync";
    out property <string> streaming-switch: @tr("Streaming");
    out property <string> turn-on: @tr("Turn On");
    out property <string> turn-off: @tr("Turn Off");
    out property <string> on: @tr("On");
    out property <string> off: @tr("Off");
    out property <string> will-play: @tr("Will play");
    out property <string> will-play-help: @tr("Plays when streaming starts. Select to start streaming.");
    // A speaker that is on while streaming is on, but can't play right now:
    // another app holds its device, or AudioSync keeps trying to reach an
    // AirPlay speaker. Its row says so instead of showing it as playing.
    out property <string> waiting-for-device: @tr("Waiting for device");
    out property <string> reconnecting: @tr("Reconnecting…");
    out property <string> waiting-for-airplay2: @tr("Waiting for the other AirPlay 2 speaker");
    out property <string> status-off: @tr("Off");
    out property <string> connected-none: @tr("No connected speakers");
    // The flyout's speaker list when it has no speaker and no group.
    out property <string> no-speakers: @tr("No speakers found");
    // Connected Speakers when its only outputs are virtual ones, hidden.
    out property <string> connected-none-virtual-hidden: @tr("No connected speakers. Virtual devices are hidden; to list them, choose View > Show Virtual Devices.");
    // Under Connected Speakers once AirPlay discovery has run for 20 seconds
    // without finding a speaker (a firewall or a Public network blocks it).
    out property <string> airplay-none-found: @tr("No AirPlay speakers found yet. Make sure this PC is on the same network as your speakers, and that Windows Firewall allows AudioSync on it (or set the network to Private).");
    // In place of that note and the Google Cast one when neither finds any.
    out property <string> network-none-found: @tr("No AirPlay or Google Cast speakers found yet. Make sure this PC is on the same network as your speakers, and that Windows Firewall allows AudioSync on it (or set the network to Private).");
    // Under Connected Speakers while no Google Cast speaker is listed: the
    // search runs, has found nothing for 20 seconds, or couldn't start.
    public pure function cast-list(state: CastList) -> string {
        if state == CastList.searching {
            return @tr("Looking for Google Cast speakers…");
        }
        if state == CastList.none-found {
            return @tr("No Google Cast speakers found yet. Make sure this PC is on the same network as your speakers, and that Windows Firewall allows AudioSync on it (or set the network to Private).");
        }
        if state == CastList.failed {
            return @tr("AudioSync can't look for Google Cast speakers right now. Restart AudioSync to try again.");
        }
        return "";
    }
    out property <string> master-volume-title: @tr("Master Volume");
    out property <string> master-volume: @tr("Master volume");
    out property <string> dismiss-all-notices: @tr("Dismiss All");
    out property <string> notices: @tr("Notices");
    // The button on the double-audio notice that opens its guide.
    out property <string> notice-show-how: @tr("Show How");
    out property <string> notice-show-how-label: @tr("Show how to hear it only once");
    // The button on the notice that AirPlay stopped: starts it again.
    out property <string> notice-retry: @tr("Retry");
    out property <string> notice-retry-label: @tr("Retry starting AirPlay");
    out property <string> notice-open-privacy: @tr("Open Privacy Settings");
    out property <string> notice-open-privacy-label: @tr("Open the microphone privacy settings");
    out property <string> delay-field-label: @tr("Delay in milliseconds");
    // Under a delay field while it holds typing not yet applied; also the
