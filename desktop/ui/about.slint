// The About dialog, opened from About AudioSync in the gear menu. OK or Escape closes
// it.
//
// It names AudioSync's copyright holder and license (GPL-3.0 for the built exe,
// no warranty), and credits Slint with its AboutSlint widget. Keep both.
// On Windows it also credits VB-CABLE with the two sentences its licence asks
// for, word for word (docs/WINDOWS_SILENT_OUTPUT_SPEC.md VC22).

import { AboutSlint, VerticalBox } from "std-widgets.slint";
import { Tokens } from "tokens.slint";
import { Strings } from "strings.slint";
import { DialogButton, Fluent, LinkButton } from "widgets.slint";

export component AboutDialog inherits Dialog {
    in property <string> version;
    // Windows only: the VB-CABLE credit under Slint's.
    in property <bool> vb-cable-credit;

    title: Strings.menu-about;
    icon: @image-url("../res/audiosync-tile-256.png");
    // The Mac's standard About panel grey (#EFEEED in its photo).
    background: Tokens.settings-window;
    preferred-width: 360px;
    default-font-family: Fluent.font;
    default-font-weight: Fluent.weight-regular;
    // Key events go to the focused item, so Escape needs the scope focused.
    forward-focus: keys;

    // OK or Escape.
    callback closed();
    // The VB-CABLE credit's link.
    callback vendor-page-requested();
    // Ctrl+Q, the gear's Exit, from this window.
    callback exit-requested();
    // The app's menu keys from this window, as the Settings window takes them.
    callback help-requested();
    callback new-zone-requested();
    callback refresh-devices();
    callback settings-requested();
    callback equalizer-requested();
    callback main-window-requested();
    callback preset-shortcut(int);

    // Called each time the dialog opens, so Escape works before anything
    // inside is clicked.
    public function take-focus() {
        keys.focus();
    }

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape || (event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta && event.text.to-lowercase() == "w") || event.text == Key.Return {
                root.closed();
                return accept;
            }
            if event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta && event.text.to-lowercase() == "q" {
                root.exit-requested();
                return accept;
            }
            if event.text == Key.F1 && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta {
                root.help-requested();
                return accept;
            }
            if event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta && event.text.to-lowercase() == "n" {
                root.new-zone-requested();
                return accept;
            }
            if (event.text == Key.F5 && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta) || (event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta && event.text.to-lowercase() == "r") {
                root.refresh-devices();
                return accept;
            }
            if event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta && event.text == "," {
                root.settings-requested();
                return accept;
            }
            if event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta && event.text.to-lowercase() == "e" {
                root.equalizer-requested();
                return accept;
            }
            if event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta && event.text == "0" {
                root.main-window-requested();
                return accept;
            }
            if event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta && event.text.character-count == 1 && event.text.is-float() && event.text.to-float() >= 1 {
                root.preset-shortcut(event.text.to-float());
                return accept;
            }
            return reject;
        }

        VerticalBox {
            alignment: start;

            HorizontalLayout {
                alignment: center;
                padding-top: 8px;

                // As the Mac's standard About panel: the app icon, then the name.
                Image {
                    source: @image-url("../res/audiosync-tile-256.png");
                    width: 48px;
                    height: 48px;
                    accessible-role: none;
                }
            }

            Text {
                text: Strings.app-name;
                font-weight: 700;
                // The Mac panel's name, as measured on two of its photos (74 px wide at 1x).
                font-size: 14px;
                color: Tokens.text;
                horizontal-alignment: center;
            }

            Text {
                text: Strings.version(root.version);
                // The license's size, as in the Mac photos.
                font-size: Tokens.font-size-subheadline;
                color: Tokens.text;
                horizontal-alignment: center;
            }

            Text {
                text: Strings.about-license;
                // smallSystemFontSize, as AboutPanel.swift:30.
                font-size: Tokens.font-size-subheadline;
                color: Tokens.secondary-text;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Text {
                text: Strings.about-copyright;
                font-size: Tokens.font-size-caption;
                // The Mac panel sets its copyright in the label color, not grey.
                color: Tokens.text;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            // The badge at its smallest height, its width kept to the
            // badge's own proportions (212 by 97) so it isn't stretched.
            HorizontalLayout {
                alignment: center;

                AboutSlint {
                    width: 129px;
                    height: self.min-height;
                }
            }

            if root.vb-cable-credit: VerticalLayout {
                spacing: 2px;

                HorizontalLayout {
                    alignment: center;

                    LinkButton {
                        text: Strings.silent-output-origin;
                        label: Strings.silent-output-credit-label;
                        text-color: Tokens.text;
                        clicked => {
                            root.vendor-page-requested();
                        }
                    }
                }

                Text {
                    text: Strings.silent-output-donation;
                    font-size: Tokens.font-size-caption;
                    color: Tokens.secondary-text;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
    }

    DialogButton {
        text: Strings.ok;
        primary: true;
        dialog-button-role: accept;
        clicked => {
            root.closed();
        }
        escape-pressed => {
            root.closed();
        }
    }
}
