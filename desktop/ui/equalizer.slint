// The equalizer window: on/off, the curve picker (presets, then saved
// curves), the preamp and ten bands (32 Hz to 16 kHz, ±12 dB in 0.5 dB
// steps), saving curves, and Reset. Opened with Ctrl+E or from the
// Equalizer card.

import { Button, Palette } from "std-widgets.slint";
import { Tokens } from "tokens.slint";
import { Strings } from "strings.slint";
import { FocusRing, Fluent, Glyph, Glyphs, MenuDivider, MenuPanel, MenuRepaint, MenuRoom, MenuRow, MenuState, NameField, LevelSlider, QuietText, SecondaryText, TextField, ToggleSwitch } from "widgets.slint";

// One vertical gain slider with its value above and its label below.
component Band inherits VerticalLayout {
    in property <float> gain;
    in property <string> short-label;
    in property <string> name;
    in property <float> max-gain;
    in property <bool> faded;
    callback changed(float);
    // Where the press put the band (its first change since the last
    // release): a release at another gain ends a drag, not a click.
    property <float> press-gain;
    property <bool> press-gain-set;

    spacing: 8px;
    // A drag replaces the slider's binding; keep it in step with the model.
    changed gain => {
        slider.value = root.gain;
    }

    QuietText {
        text: Strings.equalizer-gain(slider.value);
        horizontal-alignment: center;
        wrap: no-wrap;
    }

    // Left and Right move the band as Up and Down do, as on the Mac.
    FocusScope {
        vertical-stretch: 1;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        // Home, End, Page Up and Page Down would throw the band far in one
        // key; the Mac's band ignores them.
        capture-key-pressed(event) => {
            event.text == Key.Home || event.text == Key.End || event.text == Key.PageUp || event.text == Key.PageDown ? accept : reject
        }
        key-pressed(event) => {
            if event.modifiers.control || event.modifiers.alt || event.modifiers.shift || event.modifiers.meta
                || (event.text != Key.LeftArrow && event.text != Key.RightArrow) {
                return reject;
            }
            slider.value = clamp(slider.value + (event.text == Key.RightArrow ? 0.5 : -0.5), -root.max-gain, root.max-gain);
            root.changed(round(slider.value * 2) / 2);
            accept
        }
        // Key releases stop here, so the slider's `released` means a click.
        capture-key-released(event) => {
            root.press-gain-set = false;
            accept
        }

        HorizontalLayout {
            alignment: center;

            // The style's slider fills from -12 dB, so it only takes input; the track
            // is drawn here, filled from 0 dB with a 0 dB tick, as on the Mac.
            track := Rectangle {
                // Where the style's slider centers its 20 px thumb.
                property <length> thumb-y: 10px + (self.height - 20px) * (root.max-gain - slider.value) / (2 * root.max-gain);
                property <length> zero-y: round(self.height / 2 / 1px) * 1px;
                width: 32px;
                height: 140px;

                // Only these fade with the equalizer off; the focus ring keeps its contrast.
                Rectangle {
                    width: parent.width;
                    height: parent.height;
                    opacity: root.faded ? Tokens.disabled-opacity : 1;

                    Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: 10px;
                        width: 4px;
                        height: parent.height - 20px;
                        border-radius: 2px;
                        background: Palette.border;
                    }

                    Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: min(track.zero-y, track.thumb-y);
                        width: 4px;
                        height: abs(track.thumb-y - track.zero-y);
                        background: Palette.accent-background;
                    }

                    Rectangle {
                        x: 0;
                        y: track.zero-y;
                        width: parent.width;
                        height: 1px;
                        background: Tokens.text;
                    }

                    // Fluent's thumb: its dot grows under the pointer and shrinks while the band has the focus.
                    Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: track.thumb-y - 10px;
                        width: 20px;
                        height: 20px;
                        border-radius: 10px;
                        background: Fluent.thumb;
                        border-width: 1px;
                        border-color: Fluent.thumb-edge;

                        Rectangle {
                            width: slider.has-focus ? 10px : hover.has-hover ? 14px : 12px;
                            height: self.width;
                            border-radius: self.width / 2;
                            background: slider.has-focus ? Palette.accent-background.with-alpha(0.8) : hover.has-hover ? Palette.accent-background.with-alpha(0.9) : Palette.accent-background;
                            animate background, width { duration: 150ms; }
                        }
                    }
                }

                // Tells the thumb the pointer is over the band; the slider still takes the press.
                hover := TouchArea {
                    x: (parent.width - self.width) / 2;
                    width: 20px;
                    height: parent.height;

                    slider := LevelSlider {
                        width: parent.width;
                        height: parent.height;
                        orientation: vertical;
                        minimum: -root.max-gain;
                        maximum: root.max-gain;
                        step: 0.5;
                        value: root.gain;
                        opacity: 0;
                        accessible-label: root.name;
                        accessible-value: Strings.equalizer-gain-value(self.value);
                        changed(value) => {
                            if !root.press-gain-set {
                                root.press-gain-set = true;
                                root.press-gain = round(value * 2) / 2;
                            }
                            // The keyboard and the pointer both land on 0.5 dB steps;
                            // a drag isn't snapped to `step`, so the knob, number and
                            // Narrator follow the step too.
                            self.value = round(value * 2) / 2;
                            root.changed(self.value);
                        }
                        // Two clicks within the system's double-click time set 0 dB, as on the Mac.
                        released => {
                            if root.press-gain-set && round(self.value * 2) / 2 != root.press-gain {
                                second-click.running = false;
                            } else if second-click.running {
                                second-click.running = false;
                                self.value = 0;
                                root.changed(0);
                            } else {
                                second-click.running = true;
                            }
                            root.press-gain-set = false;
                        }
                    }
                }

                FocusRing {
                    x: hover.x - 3px;
                    y: -3px;
                    width: hover.width + 6px;
                    height: parent.height + 6px;
                    border-radius: Fluent.radius-control;
                    visible-focus: slider.has-focus;
                }
            }
        }

        second-click := Timer {
            interval: NameField.double-click;
            running: false;
            triggered => {
                self.running = false;
            }
        }
    }

    QuietText {
        text: root.short-label;
        horizontal-alignment: center;
        wrap: no-wrap;
    }
}

// The curve menu, as the Mac's: the presets, the saved curves, then Save
// Curve… and, while a saved curve shows, Rename and Delete it.
component CurveMenu inherits Rectangle {
    // The presets, then the saved curves.
    in property <[string]> names;
    in property <int> preset-count;
    // -1 while no curve matches: the button then reads Custom.
    in property <int> current;
    in property <bool> saved-shown;
    // The curve name dialog is open: the curve actions wait for it.
    in property <bool> naming;
    callback selected(int);
    callback save();
    callback rename();
    callback delete();
    property <string> shown: root.current >= 0 && root.current < root.names.length ? root.names[root.current] : Strings.equalizer-custom;
    property <string> saved-name: root.saved-shown ? root.shown : "";

    property <int> menu-serial;

    function open-menu() {
        if MenuState.open != 0 && MenuState.open == root.menu-serial {
            menu.close();
            MenuState.open = 0;
            return;
        }
        // A closing menu gives the focus back to what had it, which is also
        // how it tells it closed; with nothing focused it couldn't.
        focus.focus();
        root.menu-serial = MenuState.claim();
        menu.show();
    }

    min-height: 32px;
    border-radius: Fluent.radius-control;
    border-width: 1px;
    border-color: Fluent.stroke;
    background: touch.pressed ? Tokens.surface.mix(Tokens.text, 0.96) : touch.has-hover ? Tokens.surface.mix(Tokens.text, 0.98) : Tokens.surface;
    forward-focus: focus;
    accessible-role: combobox;
    accessible-label: Strings.equalizer-curve;
    accessible-value: root.shown;
    accessible-action-default => {
        root.open-menu();
    }

    touch := TouchArea {
        clicked => {
            root.open-menu();
        }

        focus := FocusScope {
            focus-on-click: false;
            key-pressed(event) => {
                if event.text == " " || event.text == Key.Return || event.text == Key.DownArrow {
                    root.open-menu();
                    return accept;
                }
                return reject;
            }

            HorizontalLayout {
                padding-left: 11px;
                padding-right: 11px;
                spacing: 8px;

                Text {
                    text: root.shown;
                    color: Tokens.text;
                    overflow: elide;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    accessible-role: none;
                }

                Glyph {
                    glyph: Glyphs.chevron-down;
                    font-size: 10px;
                    color: Tokens.secondary-text;
                }
            }
        }
    }

    FocusRing {
        visible-focus: focus.has-focus;
        border-radius: root.border-radius;
    }

    menu := PopupWindow {
        x: -MenuRoom.margin;
        y: root.height + 4px - MenuRoom.margin;
        width: max(root.width + 2 * MenuRoom.margin, 240px + 2 * MenuRoom.margin, panel.preferred-width);
        close-policy: close-on-click-outside;

        panel := MenuPanel {
            count: root.names.length + (root.saved-shown ? 3 : 1);
            close-requested => {
                menu.close();
            }

            for i in root.preset-count: MenuRow {
                index: i;
                text: root.names[i];
                current <=> panel.current;
                keyboard <=> panel.keyboard;
                pulse: panel.pulse;
                done <=> panel.done;
                activated => {
                    root.selected(i);
                }
            }

            if root.names.length > root.preset-count: MenuDivider { }

            for i in root.names.length - root.preset-count: MenuRow {
                index: root.preset-count + i;
                text: root.names[root.preset-count + i];
                current <=> panel.current;
                keyboard <=> panel.keyboard;
                pulse: panel.pulse;
                done <=> panel.done;
                activated => {
                    root.selected(root.preset-count + i);
                }
            }

            MenuDivider { }

            MenuRow {
                index: root.names.length;
                text: Strings.equalizer-save-curve;
                check-column: true;
                enabled: !root.naming;
                step: panel.step;
                count: panel.count;
                current <=> panel.current;
                keyboard <=> panel.keyboard;
                pulse: panel.pulse;
                done <=> panel.done;
                activated => {
                    menu.close();
                    root.save();
                }
            }

            if root.saved-shown: MenuRow {
                index: root.names.length + 1;
                text: Strings.equalizer-rename-curve(root.saved-name);
                check-column: true;
                enabled: !root.naming;
                step: panel.step;
                count: panel.count;
                current <=> panel.current;
                keyboard <=> panel.keyboard;
                pulse: panel.pulse;
                done <=> panel.done;
                activated => {
                    root.rename();
                    menu.close();
                }
            }

            if root.saved-shown: MenuRow {
                index: root.names.length + 2;
                text: Strings.equalizer-delete-curve(root.saved-name);
                check-column: true;
                enabled: !root.naming;
                step: panel.step;
                count: panel.count;
                current <=> panel.current;
                keyboard <=> panel.keyboard;
                pulse: panel.pulse;
                done <=> panel.done;
                activated => {
                    root.delete();
                }
            }
        }
    }
}

export component EqualizerWindow inherits Window {
    in property <bool> enabled;
    in property <float> preamp;
    in property <[float]> gains;
    in property <[float]> band-hz;
    in property <float> max-gain: 12;
    // The presets, then the saved curves.
    in property <[string]> preset-names;
    in property <int> preset-count;
    // -1 while no curve matches: the picker then shows "Custom", which is
    // not an entry.
    in property <int> preset-index;
    // Whether the picker shows a saved curve, which Rename and Delete act on.
    in property <bool> saved-curve-shown;
    // The curve name dialog doesn't block this window, so its buttons wait
    // for it.
    in property <bool> name-dialog-open;
    // The entry the picker shows (tests read it).
    out property <int> picker-shown-index: root.preset-index;
    // Save Curve… names the curve in a field in place of the menu;
    // the suggestion is its placeholder.
    in-out property <bool> naming-curve;
    in property <string> curve-suggestion;
    callback enabled-toggled(bool);
    callback preamp-changed(float);
    callback gain-changed(int, float);
    callback preset-selected(int);
    callback save-curve();
    // What was typed, and whether Return ended it rather than the focus leaving.
    callback curve-named(string, bool);
    callback rename-curve();
    callback delete-curve();
    callback reset();
    callback close-requested();
    // Ctrl+Q, the gear's Exit, from this window.
    callback exit-requested();
    // Ctrl+1 to Ctrl+9: recall the preset in that place (spec S261).
    callback preset-shortcut(int);
    // F1, Ctrl+N and F5: the main window's menu items of those shortcuts.
    callback help-requested();
    callback new-zone-requested();
    callback refresh-devices();
    // Ctrl+, Ctrl+E and Ctrl+0: Settings, the Equalizer and the main window.
    callback settings-requested();
    callback equalizer-requested();
    callback main-window-requested();

    title: Strings.equalizer-title;
    icon: @image-url("../res/audiosync-256.png");
    background: Tokens.background;
    min-width: 520px;
    max-width: 520px;
    // Fixed in size, as on the Mac.
    min-height: content.preferred-height;
    max-height: content.preferred-height;
    default-font-family: Fluent.font;
    default-font-weight: Fluent.weight-regular;
    default-font-size: Tokens.font-size-body;
    // Key events go to the focused item, so Escape needs the scope focused.
    forward-focus: keys;

    // Called each time the window opens, so Escape works before anything
    // inside is clicked.
    public function take-focus() {
        root.naming-curve = false;
        keys.focus();
    }

    changed enabled => {
        power.checked = root.enabled;
    }

    MenuRepaint { }

    keys := FocusScope {
        key-pressed(event) => {
            // Escape drops the curve name, even before the field has the focus.
            if event.text == Key.Escape && root.naming-curve {
                root.naming-curve = false;
                return accept;
            }
            if event.text == Key.Escape || (event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta && event.text.to-lowercase() == "w") {
                root.close-requested();
                return accept;
            }
            if event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta && event.text.to-lowercase() == "q" {
                root.exit-requested();
                return accept;
            }
            if event.text == Key.F1 && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta {
                root.help-requested();
                return accept;
            }
            if event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta && event.text.to-lowercase() == "n" {
                root.new-zone-requested();
                return accept;
            }
            if (event.text == Key.F5 && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta) || (event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta && event.text.to-lowercase() == "r") {
                root.refresh-devices();
                return accept;
            }
            if event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta && event.text == "," {
                root.settings-requested();
                return accept;
            }
            if event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta && event.text.to-lowercase() == "e" {
                root.equalizer-requested();
                return accept;
            }
            if event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta && event.text == "0" {
                root.main-window-requested();
                return accept;
            }
            if event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta && event.text.character-count == 1 && event.text.is-float() && event.text.to-float() >= 1 {
                root.preset-shortcut(event.text.to-float());
                return accept;
            }
            return reject;
        }

        content := VerticalLayout {
            padding: 18px;
            spacing: 14px;

            HorizontalLayout {
                spacing: 12px;

                VerticalLayout {
                    alignment: center;
                    power := ToggleSwitch {
                        text: Strings.equalizer-title;
                        headline: true;
                        checked: root.enabled;
                        accessible-label: Strings.equalizer-title;
                        toggled => {
                            root.enabled-toggled(self.checked);
                            self.checked = root.enabled;
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                if root.naming-curve: TextField {
                    width: 220px;
                    placeholder-text: root.curve-suggestion;
                    accessible-label: Strings.curve-name-field-label;
                    accessible-description: Strings.save-curve-message;
                    init => {
                        self.focus();
                    }
                    accepted(text) => {
                        root.curve-named(text, true);
                    }
                    changed has-focus => {
                        if !self.has-focus && root.naming-curve {
                            root.curve-named(self.text, false);
                        }
                    }
                }

                if !root.naming-curve: Text {
                    text: Strings.equalizer-curve;
                    color: Tokens.text;
                    vertical-alignment: center;
                    accessible-role: none;
                }

                if !root.naming-curve: presets := CurveMenu {
                    width: 170px;
                    names: root.preset-names;
                    preset-count: root.preset-count;
                    current: root.preset-index;
                    saved-shown: root.saved-curve-shown;
                    naming: root.name-dialog-open;
                    selected(index) => {
                        root.preset-selected(index);
                    }
                    save => {
                        root.save-curve();
                    }
                    rename => {
                        root.rename-curve();
                    }
                    delete => {
                        root.delete-curve();
                    }
                }
            }

            // The bands evenly spread; the preamp apart on the left.
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 6px;

                Band {
                    horizontal-stretch: 1;
                    gain: root.preamp;
                    short-label: Strings.equalizer-preamp;
                    name: Strings.equalizer-preamp-accessibility;
                    max-gain: root.max-gain;
                    faded: !root.enabled;
                    changed(value) => {
                        root.preamp-changed(value);
                    }
                }

                HorizontalLayout {
                    padding-top: 8px;
                    padding-bottom: 8px;
                    Rectangle {
                        width: 1px;
                        background: Fluent.stroke;
                    }
                }

                for gain[index] in root.gains: Band {
                    horizontal-stretch: 1;
                    gain: gain;
                    short-label: Strings.equalizer-band-short(root.band-hz[index]);
                    name: Strings.equalizer-band-name(root.band-hz[index]);
                    max-gain: root.max-gain;
                    faded: !root.enabled;
                    changed(value) => {
                        root.gain-changed(index, value);
                    }
                }
            }

            HorizontalLayout {
                spacing: 12px;

                SecondaryText {
                    text: Strings.equalizer-caption(root.max-gain);
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Button {
                    text: Strings.equalizer-reset;
                    accessible-label: Strings.equalizer-reset;
                    clicked => {
                        root.reset();
                    }
                }
            }
        }
    }
}
