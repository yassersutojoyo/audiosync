// The equalizer window: on/off, the curve picker (presets, then saved
// curves), the preamp and ten bands (32 Hz to 16 kHz, ±12 dB in 0.5 dB
// steps), saving curves, and Reset. Opened with Ctrl+E or from the
// Equalizer card.

import { Button, ComboBox, Slider } from "std-widgets.slint";
import { Tokens } from "tokens.slint";
import { Strings } from "strings.slint";
import { Card, Fluent, QuietText, SecondaryText, ToggleSwitch } from "widgets.slint";

// One vertical gain slider with its value above and its label below.
component Band inherits VerticalLayout {
    in property <float> gain;
    in property <string> short-label;
    in property <string> name;
    in property <float> max-gain;
    // The equalizer is off: the slider fades, its text stays readable.
    in property <bool> dimmed;
    callback changed(float);

    spacing: 8px;
    // A drag replaces the slider's binding; keep it in step with the model.
    changed gain => {
        slider.value = root.gain;
    }

    QuietText {
        text: Strings.equalizer-gain(slider.value);
        horizontal-alignment: center;
        wrap: no-wrap;
    }

    HorizontalLayout {
        vertical-stretch: 1;
        alignment: center;
        opacity: root.dimmed ? Tokens.disabled-opacity : 1;
        animate opacity { duration: Fluent.normal; }
        slider := Slider {
            orientation: vertical;
            min-height: 140px;
            vertical-stretch: 1;
            minimum: -root.max-gain;
            maximum: root.max-gain;
            step: 0.5;
            value: root.gain;
            accessible-label: root.name;
            accessible-value: Strings.equalizer-gain-value(self.value);
            changed(value) => {
                // The keyboard and the pointer both land on 0.5 dB steps.
                root.changed(round(value * 2) / 2);
            }
        }
    }

    QuietText {
        text: root.short-label;
        horizontal-alignment: center;
        wrap: no-wrap;
    }
}

export component EqualizerWindow inherits Window {
    in property <bool> enabled;
    in property <float> preamp;
    in property <[float]> gains;
    in property <[float]> band-hz;
    in property <float> max-gain: 12;
    // The presets, then the saved curves.
    in property <[string]> preset-names;
    // -1 while no curve matches: the picker then shows "Custom", which is
    // not an entry.
    in property <int> preset-index;
    // Whether the picker shows a saved curve, which Rename and Delete act on.
    in property <bool> saved-curve-shown;
    // The entry the picker shows (tests read it).
    out property <int> picker-shown-index: presets.current-index;
    callback enabled-toggled(bool);
    callback preamp-changed(float);
    callback gain-changed(int, float);
    callback preset-selected(int);
    callback save-curve();
    callback rename-curve();
    callback delete-curve();
    callback reset();
    callback close-requested();
    // Ctrl+Q, File > Exit from this window.
    callback exit-requested();
    // Ctrl+1 to Ctrl+9: recall the preset in that place (spec S261).
    callback preset-shortcut(int);

    title: Strings.equalizer-title;
    icon: @image-url("../res/audiosync-256.png");
    background: Tokens.background;
    min-width: 600px;
    preferred-width: 660px;
    min-height: 360px;
    default-font-family: Fluent.font;
    default-font-size: Tokens.font-size-body;
    // Key events go to the focused item, so Escape needs the scope focused.
    forward-focus: keys;

    // Called each time the window opens, so Escape works before anything
    // inside is clicked.
    public function take-focus() {
        keys.focus();
    }

    changed enabled => {
        power.checked = root.enabled;
    }
    changed preset-index => {
        presets.current-index = root.preset-index;
    }

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape || (event.modifiers.control && event.text.to-lowercase() == "w") {
                root.close-requested();
                return accept;
            }
            if event.modifiers.control && event.text.to-lowercase() == "q" {
                root.exit-requested();
                return accept;
            }
            if event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && event.text.character-count == 1 && event.text.is-float() && event.text.to-float() >= 1 {
                root.preset-shortcut(event.text.to-float());
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            padding: Tokens.spacing-window-margin;
            spacing: 16px;

            HorizontalLayout {
                spacing: 12px;

                VerticalLayout {
                    alignment: center;
                    power := ToggleSwitch {
                        text: Strings.equalizer-title;
                        checked: root.enabled;
                        accessible-label: Strings.equalizer-title;
                        toggled => {
                            root.enabled-toggled(self.checked);
                            self.checked = root.enabled;
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                Text {
                    text: Strings.equalizer-curve;
                    color: Tokens.text;
                    vertical-alignment: center;
                    accessible-role: none;
                }

                Rectangle {
                    width: 180px;

                    presets := ComboBox {
                        width: parent.width;
                        height: parent.height;
                        model: root.preset-names;
                        current-index: root.preset-index;
                        accessible-label: Strings.equalizer-curve;
                        accessible-placeholder-text: Strings.equalizer-custom;
                        selected => {
                            root.preset-selected(self.current-index);
                            self.current-index = root.preset-index;
                        }
                    }

                    // Where the picker's own text goes; it is empty at -1.
                    if root.preset-index < 0: Text {
                        x: 12px;
                        width: parent.width - 36px;
                        height: parent.height;
                        text: Strings.equalizer-custom;
                        color: Tokens.secondary-text;
                        vertical-alignment: center;
                        overflow: elide;
                        accessible-role: none;
                    }
                }
            }

            // The bands on a card, evenly spread; the preamp apart on the left.
            Card {
                vertical-stretch: 1;
                inner-padding: 12px;

                HorizontalLayout {
                    spacing: 2px;

                    Band {
                        horizontal-stretch: 1;
                        gain: root.preamp;
                        short-label: Strings.equalizer-preamp;
                        name: Strings.equalizer-preamp-accessibility;
                        max-gain: root.max-gain;
                        dimmed: !root.enabled;
                        changed(value) => {
                            root.preamp-changed(value);
                        }
                    }

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        Rectangle {
                            width: 1px;
                            background: Fluent.stroke;
                        }
                    }

                    for gain[index] in root.gains: Band {
                        horizontal-stretch: 1;
                        gain: gain;
                        short-label: Strings.equalizer-band-short(root.band-hz[index]);
                        name: Strings.equalizer-band-name(root.band-hz[index]);
                        max-gain: root.max-gain;
                        dimmed: !root.enabled;
                        changed(value) => {
                            root.gain-changed(index, value);
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 12px;

                SecondaryText {
                    text: Strings.equalizer-caption(root.max-gain);
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Button {
                    text: Strings.equalizer-save-curve;
                    accessible-label: Strings.equalizer-save-curve-accessibility;
                    clicked => {
                        root.save-curve();
                    }
                }

                Button {
                    text: Strings.equalizer-rename-curve;
                    accessible-label: Strings.equalizer-rename-curve-accessibility;
                    enabled: root.saved-curve-shown;
                    clicked => {
                        root.rename-curve();
                    }
                }

                Button {
                    text: Strings.equalizer-delete-curve;
                    accessible-label: Strings.equalizer-delete-curve-accessibility;
                    enabled: root.saved-curve-shown;
                    clicked => {
                        root.delete-curve();
                    }
                }

                Button {
                    text: Strings.equalizer-reset;
                    accessible-label: Strings.equalizer-reset;
                    clicked => {
                        root.reset();
                    }
                }
            }
        }
    }
}
