// File > Check Setup… (S435): what AudioSync needs from Windows, one row per
// need with its state in words and an icon, and a line under the heading that
// names the rows needing the user. The network and microphone rows change by
// themselves while it shows. Escape, Ctrl+W or Close closes it.

import { Button } from "std-widgets.slint";
import { Tokens } from "tokens.slint";
import { Strings } from "strings.slint";
import { Announcer, Fluent, Motion } from "widgets.slint";
import { SetupMicrophone, SetupNetwork } from "types.slint";

enum SetupStatus { ok, warning, blocked, info, none }

// A state's icon, 14 px, drawn so it shows off Windows too.
component StatusIcon inherits Rectangle {
    in property <SetupStatus> kind;
    in property <color> tint;

    width: 14px;
    height: 14px;

    if root.kind == SetupStatus.ok: Rectangle {
        border-radius: 7px;
        background: root.tint;
    }

    Path {
        width: 14px;
        height: 14px;
        viewbox-width: 14;
        viewbox-height: 14;
        commands: root.kind == SetupStatus.ok ? "M4 7.2 L6 9.2 L10 4.8" : root.kind == SetupStatus.warning ? "M7 1.6 L13 12.4 L1 12.4 Z M7 5.6 L7 8.6 M7 10.2 L7 10.6" : root.kind == SetupStatus.blocked ? "M1 7 A6 6 0 1 1 13 7 A6 6 0 1 1 1 7 Z M4.8 4.8 L9.2 9.2 M9.2 4.8 L4.8 9.2" : root.kind == SetupStatus.info ? "M1 7 A6 6 0 1 1 13 7 A6 6 0 1 1 1 7 Z M7 6.4 L7 10.2 M7 3.8 L7 4.2" : "M13.00 7.00 A6 6 0 0 1 12.71 8.85 M11.85 10.53 A6 6 0 0 1 10.53 11.85 M8.85 12.71 A6 6 0 0 1 7.00 13.00 M5.15 12.71 A6 6 0 0 1 3.47 11.85 M2.15 10.53 A6 6 0 0 1 1.29 8.85 M1.00 7.00 A6 6 0 0 1 1.29 5.15 M2.15 3.47 A6 6 0 0 1 3.47 2.15 M5.15 1.29 A6 6 0 0 1 7.00 1.00 M8.85 1.29 A6 6 0 0 1 10.53 2.15 M11.85 3.47 A6 6 0 0 1 12.71 5.15";
        stroke: root.kind == SetupStatus.ok ? Tokens.surface : root.tint;
        stroke-width: root.kind == SetupStatus.ok ? 1.6px : 1.4px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

// A row's state: the words carry it, the color only repeats it. One that
// replaces an earlier state (`enter`) fades in, sliding up 3 px unless
// Windows' animation effects are off.
component StatusLine inherits Rectangle {
    in property <SetupStatus> kind;
    in property <string> text;
    in property <bool> enter;
    property <color> tint: root.kind == SetupStatus.ok ? Tokens.teal-text : root.kind == SetupStatus.warning ? Tokens.warn : root.kind == SetupStatus.blocked ? Tokens.error-text : Tokens.secondary-text;
    property <float> shown: root.enter ? 0 : 1;
    property <length> lift: root.enter && Motion.on ? 3px : 0px;

    opacity: root.shown;
    init => {
        root.shown = 1;
        root.lift = 0px;
    }
    animate shown {
        duration: Motion.on ? 240ms : 150ms;
        easing: Motion.on ? cubic-bezier(0.2, 0.8, 0.2, 1) : linear;
    }
    animate lift {
        duration: 240ms;
        easing: cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    HorizontalLayout {
        y: root.lift;
        spacing: 6px;

        VerticalLayout {
            alignment: start;
            padding-top: 1px;

            StatusIcon {
                kind: root.kind;
                tint: root.tint;
            }
        }

        Text {
            horizontal-stretch: 1;
            text: root.text;
            font-size: Tokens.font-size-caption;
            color: root.tint;
            wrap: word-wrap;
            min-height: self.preferred-height;
            accessible-role: none;
        }
    }
}

// The row's highlight when it turns OK: shown at once, faded out.
component Flash inherits Rectangle {
    background: Tokens.playing-row;
    opacity: 1;
    init => {
        self.opacity = 0;
    }
    animate opacity {
        delay: Motion.on ? 275ms : 150ms;
        duration: Motion.on ? 825ms : 450ms;
        easing: ease-out;
    }
}

// One need: its icon, name, what it is for, and its state, read by Narrator
// as one line; a state the user can fix has a button for the Settings page.
component SetupRow inherits Rectangle {
    in property <string> icon;
    in property <length> icon-stroke: 1.4px;
    in property <string> title;
    in property <string> detail;
    in property <SetupStatus> kind;
    in property <string> status;
    // How often the state changed since the window opened.
    in property <int> changes;
    in property <string> action;
    in property <string> action-label;
    callback action-clicked();

    if root.changes > 0 && root.kind == SetupStatus.ok && mod(root.changes, 2) == 1: Flash {
        width: parent.width;
        height: parent.height;
    }
    if root.changes > 0 && root.kind == SetupStatus.ok && mod(root.changes, 2) == 0: Flash {
        width: parent.width;
        height: parent.height;
    }

    HorizontalLayout {
        padding-top: 14px;
        padding-bottom: 14px;
        padding-left: 16px;
        padding-right: 16px;
        spacing: 14px;

        VerticalLayout {
            alignment: start;
            padding-top: 1px;

            Path {
                width: 20px;
                height: 18px;
                viewbox-x: -1;
                viewbox-width: 20;
                viewbox-height: 18;
                commands: root.icon;
                stroke: Tokens.text;
                stroke-width: root.icon-stroke;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: start;
            spacing: 2px;
            accessible-role: text;
            accessible-label: root.status == "" ? root.title + ". " + root.detail : root.title + ". " + root.detail + " " + root.status;

            Text {
                text: root.title;
                font-weight: 600;
                color: Tokens.text;
                wrap: word-wrap;
                accessible-role: none;
            }

            Text {
                text: root.detail;
                font-size: Tokens.font-size-caption;
                color: Tokens.secondary-text;
                wrap: word-wrap;
                min-height: self.preferred-height;
                accessible-role: none;
            }

            if root.status != "": VerticalLayout {
                padding-top: 4px;

                if root.changes == 0: StatusLine {
                    kind: root.kind;
                    text: root.status;
                }
                if root.changes > 0 && mod(root.changes, 2) == 1: StatusLine {
                    kind: root.kind;
                    text: root.status;
                    enter: true;
                }
                if root.changes > 0 && mod(root.changes, 2) == 0: StatusLine {
                    kind: root.kind;
                    text: root.status;
                    enter: true;
                }
            }
        }

        if root.action != "": VerticalLayout {
            alignment: start;
            padding-left: 8px;

            Button {
                text: root.action;
                accessible-label: root.action-label;
                clicked => {
                    root.action-clicked();
                }
            }
        }
    }
}

component RowLine inherits Rectangle {
    height: 1px;
    background: Fluent.stroke;
}

export component SetupWindow inherits Window {
    in property <SetupNetwork> network;
    in property <SetupMicrophone> microphone;
    // The rows the line under the heading names (setup_check.rs, `attention`).
    in property <bool> network-needs-attention;
    in property <bool> microphone-needs-attention;
    // How often each row's state changed since the window opened.
    in property <int> network-changes;
    in property <int> microphone-changes;
    // What Narrator says without moving the focus (see Announcer).
    in property <string> announcement;

    callback open-network-settings();
    callback open-privacy-settings();
    callback close-requested();
    // Ctrl+Q, File > Exit from this window.
    callback exit-requested();

    public pure function network-status(network: SetupNetwork) -> string {
        if network == SetupNetwork.private {
            return Strings.setup-network-private;
        }
        if network == SetupNetwork.public {
            return Strings.setup-network-public;
        }
        if network == SetupNetwork.offline {
            return Strings.setup-network-offline;
        }
        return "";
    }

    public pure function microphone-status(microphone: SetupMicrophone) -> string {
        if microphone == SetupMicrophone.working {
            return Strings.setup-microphone-working;
        }
        if microphone == SetupMicrophone.blocked {
            return Strings.setup-microphone-blocked;
        }
        return Strings.setup-microphone-not-used;
    }

    title: Strings.setup-title;
    icon: @image-url("../res/audiosync-256.png");
    background: Tokens.background;
    min-width: 360px;
    preferred-width: 520px;
    default-font-family: Fluent.font;
    default-font-size: Tokens.font-size-body;
    // Key events go to the focused item, so Escape needs the scope focused.
    forward-focus: keys;

    // Called each time the window opens, so Escape works before anything
    // inside is clicked.
    public function take-focus() {
        keys.focus();
    }

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape || (event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta && event.text.to-lowercase() == "w") {
                root.close-requested();
                return accept;
            }
            if event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta && event.text.to-lowercase() == "q" {
                root.exit-requested();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            VerticalLayout {
                padding-top: 8px;
                padding-bottom: 12px;
                padding-left: 24px;
                padding-right: 24px;
                spacing: 12px;

                VerticalLayout {
                    Text {
                        text: Strings.setup-title;
                        font-family: Fluent.display-font;
                        font-size: Tokens.font-size-title2;
                        font-weight: 600;
                        color: Tokens.text;
                    }

                    Text {
                        text: Strings.setup-summary(root.network-needs-attention, root.microphone-needs-attention);
                        color: Tokens.secondary-text;
                        wrap: word-wrap;
                        min-height: self.preferred-height;
                    }
                }

                Rectangle {
                    background: Tokens.surface;
                    border-radius: Fluent.radius-card;
                    border-width: 1px;
                    border-color: Fluent.stroke;
                    clip: true;

                    VerticalLayout {
                        SetupRow {
                            icon: "M2 8 L2 10 M5 5 L5 13 M8 2.5 L8 15.5 M11 6 L11 12 M14 4 L14 14 M16.5 8 L16.5 10";
                            icon-stroke: 1.6px;
                            title: Strings.setup-capture;
                            detail: Strings.setup-capture-detail;
                            kind: SetupStatus.ok;
                            status: Strings.setup-capture-status;
                        }

                        RowLine { }

                        SetupRow {
                            icon: "M2 9 A7 7 0 1 1 16 9 A7 7 0 1 1 2 9 Z M2 9 L16 9 M9 2 C11.2 4 11.2 14 9 16 M9 2 C6.8 4 6.8 14 9 16";
                            title: Strings.setup-network;
                            detail: Strings.setup-network-detail;
                            kind: root.network == SetupNetwork.private ? SetupStatus.ok : root.network == SetupNetwork.public ? SetupStatus.warning : root.network == SetupNetwork.offline ? SetupStatus.info : SetupStatus.none;
                            status: root.network-status(root.network);
                            changes: root.network-changes;
                            action: root.network == SetupNetwork.public ? Strings.open-network-settings : "";
                            action-label: Strings.open-network-settings;
                            action-clicked => {
                                root.open-network-settings();
                            }
                        }

                        RowLine { }

                        SetupRow {
                            icon: "M9 1.8 L15 4 L15 8.6 C15 12.2 12.4 15 9 16.2 C5.6 15 3 12.2 3 8.6 L3 4 Z";
                            title: Strings.setup-firewall;
                            detail: Strings.setup-firewall-detail;
                            kind: SetupStatus.info;
                            status: Strings.setup-firewall-status;
                        }

                        RowLine { }

                        SetupRow {
                            icon: "M6.2 4.6 A2.8 2.8 0 0 1 11.8 4.6 L11.8 8 A2.8 2.8 0 0 1 6.2 8 Z M3.6 8.6 A5.4 5.4 0 0 0 14.4 8.6 M9 14 L9 16.4";
                            title: Strings.setup-microphone;
                            detail: Strings.setup-microphone-detail;
                            kind: root.microphone == SetupMicrophone.working ? SetupStatus.ok : root.microphone == SetupMicrophone.blocked ? SetupStatus.blocked : SetupStatus.none;
                            status: root.microphone-status(root.microphone);
                            changes: root.microphone-changes;
                            action: root.microphone == SetupMicrophone.blocked ? Strings.notice-open-privacy : "";
                            action-label: Strings.notice-open-privacy-label;
                            action-clicked => {
                                root.open-privacy-settings();
                            }
                        }
                    }
                }
            }

            RowLine { }

            Rectangle {
                background: Tokens.surface;

                HorizontalLayout {
                    padding: 20px;
                    padding-left: 24px;
                    padding-right: 24px;
                    alignment: end;

                    Button {
                        text: Strings.setup-close;
                        primary: true;
                        accessible-label: Strings.setup-close;
                        clicked => {
                            root.close-requested();
                        }
                    }
                }
            }
        }
    }

    Announcer {
        said: root.announcement;
    }
}
