// The data the Rust side passes to the windows (see src/view.rs).

// How a speaker row or zone header shows: playing only while streaming is
// on. A speaker that is on while streaming is on but can't play right now
// waits for its device (another app holds it), is reconnecting (AirPlay) or
// waits for the one AirPlay 2 slot; a zone waits when every member it
// switches on does.
export enum RowState { off, will-play, playing, waiting-for-device, reconnecting, waiting-for-airplay2 }

// The part of a speaker row or zone header that has, or is to take, the keyboard
// focus: its toggle, delay button, volume, sync controls, options or name
// field. A row rebuilt under the focus takes it back on the same part.
export enum RowPart { none, toggle, delay, volume, sync, options, name }

// A main-window control outside the notices, the speaker rows and the zone headers;
// one taking the focus applies an open speaker rename.
export enum MainControl { power, source, input-pair, transport, master-volume, equalizer, calibration, airplay-delay }

// The kind of output: the icon in a speaker's toggle, and the line under a
// connected speaker's name.
export enum SpeakerKind { airplay, airplay2, cast, built-in, headphones, bluetooth, usb, usb-headphones, usb-speakers, hdmi, display-port, virtual, other }

// An AirPlay row that plays a stereo pair or a home theater group (an Apple
// TV's speakers) as one speaker; none for any other row.
export enum SpeakerGroup { none, stereo-pair, home-theater }

// Where a Google Cast speaker that is on is: idle while streaming is off.
export enum CastState { idle, connecting, playing, reconnecting }

// What went wrong with a Google Cast speaker, for its notice.
export enum CastProblem { busy, not-responding, refused, blocked, taken-over, connection-lost }

// The speaker list's note about Google Cast while none is listed.
export enum CastList { quiet, searching, none-found, failed }

// Whether an AirPlay speaker can simply play.
export enum Availability { open, needs-code, pairing, waiting-to-pair, pairing-not-yet, airplay2-not-yet, airplay2-next-launch, unsupported }

// What went wrong with an AirPlay speaker, for its notice.
export enum AirPlayProblem { not-responding, connection-lost, busy, refused, needs-password, needs-pin, pairing-failed, pairing-not-yet, airplay2-not-yet, timing-unavailable, one-airplay2-speaker, plays-through-speakers, receiver-unverified, apple-tv-plays, plays-in-group, unsupported }

// View > Appearance: as Windows is set, or always light or dark.
export enum Appearance { system, light, dark }

// Where the PIN dialog of an Apple TV pairing is.
export enum PinPhase { starting, ready, checking }

// What a switched-on local output's own volume in Windows calls for: none,
// or the hint under its volume slider (low, muted, or both).
export enum DeviceVolumeHint { none, low, muted, muted-low }

// An app of the several-apps list under the source menu.
export struct MixAppItem {
    name: string,
    // Checked in the mode the list shows.
    checked: bool,
}

// An output that is on but left out of Calibrate All by its kind.
export struct LeftOutItem {
    name: string,
    // Why it is left out, or that it is included anyway.
    reason: string,
    // What Include Anyway is for, by its kind.
    help: string,
    // Include Anyway was chosen: the button reads Leave Out.
    included: bool,
}

// A row of the Calibrate All Speakers results.
export struct CalibrationRowItem {
    name: string,
    // Its old and new delay, or why it has none.
    detail: string,
    // Measure Again can run for it.
    can-measure-again: bool,
}

// A speaker preset in the Presets card, View > Presets and the flyout.
export struct PresetItem {
    id: string,
    name: string,
    // It plays exactly now (spec S264).
    current: bool,
}

// An entry of Speakers > Hidden Speakers.
export struct HiddenItem {
    id: string,
    name: string,
    // The kind its row shows (Strings.speaker-kind); empty when unknown.
    kind: string,
    // Listed now, only hidden; else it reads "not found".
    present: bool,
}

export struct SpeakerItem {
    id: string,
    // The name the user gave it, else the one its device reports.
    name: string,
    // The name its device reports, while renamed; empty otherwise.
    system-name: string,
    // The device's own name, always: the name field's placeholder.
    device-name: string,
    // Its name is being edited in the row, with `name-text` typed so far.
    renaming: bool,
    name-text: string,
    kind: SpeakerKind,
    // Connected speakers show their kind; the PC's own outputs don't.
    show-kind: bool,
    state: RowState,
    volume: float,
    // Local outputs have a sync delay, an offset relative to the reference
    // output; the reference has none, and neither do AirPlay speakers (local
    // outputs line up with them instead).
    has-delay: bool,
    delay-ms: int,
    // What the delay field shows: the applied value, or what is being typed.
    delay-text: string,
    // The delay field holds typing not yet applied (Enter applies it).
    delay-pending: bool,
    // While the field holds a number out of range: the range and what Enter
    // applies, with a red outline on the field; empty otherwise.
    delay-range-hint: string,
    // The reference output's name for the sync hint; empty without one.
    reference-name: string,
    sync-open: bool,
    // A local output other than the reference: its sync controls offer
    // Calibrate with Microphone.
    calibratable: bool,
    // Its calibration runs: the button cancels it.
    calibrating: bool,
    // The button may start a calibration: streaming, this speaker on, a
    // reference listed, and no other calibration running.
    calibration-enabled: bool,
    // Under the button: what a running calibration does, how the last one
    // ended, or why none can start; empty otherwise.
    calibration-status: string,
    // The last calibration found the microphone blocked: Open Privacy
    // Settings goes next to the button.
    calibration-privacy: bool,
    // Why microphone calibration leaves it out (headphones, a virtual
    // output), shown instead of Calibrate with Microphone; empty otherwise.
    calibration-left-out: string,
    auto-connect: bool,
    availability: Availability,
    // An Apple TV AudioSync keeps pairing credentials for: its menu offers
    // Forget Pairing.
    paired: bool,
    // An AirPlay speaker whose password AudioSync holds until it quits:
    // its menu offers Forget Password.
    holds-password: bool,
    // An AirPlay speaker that asks for a code every time it connects:
    // auto-connect leaves it off, and its note says so.
    code-every-time: bool,
    // The output's own volume in Windows, when it is low or muted, and its
    // whole percent.
    device-volume: DeviceVolumeHint,
    device-volume-percent: int,
    // A Google Cast speaker: its delay is the offset the user measured, and
    // while it connects or plays it offers Mute and Resync.
    cast: bool,
    cast-state: CastState,
    // The Cast speaker reports itself muted.
    muted: bool,
    // The Cast speaker's volume can't be changed from here.
    volume-fixed: bool,
    // How far the arrow keys move the volume: the Cast device's own step,
    // 1 for every other row.
    volume-step: float,
    // A Google Cast group, and the note under its name
    // (Strings.cast-group-note); empty for any other row.
    cast-group: bool,
    cast-group-note: string,
    // A Google Cast speaker the user added by address: its note says so,
    // and its menu has Remove.
    cast-added-by-address: bool,
    // Its menu ends with Hide Speaker: every row but the reference output's.
    hideable: bool,
    // A stereo pair or home theater group: what it is and its members, or
    // which member is missing (Strings.group-note); empty for any other row.
    group-note: string,
    // The zone that holds it, by ID; empty when it is in none.
    zone-id: string,
    // Its menu offers Move to Zone and Remove from Zone: every row but one
    // that plays as part of a stereo pair or home theater.
    zone-movable: bool,
    // In a zone: what its row says in place of its own note (it plays as
    // part of a stereo pair, needs AirPlay 2, isn't found, stayed off);
    // empty otherwise.
    zone-note: string,
    // In a zone, a row that doesn't play by itself: its name is dimmed.
    zone-dimmed: bool,
    // A zone member that isn't listed: only its menu does anything.
    missing: bool,
}

// A zone member that plays as part of a stereo pair or home theater: the
// zone's menu offers Use <target> Instead.
export struct ZoneTarget {
    member-id: string,
    target: string,
}

// A zone: its header and its members' rows. Hidden members are left out
// of `total` and get no row; `present` counts the members listed now, `on`
// those switched on and `waiting` those on that can't play right now.
export struct ZoneItem {
    id: string,
    name: string,
    state: RowState,
    on: int,
    total: int,
    waiting: int,
    present: int,
    volume: float,
    expanded: bool,
    members: [SpeakerItem],
    targets: [ZoneTarget],
    // Calibrate Zone… can be chosen: a member is here and no calibration
    // holds the outputs.
    can-calibrate: bool,
}

// What a notice is about, for its short name (Strings.notice-title).
export enum NoticeKind { no-speaker, source-quit, source-switched, source-not-running, source-refused, input-not-connected, input-disconnected, microphone-blocked, capture-failed, capture-lost, speaker-failed, speaker-lost, speaker-busy, pair-first, airplay-retrying, airplay-waiting, airplay-cant-play, airplay-stopped, airplay-ptp-ports-taken, settings-not-saved, pairings-not-saved, settings-kept-aside, pairings-kept-aside, no-sound-output, heard-twice, launch-at-login-failed, launch-at-login-not-removed, launch-at-login-off-in-settings, cast-cant-play, airplay-ahead-of-cast, airplay2-next-launch, remote-public-network, groups-became-zones, presets-left-off }

export struct NoticeItem {
    id: int,
    message: string,
    time: string,
    // A few words that name the notice, for its dismiss button ("double
    // audio", "Kitchen reconnecting").
    title: string,
    // The notice offers Show How, which opens its guide.
    has-guide: bool,
    // The notice offers Retry, which starts AirPlay again.
    has-retry: bool,
    // The notice offers Open Privacy Settings, for microphone access.
    has-privacy: bool,
    // The notice reports a change rather than a problem: it shows the info
    // glyph in place of the warning one.
    info: bool,
}

// The Settings page a guide step opens, if any.
export enum GuidePage { none, volume-mixer, sound }

// One paragraph of the double-audio guide, with the page its button opens.
export struct GuideStepItem {
    text: string,
    page: GuidePage,
}
