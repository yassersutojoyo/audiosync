// The Guide, opened from the gear's AudioSync Guide (F1): how to use AudioSync on
// Windows, one section per topic, in the Mac Guide's order, with double
// audio (a Windows topic) last. Escape closes it; the arrow keys,
// Page Up, Page Down, Space, Home and End scroll it. Show How in the
// double-audio section shows only while that notice does, and opens the
// notice's own guide (guide.slint).

import { Button } from "std-widgets.slint";
import { Tokens } from "tokens.slint";
import { Strings } from "strings.slint";
import { FocusRing, Fluent, OverlayScrollView, SectionTitle } from "widgets.slint";

// Guide text, which can be selected so a step can be copied, as on the Mac.
// Without `min-height`, a wrapping text gets the height of one line and the
// sections overlap.
component HelpText inherits TextInput {
    read-only: true;
    single-line: false;
    wrap: word-wrap;
    min-height: self.preferred-height;
    color: Tokens.text;
}

// A list, its wrapped lines indented past the marker, as the Mac Guide sets
// its "1. " and "- " items (GuideLayout.swift:40-66).
component HelpList inherits VerticalLayout {
    in property <[string]> items;
    in property <bool> numbered;

    spacing: 6px;

    for item[i] in root.items: HorizontalLayout {
        HelpText {
            horizontal-stretch: 0;
            text: root.numbered ? (i + 1) + ". " : "- ";
        }

        HelpText {
            horizontal-stretch: 1;
            text: item;
        }
    }
}

// A heading and its text. Narrator reads the heading as the group's name,
// as for the main window's sections, so SectionTitle hides it from Narrator.
component HelpSection inherits VerticalLayout {
    in property <string> title;
    in property <string> body;

    spacing: 6px;
    accessible-role: groupbox;
    accessible-label: root.title;

    SectionTitle {
        text: root.title;
    }

    if root.body != "": HelpText {
        text: root.body;
    }

    @children
}

// An illustration from brand/guide/ (scripts/brand/guide_art.py), in the
// variant for the theme: 360 px wide at most, narrower in a narrow window,
// keeping the drawing's 440 by 160 shape.
component HelpArt inherits Rectangle {
    in property <image> light;
    in property <image> dark;
    in property <string> description;

    height: min(360px, self.width) * 160 / 440;
    accessible-role: image;
    accessible-label: root.description;

    Image {
        x: 0;
        y: 0;
        width: min(360px, root.width);
        height: root.height;
        source: Tokens.dark ? root.dark : root.light;
        image-fit: contain;
        accessible-role: none;
    }
}

export component HelpWindow inherits Window {
    // A double-audio notice is showing, so Show How has a guide to open.
    in property <bool> show-how-shown;
    // A release build that updates itself: More Controls says how.
    in property <bool> updater-available;
    private property <string> more-body: root.updater-available ? Strings.help-more + "\n\n" + Strings.help-more-updates : Strings.help-more;
    private property <string> linux-more-body: Strings.help-more-linux;
    private property <string> resume-paragraph: "\n\n" + Strings.help-more-resume-after-sleep;
    private property <string> airplay-body: Platform.os == OperatingSystemType.linux ? Strings.help-airplay-linux : Strings.help-airplay;
    private property <string> start-body: Platform.os == OperatingSystemType.linux ? Strings.help-start-linux : Strings.help-start;
    private property <string> sync-body: Strings.help-sync;
    private property <string> volume-keys: Strings.help-more-volume-keys;
    private property <string> source-quits: "\n\n" + Strings.help-more-source-quits;
    private property <string> tune-body: Strings.help-sync-tune;
    private property <string> bluetooth-body: Strings.help-bluetooth;
    // The paragraphs of a text, one list item each.
    pure callback items(string) -> [string];
    callback show-how-requested();
    callback close-requested();
    // Ctrl+Q, the gear's Exit, from this window.
    callback exit-requested();
    // Ctrl+1 to Ctrl+9: recall the preset in that place (spec S261).
    callback preset-shortcut(int);
    // F1, Ctrl+N and F5: the main window's menu items of those shortcuts.
    callback help-requested();
    callback new-zone-requested();
    callback refresh-devices();
    // Ctrl+, Ctrl+E and Ctrl+0: Settings, the Equalizer and the main window.
    callback settings-requested();
    callback equalizer-requested();
    callback main-window-requested();

    title: Strings.help-title;
    icon: @image-url("../res/audiosync-256.png");
    background: Tokens.background;
    min-width: 440px;
    min-height: 300px;
    preferred-width: 640px;
    preferred-height: 600px;
    default-font-family: Fluent.font;
    default-font-weight: Fluent.weight-regular;
    default-font-size: Tokens.font-size-body;
    // Key events go to the focused item, so Escape and the scroll keys need
    // the scope focused.
    forward-focus: keys;

    // Called each time the window opens, so the keys work before anything
    // inside is clicked.
    public function take-focus() {
        keys.focus();
    }

    // Where the Guide was scrolled when it last closed.
    public function scroll-to(offset: length) {
        scroll.content-y = -offset;
    }

    // How far the text is scrolled down, for the tests.
    out property <length> scrolled: -scroll.content-y;
    property <length> line-step: 40px;
    // Content y runs from 0 (top) down to this (bottom).
    property <length> lowest: min(0px, scroll.visible-height - scroll.content-height);

    function scroll-by(delta: length) {
        scroll.content-y = max(root.lowest, min(0px, scroll.content-y - delta));
    }

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape || (event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta && event.text.to-lowercase() == "w") {
                root.close-requested();
                return accept;
            }
            if event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta && event.text.to-lowercase() == "q" {
                root.exit-requested();
                return accept;
            }
            if event.text == Key.F1 && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta {
                root.help-requested();
                return accept;
            }
            if event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta && event.text.to-lowercase() == "n" {
                root.new-zone-requested();
                return accept;
            }
            if (event.text == Key.F5 && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta) || (event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta && event.text.to-lowercase() == "r") {
                root.refresh-devices();
                return accept;
            }
            if event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta && event.text == "," {
                root.settings-requested();
                return accept;
            }
            if event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta && event.text.to-lowercase() == "e" {
                root.equalizer-requested();
                return accept;
            }
            if event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta && event.text == "0" {
                root.main-window-requested();
                return accept;
            }
            if event.modifiers.control && !event.modifiers.alt && !event.modifiers.shift && !event.modifiers.meta && event.text.character-count == 1 && event.text.is-float() && event.text.to-float() >= 1 {
                root.preset-shortcut(event.text.to-float());
                return accept;
            }
            if event.text == Key.DownArrow {
                root.scroll-by(root.line-step);
                return accept;
            }
            if event.text == Key.UpArrow {
                root.scroll-by(-root.line-step);
                return accept;
            }
            // A focused button takes Space itself, so Space scrolls only
            // from the text.
            if event.text == Key.PageDown || event.text == Key.Space {
                root.scroll-by(max(root.line-step, scroll.visible-height - root.line-step));
                return accept;
            }
            if event.text == Key.PageUp {
                root.scroll-by(-max(root.line-step, scroll.visible-height - root.line-step));
                return accept;
            }
            if event.text == Key.Home {
                scroll.content-y = 0px;
                return accept;
            }
            if event.text == Key.End {
                scroll.content-y = root.lowest;
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            Rectangle {
                vertical-stretch: 1;

                scroll := OverlayScrollView {

                    VerticalLayout {
                        // The text wraps at the view's width instead of widening it.
                        width: scroll.visible-width;
                        padding-left: 18px;
                        padding-right: 18px;
                        padding-top: 16px;
                        padding-bottom: 16px;
                        spacing: 18px;
                        alignment: start;

                        // The Mac Guide's title and byline (Localization.swift:1941-1942),
                        // the title semibold at body + 4 (GuideLayout.swift:83).
                        HelpText {
                            text: Strings.help-title;
                            font-size: Tokens.font-size-body + 4px;
                            font-weight: Fluent.weight-semibold;
                        }

                        HelpText {
                            text: Strings.help-byline;
                        }

                        HelpText {
                            text: Strings.help-intro;
                        }

                        HelpArt {
                            light: @image-url("../../brand/guide/source.svg");
                            dark: @image-url("../../brand/guide/source-dark.svg");
                            description: Strings.help-art-source;
                        }

                        HelpSection {
                            title: Strings.help-start-title;

                            HelpList {
                                numbered: true;
                                items: root.items(root.start-body);
                            }
                        }

                        HelpSection {
                            title: Strings.help-more-title;

                            HelpList {
                                items: root.items(root.sync-body);
                            }

                            HelpArt {
                                light: @image-url("../../brand/guide/delay.svg");
                                dark: @image-url("../../brand/guide/delay-dark.svg");
                                description: Strings.help-art-delay;
                            }

                            HelpList {
                                items: root.items(Platform.os == OperatingSystemType.linux ? root.linux-more-body + root.resume-paragraph + root.source-quits : root.more-body + root.resume-paragraph + "\n\n" + root.volume-keys + root.source-quits);
                            }
                        }

                        HelpSection {
                            title: Strings.help-calibration-title;
                            body: Platform.os == OperatingSystemType.linux ? Strings.help-calibration-linux : Strings.help-calibration;
                        }

                        HelpSection {
                            title: Strings.help-airplay-title;
                            body: root.airplay-body;
                        }

                        HelpSection {
                            title: Strings.help-cast-title;
                            body: Strings.help-sync-cast;
                        }

                        HelpArt {
                            light: @image-url("../../brand/guide/classes.svg");
                            dark: @image-url("../../brand/guide/classes-dark.svg");
                            description: Strings.help-art-classes;
                        }

                        HelpSection {
                            title: Strings.help-notices-title;
                            body: Platform.os == OperatingSystemType.linux ? Strings.help-notices-linux : Strings.help-notices;
                        }

                        HelpSection {
                            title: Strings.help-remote-title;
                            body: Platform.os == OperatingSystemType.linux ? Strings.help-remote-linux : Strings.help-remote;
                        }

                        HelpSection {
                            title: Strings.help-tips-title;

                            HelpList {
                                items: root.items(root.tune-body + "\n\n" + root.bluetooth-body);
                            }
                        }

                        HelpSection {
                            title: Strings.help-volume-title;
                            body: Platform.os == OperatingSystemType.linux ? Strings.help-volume-linux : Strings.help-volume;
                        }

                        HelpSection {
                            title: Strings.help-double-title;
                            body: Platform.os == OperatingSystemType.linux ? Strings.help-double-linux : Strings.help-double;

                            if root.show-how-shown: HorizontalLayout {
                                alignment: start;

                                Button {
                                    text: Strings.notice-show-how;
                                    accessible-label: Strings.notice-show-how-label;
                                    clicked => {
                                        root.show-how-requested();
                                    }
                                }
                            }
                        }
                    }
                }

                // The text has the keyboard focus (the scroll keys work), as
                // the other windows' focus rings show.
                FocusRing {
                    visible-focus: keys.has-focus;
                    border-radius: 4px;
                }
            }
        }
    }
}
