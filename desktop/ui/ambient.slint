// The Now Playing art under the cover: strands the app redraws while the
// sound or the breath moves them, or one still line (`src/ambient.rs`).

import { Tokens } from "tokens.slint";

export struct AmbientStrand {
    // SVG path commands in a 300 x 22 box.
    commands: string,
    // The breath's line over the strand, and the sound's strand in its tone.
    breath: float,
    sound: float,
    tone-light: color,
    tone-dark: color,
    width: float,
}

export struct AmbientLook {
    strands: [AmbientStrand],
    line-light: color,
    line-dark: color,
}

export component AmbientArt inherits Rectangle {
    in property <AmbientLook> look;
    property <color> line: Tokens.dark ? root.look.line-dark : root.look.line-light;

    accessible-role: none;

    // The strands fade out over their outer 9% (`ambient_breath::EDGE_FADE`).
    for strand in root.look.strands: strip := Rectangle {
        property <color> tone: Tokens.dark ? strand.tone-dark : strand.tone-light;
        width: 100%;
        height: 100%;

        Path {
            width: 100%;
            height: 100%;
            viewbox-width: 300;
            viewbox-height: 22;
            // Stretched, as the Mac draws the strands across the strip's width.
            fit: fill;
            commands: strand.commands;
            stroke: @linear-gradient(90deg, root.line.with-alpha(0) 0%, root.line.with-alpha(strand.breath) 9%, root.line.with-alpha(strand.breath) 91%, root.line.with-alpha(0) 100%);
            stroke-width: strand.width * 1px;
            stroke-line-cap: round;
            visible: strand.breath > 0;
        }

        Path {
            width: 100%;
            height: 100%;
            viewbox-width: 300;
            viewbox-height: 22;
            fit: fill;
            commands: strand.commands;
            stroke: @linear-gradient(90deg, strip.tone.with-alpha(0) 0%, strip.tone.with-alpha(strand.sound) 9%, strip.tone.with-alpha(strand.sound) 91%, strip.tone.with-alpha(0) 100%);
            stroke-width: strand.width * 1px;
            stroke-line-cap: round;
            visible: strand.sound > 0;
        }
    }
}
