// The Now Playing art under the cover: strands the app redraws while the
// sound or the breath moves them, or one still line (`src/ambient.rs`).

import { Tokens } from "tokens.slint";

export struct AmbientStrand {
    // The strand's coverage at the strip's pixel size, faded at both ends.
    mask: image,
    // The breath's line over the strand, and the sound's strand in its tone.
    breath: float,
    sound: float,
    tone-light: color,
    tone-dark: color,
}

export struct AmbientLook {
    strands: [AmbientStrand],
    line-light: color,
    line-dark: color,
    // The cover's top band over the hero card, at 9% of the sound's envelope.
    tint: float,
    tint-color: color,
}

// The strip's width, which the app draws the masks to.
export global AmbientStrip {
    in-out property <length> width;
    callback resized();
}

export component AmbientArt inherits Rectangle {
    in property <AmbientLook> look;
    property <color> line: Tokens.dark ? root.look.line-dark : root.look.line-light;

    accessible-role: none;
    init => {
        AmbientStrip.width = self.width;
        AmbientStrip.resized();
    }
    changed width => {
        AmbientStrip.width = self.width;
        AmbientStrip.resized();
    }

    for strand in root.look.strands: strip := Rectangle {
        property <color> tone: Tokens.dark ? strand.tone-dark : strand.tone-light;
        width: 100%;
        height: 100%;

        line := Image {
            width: 100%;
            height: 100%;
            source: strand.mask;
            image-fit: fill;
            colorize: root.line.with-alpha(strand.breath);
            visible: strand.breath > 0;
        }

        Image {
            width: 100%;
            height: 100%;
            source: strand.mask;
            image-fit: fill;
            colorize: strip.tone.with-alpha(strand.sound);
            visible: strand.sound > 0;
        }
    }
}
