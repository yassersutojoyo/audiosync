// The main window: the same sections as the macOS app's main window, in the
// same order. Header (mark, wordmark, status, streaming switch), notices,
// then a left column (audio source, Now Playing, master volume, equalizer,
// calibration) and the speaker list (This PC, Zones, Connected Speakers).
// Its own top row carries the menus and the window buttons. Tab order
// follows the reading order.

import { Button, Spinner } from "std-widgets.slint";
import { Tokens } from "tokens.slint";
import { AmbientArt, AmbientLook } from "ambient.slint";
import { IconLook, IncomingCover, OutgoingSong, SlideLook, SlidLine, TrackMotion } from "track_slide.slint";
import { Strings } from "strings.slint";
import { Appearance, CalibrationRowItem, CastList, DeviceVolumeHint, HiddenItem, LeftOutItem, MainControl, MixAppItem, NoticeItem, SourceLook, PresetItem, UpdateButton, RowPart, RowState, SpeakerItem, ZoneItem } from "types.slint";
import { AirPlayDelayControls, Announcer, MenuDivider, MenuKey, MenuNote, MenuRoom, MenuState, MenuPanel, MenuRepaint, MenuRow, SourceMenuRow, TextField, FadeScrollView, FoldPane, BrandMark, Card, CardTitle, Divider, FocusRing, Fluent, Glyph, Glyphs, IconButton, LevelMeter, ChoiceLine, LinkButton, MarqueeText, MasterVolume, Motion, NoticeStack, OverlayScrollView, PairPicker, PowerSwitch, QuietText, ResizeEdge, ScreenReader, SecondaryText, SmallButton, SpeakerRow, WindowButton, Wordmark, ZoneHeader, ZoneMemberRow } from "widgets.slint";

export { AboutDialog } from "about.slint";
export { EqualizerWindow } from "equalizer.slint";
export { TrayFlyout } from "flyout.slint";
export { CastSheet, ZoneNameDialog, PasswordDialog, PinDialog } from "dialogs.slint";
import { CastAddressSheet, CastSheet } from "dialogs.slint";
export { GuideWindow } from "guide.slint";
export { HelpWindow } from "help.slint";
export { RemoteWindow } from "remote.slint";
export { SetupWindow } from "setup.slint";
export { SettingsWindow } from "settings.slint";
export { Strings } from "strings.slint";
export { Fold, KeyboardFocus, Motion, NameField, ScreenReader } from "widgets.slint";
// The style's palette, for the theme preview (src/view.rs).
export { Palette } from "std-widgets.slint";
// The brand teal, for the standard controls' accent (src/view.rs).
export { Tokens } from "tokens.slint";
export { AmbientLook, AmbientStrand } from "ambient.slint";
export { IconLook, OutgoingSong, SlideLook, TrackMotion } from "track_slide.slint";
export { AirPlayProblem, Appearance, Availability, CastList, CastProblem, CastState, DeviceVolumeHint, GuidePage, GuideStepItem, MixAppItem, NoticeItem, NoticeKind, PinPhase, RowPart, RowState, SetupMicrophone, SetupNetwork, SpeakerGroup, SpeakerItem, SpeakerKind, ZoneChoice, ZoneItem, ZoneTarget } from "types.slint";

// The main window's left column: the speaker list widens first, to its full
// width, then the left column, from narrow to wide.
global MainColumns {
    public pure function left(window: length) -> length {
        let room = window - 2 * Fluent.window-margin - Fluent.column-gap;
        return clamp(room - Fluent.speaker-list-full, Fluent.left-column-narrow, Fluent.left-column-wide);
    }
}

// The hero's source menu, drawn as the Mac's: a filled row with the source's
// teal icon, its name and a chevron, opening the list of sources.
component SourceMenu inherits Rectangle {
    in property <[string]> sources;
    in property <[SourceLook]> looks;
    in property <int> index;
    in property <bool> is-input;
    in property <[MixAppItem]> mix-apps;
    in property <bool> mix-all-except;
    out property <bool> has-focus: focus.has-focus;
    callback chosen(int);
    callback mix-mode-selected(bool);
    callback mix-app-toggled(int);
    // Several Apps' rows show under it.
    property <bool> mix-expanded;

    property <int> menu-serial;

    public function open-menu() {
        root.mix-expanded = false;
        if MenuState.open != 0 && MenuState.open == root.menu-serial {
            menu.close();
            MenuState.open = 0;
            return;
        }
        // A closing menu gives the focus back to what had it, which is also
        // how it tells it closed; with nothing focused it couldn't.
        focus.focus();
        root.menu-serial = MenuState.claim();
        menu.show();
    }

    min-height: row.preferred-height;
    border-radius: 9px;
    background: touch.pressed ? Fluent.pressed : touch.has-hover ? Fluent.hover : Tokens.text.with-alpha(0.05);
    forward-focus: focus;
    accessible-role: button;
    accessible-label: Strings.source-label;
    accessible-value: root.sources[root.index];
    accessible-action-default => {
        root.open-menu();
    }

    touch := TouchArea {
        clicked => {
            root.open-menu();
        }

        focus := FocusScope {
            focus-on-click: false;
            key-pressed(event) => {
                if event.text == " " || event.text == Key.Return || event.text == Key.DownArrow {
                    root.open-menu();
                    return accept;
                }
                return reject;
            }

            row := HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 8px;

                // The chosen app's own icon, as the Mac's button shows it.
                if root.looks[root.index].icon.width > 0: Rectangle {
                    width: 20px;

                    Image {
                        width: 16px;
                        height: 16px;
                        source: root.looks[root.index].icon;
                    }
                }

                if root.looks[root.index].icon.width == 0: Glyph {
                    glyph: root.is-input ? Glyphs.microphone : Glyphs.volume-high;
                    color: Tokens.text;
                    font-size: 20px;
                }

                Text {
                    text: root.sources[root.index];
                    color: Tokens.text;
                    overflow: elide;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    accessible-role: none;
                }

                Glyph {
                    glyph: Glyphs.chevron-down;
                    font-size: 12px;
                    color: Tokens.text;
                }
            }
        }
    }

    // The Mac's source menu: the sources, then Several Apps, whose rows
    // unfold under it.
    menu := PopupWindow {
        x: 10px - MenuRoom.margin;
        y: root.height + 4px - MenuRoom.margin;
        // The Mac's 270 pt, wider for a long name, as its menu sizes to its widest item,
        // up to 20 px short of the window's edge, where a name is cut.
        property <length> room: MenuRoom.width - root.absolute-position.x - 10px - 20px + 2 * MenuRoom.margin;
        width: MenuRoom.width > 0px ? min(max(270px + 2 * MenuRoom.margin, panel.preferred-width), max(270px + 2 * MenuRoom.margin, self.room)) : max(270px + 2 * MenuRoom.margin, panel.preferred-width);
        close-policy: close-on-click-outside;
        // The window cuts a popup at its edge, so a long list stops 8 px
        // above the window's bottom and its rows scroll.
        height: MenuRoom.height > 0px ? min(panel.preferred-height, MenuRoom.height - root.absolute-position.y - root.height - 12px + 2 * MenuRoom.margin) : panel.preferred-height;

        panel := MenuPanel {
            property <int> sources: root.sources.length;
            count: self.sources + 1 + (root.mix-expanded ? 2 + root.mix-apps.length : 0);
            // A row the keys pick scrolls into view: 24 px rows, the 9 px divider after the sources.
            changed current => {
                if self.current >= 0 {
                    let top = self.current * 24px + (self.current >= self.sources ? 9px : 0px);
                    if top < -list.content-y {
                        list.content-y = -top;
                    } else if top + 24px > list.visible-height - list.content-y {
                        list.content-y = list.visible-height - top - 24px;
                    }
                }
            }
            close-requested(refocus) => {
                menu.close();
                if refocus {
                    root.focus();
                }
            }

            list := OverlayScrollView {
                preferred-width: rows.preferred-width;
                preferred-height: rows.preferred-height;
                content-height: rows.preferred-height;

                rows := VerticalLayout {
                    width: list.visible-width;

                    for name[i] in root.sources: SourceMenuRow {
                        index: i;
                        text: name;
                        checked: i == root.index;
                        look: root.looks[i];
                        above: root.looks[max(i - 1, 0)].kind;
                        current <=> panel.current;
                        keyboard <=> panel.keyboard;
                        pulse: panel.pulse;
                        done <=> panel.done;
                        activated => {
                            root.chosen(i);
                        }
                    }

                    MenuDivider { }

                    MenuRow {
                        height: 24px;
                        index: panel.sources;
                        text: Strings.source-mix-title;
                        checks: true;
                        submenu: true;
                        expanded: root.mix-expanded;
                        current <=> panel.current;
                        keyboard <=> panel.keyboard;
                        pulse: panel.pulse;
                        done <=> panel.done;
                        activated => {
                            root.mix-expanded = !root.mix-expanded;
                        }
                    }

                    if root.mix-expanded: MenuRow {
                        index: panel.sources + 1;
                        text: Strings.source-mix-only;
                        checks: true;
                        checked: !root.mix-all-except;
                        nested: true;
                        current <=> panel.current;
                        keyboard <=> panel.keyboard;
                        pulse: panel.pulse;
                        done <=> panel.done;
                        activated => {
                            root.mix-mode-selected(false);
                        }
                    }

                    if root.mix-expanded: MenuRow {
                        index: panel.sources + 2;
                        text: Strings.source-mix-all-except;
                        checks: true;
                        checked: root.mix-all-except;
                        nested: true;
                        current <=> panel.current;
                        keyboard <=> panel.keyboard;
                        pulse: panel.pulse;
                        done <=> panel.done;
                        activated => {
                            root.mix-mode-selected(true);
                        }
                    }

                    if root.mix-expanded && root.mix-apps.length == 0: MenuNote {
                        text: Strings.source-mix-empty;
                        nested: true;
                    }

                    for app[index] in root.mix-expanded ? root.mix-apps : []: MenuRow {
                        index: panel.sources + 3 + index;
                        text: app.name;
                        icon: app.icon;
                        icon-glyph: Glyphs.display;
                        checks: true;
                        checked: app.checked;
                        nested: true;
                        current <=> panel.current;
                        keyboard <=> panel.keyboard;
                        pulse: panel.pulse;
                        done <=> panel.done;
                        activated => {
                            root.mix-app-toggled(index);
                        }
                    }

                    if root.mix-expanded && root.mix-apps.length > 0 && root.mix-all-except && Strings.source-mix-all-except-note != "": MenuNote {
                        text: Strings.source-mix-all-except-note;
                        nested: true;
                    }
                }
            }
        }
    }

    FocusRing {
        visible-focus: focus.has-focus;
        border-radius: root.border-radius;
    }
}

// The header's gear, as the Mac's: its Speakers and Windows sections, then
// About and Exit, which a Windows app keeps in no app menu.
component GearButton inherits IconButton {
    callback new-zone();
    callback refresh();
    callback remote();
    callback settings();
    callback guide();
    callback about();
    callback exit();

    property <int> menu-serial;

    public function open-menu() {
        if MenuState.open != 0 && MenuState.open == root.menu-serial {
            menu.close();
            MenuState.open = 0;
            return;
        }
        // A closing menu gives the focus back to what had it, which is also
        // how it tells it closed; with nothing focused it couldn't.
        root.focus();
        root.menu-serial = MenuState.claim();
        menu.show();
    }

    glyph: Glyphs.gear;
    label: Strings.more-options;
    accessible-description: Strings.more-options-hint;
    clicked => {
        root.open-menu();
    }

    menu := PopupWindow {
        x: root.width - self.width + MenuRoom.margin;
        y: root.height + 4px - MenuRoom.margin;
        width: max(270px + 2 * MenuRoom.margin, panel.preferred-width);

        panel := MenuPanel {
            count: 7;
            close-requested(refocus) => {
                menu.close();
                if refocus {
                    root.focus();
                }
            }

            MenuNote {
                text: Strings.menu-speakers;
            }

            MenuRow {
                index: 0;
                text: Strings.new-zone;
                keys: "Ctrl+N";
                current <=> panel.current;
                keyboard <=> panel.keyboard;
                pulse: panel.pulse;
                done <=> panel.done;
                activated => {
                    root.new-zone();
                }
            }

            MenuRow {
                index: 1;
                text: Strings.refresh-devices;
                keys: "F5";
                current <=> panel.current;
                keyboard <=> panel.keyboard;
                pulse: panel.pulse;
                done <=> panel.done;
                activated => {
                    root.refresh();
                }
            }

            MenuNote {
                text: Strings.menu-group-windows;
            }

            MenuRow {
                index: 2;
                text: Strings.menu-remote;
                current <=> panel.current;
                keyboard <=> panel.keyboard;
                pulse: panel.pulse;
                done <=> panel.done;
                activated => {
                    root.remote();
                }
            }

            MenuRow {
                index: 3;
                text: Strings.settings-menu;
                keys: "Ctrl+,";
                current <=> panel.current;
                keyboard <=> panel.keyboard;
                pulse: panel.pulse;
                done <=> panel.done;
                activated => {
                    root.settings();
                }
            }

            MenuRow {
                index: 4;
                text: Strings.help-title;
                keys: "F1";
                current <=> panel.current;
                keyboard <=> panel.keyboard;
                pulse: panel.pulse;
                done <=> panel.done;
                activated => {
                    root.guide();
                }
            }

            MenuDivider { }

            MenuRow {
                index: 5;
                text: Strings.menu-about;
                current <=> panel.current;
                keyboard <=> panel.keyboard;
                pulse: panel.pulse;
                done <=> panel.done;
                activated => {
                    root.about();
                }
            }

            MenuRow {
                index: 6;
                text: Strings.menu-exit;
                keys: "Ctrl+Q";
                current <=> panel.current;
                keyboard <=> panel.keyboard;
                pulse: panel.pulse;
                done <=> panel.done;
                activated => {
                    root.exit();
                }
            }
        }
    }
}

// A list item that comes or goes: it opens or shuts its room and fades with
// it over the Mac's row move, a 0.35 s ease-out (MainWindow.swift:305-307,
// WindowRules.swift:82 and 213), at once with animation effects off.
component ListEase inherits Rectangle {
    in property <bool> fresh;
    in property <bool> leaving;
    property <float> open: root.fresh || root.leaving ? 0 : 1;
    init => {
        if !root.leaving {
            root.open = 1;
        }
    }
    changed leaving => {
        root.open = root.leaving ? 0 : 1;
    }
    animate open {
        duration: Motion.on ? 350ms : 0ms;
        easing: ease-out;
    }
    height: root.open * content.preferred-height;
    // Clipped only while it moves, so a focus ring may pass its edge at rest.
    clip: root.open < 1;

    content := Rectangle {
        y: 0px;
        width: parent.width;
        height: self.preferred-height;
        opacity: root.open;

        @children
    }

    // Over a leaving item, so no click or hover reaches it.
    if root.leaving: TouchArea { }
}

// Speaker rows with a line between them, in a section's or a zone's card.
component SpeakerRows inherits VerticalLayout {
    in property <[SpeakerItem]> speakers;
    // Rows in a zone, which take no hover fill, as on the Mac.
    in property <bool> grouped;
    callback toggled(string);
    callback volume-changed(string, float);
    callback volume-editing(string, bool);
    callback sync-toggled(string);
    callback delay-stepped(string, int);
    callback delay-edited(string, string);
    callback delay-committed(string);
    callback delay-cancelled(string);
    callback auto-connect-toggled(string, bool);
    callback forget-pairing(string);
    callback device-volume-fix(string);
    callback system-volume-changed(string, float);
    callback system-volume-editing(string, bool);
    callback rename-requested(string);
    callback rename-edited(string, string);
    callback rename-committed(string);
    callback rename-cancelled(string);
    callback cast-muted(string, bool);
    callback cast-resync(string);
    callback cast-remove(string);
    callback hide-requested(string);
    callback calibrate(string);
    callback move-to-zone(string, string);
    callback new-zone(string);
    callback remove-from-zone(string);
    callback only-this(string);
    callback focus-changed(string, RowPart);
    callback blank-clicked();
    callback cancel-calibration();
    callback calibration-privacy();
    // A row built while this is its speaker's ID, or already built when it
    // becomes it, takes the keyboard focus on focus-part and clears the ID
    // (see MainWindow).
    in-out property <string> focus-id;
    in-out property <RowPart> focus-part;

    for speaker[index] in root.speakers: ListEase {
        fresh: speaker.fresh;
        leaving: speaker.leaving;

        VerticalLayout {
            if index > 0: HorizontalLayout {
                padding-left: Fluent.name-inset;
                Divider { }
            }

            SpeakerRow {
                item: speaker;
                grouped: root.grouped;
                init => {
                    if speaker.id == root.focus-id {
                        root.focus-id = "";
                        self.take-focus(root.focus-part);
                    }
                }
                property <bool> focus-asked: speaker.id == root.focus-id;
                changed focus-asked => {
                    if self.focus-asked {
                        root.focus-id = "";
                        self.take-focus(root.focus-part);
                    }
                }
                toggled => {
                    root.toggled(speaker.id);
                }
                volume-changed(value) => {
                    root.volume-changed(speaker.id, value);
                }
                volume-editing(on) => {
                    root.volume-editing(speaker.id, on);
                }
                sync-toggled => {
                    root.sync-toggled(speaker.id);
                }
                delay-stepped(delta) => {
                    root.delay-stepped(speaker.id, delta);
                }
                delay-edited(text) => {
                    root.delay-edited(speaker.id, text);
                }
                delay-committed => {
                    root.delay-committed(speaker.id);
                }
                delay-cancelled => {
                    root.delay-cancelled(speaker.id);
                }
                auto-connect-toggled(on) => {
                    root.auto-connect-toggled(speaker.id, on);
                }
                forget-pairing => {
                    root.forget-pairing(speaker.id);
                }
                device-volume-fix => {
                    root.device-volume-fix(speaker.id);
                }
                system-volume-changed(value) => {
                    root.system-volume-changed(speaker.id, value);
                }
                system-volume-editing(on) => {
                    root.system-volume-editing(speaker.id, on);
                }
                rename-requested => {
                    root.rename-requested(speaker.id);
                }
                rename-edited(text) => {
                    root.rename-edited(speaker.id, text);
                }
                rename-committed => {
                    root.rename-committed(speaker.id);
                }
                rename-cancelled => {
                    root.rename-cancelled(speaker.id);
                }
                cast-muted(muted) => {
                    root.cast-muted(speaker.id, muted);
                }
                cast-resync => {
                    root.cast-resync(speaker.id);
                }
                cast-remove => {
                    root.cast-remove(speaker.id);
                }
                hide-requested => {
                    root.hide-requested(speaker.id);
                }
                calibrate => {
                    root.calibrate(speaker.id);
                }
                move-to-zone(zone) => {
                    root.move-to-zone(speaker.id, zone);
                }
                new-zone => {
                    root.new-zone(speaker.id);
                }
                remove-from-zone => {
                    root.remove-from-zone(speaker.id);
                }
                only-this => {
                    root.only-this(speaker.id);
                }
                focus-changed(part) => {
                    // A leaving row hands the focus on to a neighbour.
                    if speaker.leaving && part != RowPart.none {
                        root.focus-part = part;
                        root.focus-id = speaker.hand-off;
                    } else {
                        root.focus-changed(speaker.id, part);
                    }
                }
                blank-clicked => {
                    root.blank-clicked();
                }
                cancel-calibration => {
                    root.cancel-calibration();
                }
                calibration-privacy => {
                    root.calibration-privacy();
                }
            }
        }
    }
}

// A zone in a card Narrator names after it: its header, then its members'
// rows while it is expanded.
component ZoneCard inherits VerticalLayout {
    in property <ZoneItem> item;
    callback zone-toggled <=> header.toggled;
    callback zone-expanded-changed <=> header.expanded-changed;
    callback zone-volume-changed <=> header.volume-changed;
    callback zone-rename <=> header.rename;
    callback zone-rename-edited <=> header.rename-edited;
    callback zone-rename-committed <=> header.rename-committed;
    callback zone-rename-cancelled <=> header.rename-cancelled;
    callback zone-delete <=> header.delete;
    callback zone-calibrate <=> header.calibrate;
    callback zone-use-target <=> header.use-target;
    callback zone-focus-changed <=> header.focus-changed;
    callback toggled <=> rows.toggled;
    callback volume-changed <=> rows.volume-changed;
    callback volume-editing <=> rows.volume-editing;
    callback sync-toggled <=> rows.sync-toggled;
    callback delay-stepped <=> rows.delay-stepped;
    callback delay-edited <=> rows.delay-edited;
    callback delay-committed <=> rows.delay-committed;
    callback delay-cancelled <=> rows.delay-cancelled;
    callback auto-connect-toggled <=> rows.auto-connect-toggled;
    callback forget-pairing <=> rows.forget-pairing;
    callback device-volume-fix <=> rows.device-volume-fix;
    callback system-volume-changed <=> rows.system-volume-changed;
    callback system-volume-editing <=> rows.system-volume-editing;
    callback rename-requested <=> rows.rename-requested;
    callback rename-edited <=> rows.rename-edited;
    callback rename-committed <=> rows.rename-committed;
    callback rename-cancelled <=> rows.rename-cancelled;
    callback cast-muted <=> rows.cast-muted;
    callback cast-resync <=> rows.cast-resync;
    callback cast-remove <=> rows.cast-remove;
    callback hide-requested <=> rows.hide-requested;
    callback calibrate <=> rows.calibrate;
    callback move-to-zone <=> rows.move-to-zone;
    callback new-zone <=> rows.new-zone;
    callback remove-from-zone <=> rows.remove-from-zone;
    callback only-this <=> rows.only-this;
    callback focus-changed <=> rows.focus-changed;
    callback blank-clicked <=> rows.blank-clicked;
    callback cancel-calibration <=> rows.cancel-calibration;
    callback calibration-privacy <=> rows.calibration-privacy;
    // While reveal-zone-id is its zone's ID, the card clears it and reports
    // where it is, for the list to scroll to it (Go to Zone).
    in-out property <string> reveal-zone-id;
    callback revealed(length);
    property <bool> reveal-asked: root.item.id == root.reveal-zone-id;
    changed reveal-asked => {
        if self.reveal-asked {
            root.reveal-zone-id = "";
            root.revealed(self.absolute-position.y);
        }
    }
    // The header takes the keyboard focus on focus-zone-part while
    // focus-zone-id is its zone's ID, and clears it; the rows as in
    // SpeakerRows.
    in-out property <string> focus-zone-id;
    in-out property <RowPart> focus-zone-part;
    in-out property <string> focus-id <=> rows.focus-id;
    in-out property <RowPart> focus-part <=> rows.focus-part;
    property <bool> members-shown: root.item.expanded && root.item.members.length > 0;
    // From the second zone on, a rule above it, faded while a header it
    // touches is hovered so a hover fill never meets it.
    in property <bool> follows-zone;
    in property <bool> divider-hidden;
    out property <bool> header-hovered: header.hovered;

    accessible-role: groupbox;
    accessible-label: root.item.name;

    // Shaped like a speaker row, as on the Mac: no card, and a rule from
    // the title to the options button between this zone and the one above.
    if root.follows-zone: HorizontalLayout {
        padding-left: 70px;
        padding-right: 14px;
        Divider {
            opacity: root.divider-hidden ? 0 : 1;
        }
    }

    header := ZoneHeader {
        item: root.item;
        init => {
            if root.item.id == root.focus-zone-id {
                root.focus-zone-id = "";
                self.take-focus(root.focus-zone-part);
            }
        }
        property <bool> focus-asked: root.item.id == root.focus-zone-id;
        changed focus-asked => {
            if self.focus-asked {
                root.focus-zone-id = "";
                self.take-focus(root.focus-zone-part);
            }
        }
    }

    // Its speakers while unfolded, set apart by a rule down their leading edge.
    members := FoldPane {
        open: root.members-shown;

        Rectangle {
            VerticalLayout {
                rows := SpeakerRows {
                    speakers: members.shown ? root.item.members : [];
                    grouped: true;
                }
            }

            rule := Rectangle {
                x: 0;
                width: 1px;
                background: Tokens.separator;
            }
        }
    }
}

// A titled card of speaker rows, with a note when it has none.
component SpeakerSection inherits VerticalLayout {
    in property <string> title;
    in property <[SpeakerItem]> speakers;
    in property <string> note;
    callback toggled <=> rows.toggled;
    callback volume-changed <=> rows.volume-changed;
    callback volume-editing <=> rows.volume-editing;
    callback sync-toggled <=> rows.sync-toggled;
    callback delay-stepped <=> rows.delay-stepped;
    callback delay-edited <=> rows.delay-edited;
    callback delay-committed <=> rows.delay-committed;
    callback delay-cancelled <=> rows.delay-cancelled;
    callback auto-connect-toggled <=> rows.auto-connect-toggled;
    callback forget-pairing <=> rows.forget-pairing;
    callback device-volume-fix <=> rows.device-volume-fix;
    callback system-volume-changed <=> rows.system-volume-changed;
    callback system-volume-editing <=> rows.system-volume-editing;
    callback rename-requested <=> rows.rename-requested;
    callback rename-edited <=> rows.rename-edited;
    callback rename-committed <=> rows.rename-committed;
    callback rename-cancelled <=> rows.rename-cancelled;
    callback cast-muted <=> rows.cast-muted;
    callback cast-resync <=> rows.cast-resync;
    callback cast-remove <=> rows.cast-remove;
    callback hide-requested <=> rows.hide-requested;
    callback calibrate <=> rows.calibrate;
    callback move-to-zone <=> rows.move-to-zone;
    callback new-zone <=> rows.new-zone;
    callback remove-from-zone <=> rows.remove-from-zone;
    callback focus-changed <=> rows.focus-changed;
    callback blank-clicked <=> rows.blank-clicked;
    callback cancel-calibration <=> rows.cancel-calibration;
    callback calibration-privacy <=> rows.calibration-privacy;
    // The compact rows of its speakers that are in a zone, after the others.
    in property <[SpeakerItem]> zoned;
    callback go-to-zone(string);
    // A rename asked for in a compact row; its typing, Enter and Escape go
    // through rename-edited, rename-committed and rename-cancelled.
    callback in-zones-rename-requested(string);
    callback in-zones-focus-changed(string, RowPart);
    // A compact row takes the keyboard focus on in-zones-focus-part while
    // in-zones-focus-id is its speaker's ID, and clears the ID.
    in-out property <string> in-zones-focus-id;
    in-out property <RowPart> in-zones-focus-part;
    // Open Network Settings, under the note while AirPlay finds nothing.
    in property <bool> show-network-settings;
    callback network-settings();
    // Add by Address…, last, while a Google Cast sender runs (S443).
    in property <bool> show-add-address;
    // Bumped as the Add by Address sheet closes: its button takes the focus back.
    in property <int> focus-add-address;
    callback add-address();
    in-out property <string> focus-id <=> rows.focus-id;
    in-out property <RowPart> focus-part <=> rows.focus-part;

    spacing: 4px;
    accessible-role: groupbox;
    accessible-label: root.title;

    CardTitle {
        text: root.title;
    }

    // Rows on the window, split by hairlines, not in a card.
    card := VerticalLayout {
        rows := SpeakerRows {
            speakers: root.speakers;
        }

        // Rows right after the list, as on the Mac: Connected Speakers' AirPlay delay.
        @children

        // As on the Mac, the label's rule is the line above these rows, and
        // its left end turns down into the first zone's bar.
        if root.zoned.length > 0: VerticalLayout {
            Rectangle {
                height: in-zones-label.preferred-height;

                in-zones-label := HorizontalLayout {
                    padding-left: Fluent.name-inset;
                    padding-right: Fluent.row-padding-x;
                    padding-top: 9px;
                    padding-bottom: 5px;
                    spacing: 8px;

                    in-zones-text := SecondaryText {
                        text: Strings.in-zones.to-uppercase();
                        accessible-label: Strings.in-zones;
                        font-size: Tokens.font-size-subheadline;
                        font-weight: Fluent.weight-medium;
                        horizontal-stretch: 0;
                    }

                    VerticalLayout {
                        alignment: center;
                        Divider { }
                    }
                }

                // The join, clipped to a corner of a box whose top edge is
                // the rule and whose left edge is the bar.
                Rectangle {
                    property <length> rule-y: 9px + (in-zones-text.preferred-height - 1px) / 2;
                    x: 0;
                    y: self.rule-y;
                    width: Fluent.name-inset - 8px;
                    height: parent.height - self.rule-y;
                    clip: true;

                    Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.width + 12px;
                        height: parent.height + 12px;
                        border-width: 1px;
                        border-color: Tokens.separator;
                        border-top-left-radius: 6px;
                    }
                }
            }

            for speaker[index] in root.zoned: VerticalLayout {
                // A new zone's rows start 4 px under the last zone's; within a
                // zone a hairline from the names splits them, the bar going on.
                if index > 0 && root.zoned[index - 1].zone-id != speaker.zone-id: Rectangle {
                    height: 4px;
                }
                if index > 0 && root.zoned[index - 1].zone-id == speaker.zone-id: HorizontalLayout {
                    Rectangle {
                        width: 1px;
                        background: Tokens.separator;
                    }

                    Rectangle {
                        width: Fluent.name-inset - 1px;
                    }

                    Divider { }
                }

                ZoneMemberRow {
                    item: speaker;
                    init => {
                        if speaker.id == root.in-zones-focus-id {
                            root.in-zones-focus-id = "";
                            self.take-focus(root.in-zones-focus-part);
                        }
                    }
                    property <bool> focus-asked: speaker.id == root.in-zones-focus-id;
                    changed focus-asked => {
                        if self.focus-asked {
                            root.in-zones-focus-id = "";
                            self.take-focus(root.in-zones-focus-part);
                        }
                    }
                    toggled => {
                        root.toggled(speaker.id);
                    }
                    rename-requested => {
                        root.in-zones-rename-requested(speaker.id);
                    }
                    rename-edited(text) => {
                        root.rename-edited(speaker.id, text);
                    }
                    rename-committed => {
                        root.rename-committed(speaker.id);
                    }
                    rename-cancelled => {
                        root.rename-cancelled(speaker.id);
                    }
                    blank-clicked => {
                        root.blank-clicked();
                    }
                    focus-changed(part) => {
                        root.in-zones-focus-changed(speaker.id, part);
                    }
                    go-to-zone => {
                        root.go-to-zone(speaker.zone-id);
                    }
                    remove-from-zone => {
                        root.remove-from-zone(speaker.id);
                    }
                }
            }
        }

        if root.note != "": VerticalLayout {
            if root.speakers.length > 0 || root.zoned.length > 0: Divider { }

            // Under a list, the note belongs to the last row's box: a click
            // works like one on that row. Alone, it is outside every row.
            // Inside the scroll view, so the window's own TouchArea doesn't
            // get it.
            note-area := TouchArea {
                clicked => {
                    if root.zoned.length == 0 && root.speakers.length > 0 && root.speakers[root.speakers.length - 1].has-delay {
                        root.sync-toggled(root.speakers[root.speakers.length - 1].id);
                    } else {
                        root.blank-clicked();
                    }
                }

                VerticalLayout {
                    padding: 10px;
                    spacing: 8px;
                    SecondaryText {
                        text: root.note;
                        font-size: Tokens.font-size-callout;
                    }

                    if root.show-network-settings: HorizontalLayout {
                        alignment: start;
                        SmallButton {
                            text: Strings.open-network-settings;
                            clicked => {
                                root.network-settings();
                            }
                        }
                    }
                }
            }
        }

        if root.show-add-address: VerticalLayout {
            // Under the note the line keeps to its 10 px text inset, as on the Mac.
            if root.speakers.length > 0 || root.zoned.length > 0 || root.note != "": HorizontalLayout {
                padding-left: root.note != "" ? 10px : 0px;
                padding-right: root.note != "" ? 10px : 0px;
                Divider { }
            }

            // On the speaker rows' badge column, as on the Mac, 10 px under
            // the line as the note has above it.
            HorizontalLayout {
                padding-left: Fluent.row-padding-x;
                padding-top: 10px;
                padding-bottom: 6px;
                alignment: start;
                SmallButton {
                    text: Strings.cast-add-address;
                    tip: Strings.cast-add-address-message;
                    property <int> focus-asked: root.focus-add-address;
                    changed focus-asked => {
                        self.focus();
                    }
                    clicked => {
                        root.add-address();
                    }
                }
            }
        }
    }
}

// One preset in the open Presets list (spec S259): a click, Space or Return
// recalls it; its … button, shown on hover, focus and with a screen reader,
// or a right-click renames, updates or deletes it.
component PresetListRow inherits Rectangle {
    in property <PresetItem> item;
    // Its name is a field, as on the Mac: Return applies, Escape keeps the old name.
    in property <bool> renaming;
    callback recall();
    callback rename();
    callback renamed(string);
    callback rename-ended();
    callback update();
    callback delete();
    property <bool> options-focused;
    // Set once Return or Escape ended the rename, so the field's lost focus adds nothing.
    property <bool> rename-done;
    property <length> menu-x;
    property <length> menu-y;
    property <length> menu-width: 200px;

    // At x, y in the window; past its right or bottom edge the menu
    // flips to end at flip-x or flip-y.
    property <int> menu-serial;

    function open-menu(x: length, y: length, flip-x: length, flip-y: length) {
        root.menu-x = MenuRoom.place(x, root.menu-width, flip-x, MenuRoom.width) - root.absolute-position.x;
        root.menu-y = MenuRoom.place(y, MenuRoom.rows(3, 1), flip-y, MenuRoom.height) - root.absolute-position.y;
        if MenuState.open != 0 && MenuState.open == root.menu-serial {
            menu.close();
            MenuState.open = 0;
            return;
        }
        // A closing menu gives the focus back to what had it, which is also
        // how it tells it closed; with nothing focused it couldn't.
        if !focus.has-focus && !root.options-focused {
            options.focus();
        }
        root.menu-serial = MenuState.claim();
        menu.show();
    }

    function open-menu-under-options() {
        root.open-menu(options.absolute-position.x, options.absolute-position.y + options.height, options.absolute-position.x + options.width, options.absolute-position.y);
    }

    min-height: 40px;
    border-radius: 6px;
    background: hover.pressed ? Fluent.pressed : hover.has-hover ? Fluent.row-hover : transparent;
    animate background {
        duration: hover.has-hover ? Fluent.row-hover-in : 0ms;
        easing: linear;
    }

    hover := TouchArea {
        clicked => {
            root.recall();
        }

        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.open-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }

        FocusScope {
            focus-on-click: false;
            focus-on-tab-navigation: false;
            key-pressed(event) => {
                if MenuKey.opens(event) {
                    root.open-menu-under-options();
                    return accept;
                }
                return reject;
            }

            HorizontalLayout {
                padding-right: 2px;
                spacing: 4px;

                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: Fluent.radius-control;
                    accessible-role: button;
                    accessible-label: root.item.name;
                    accessible-checkable: true;
                    accessible-checked: root.item.current;
                    accessible-value: Strings.preset-summary(root.item.speakers, root.item.master);
                    accessible-action-default => {
                        root.recall();
                    }

                    focus := FocusScope {
                        focus-on-click: false;
                        key-pressed(event) => {
                            if event.text == " " || event.text == Key.Return {
                                root.recall();
                                return accept;
                            }
                            return reject;
                        }
                    }

                    // 1 px over and under the two lines, so Segoe UI's taller
                    // lines keep the Mac's 40 px row.
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-top: 1px;
                        padding-bottom: 1px;
                        spacing: 8px;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;

                            if !root.renaming: Text {
                                text: root.item.name;
                                color: Tokens.text;
                                overflow: elide;
                                accessible-role: none;
                            }

                            if root.renaming: FocusScope {
                                focus-on-click: false;
                                focus-on-tab-navigation: false;
                                capture-key-pressed(event) => {
                                    if event.text == Key.Escape {
                                        root.rename-done = true;
                                        root.rename-ended();
                                        return accept;
                                    }
                                    return reject;
                                }

                                name-field := TextField {
                                    compact: true;
                                    font-size: Tokens.font-size-body;
                                    text: root.item.name;
                                    placeholder-text: Strings.preset-placeholder;
                                    accessible-label: Strings.preset-field-label;
                                    init => {
                                        root.rename-done = false;
                                        self.focus();
                                        self.select-all();
                                    }
                                    accepted(text) => {
                                        root.rename-done = true;
                                        root.renamed(text);
                                    }
                                    changed has-focus => {
                                        if !self.has-focus && !root.rename-done {
                                            root.rename-done = true;
                                            root.renamed(self.text);
                                        }
                                    }
                                }
                            }

                            Text {
                                text: Strings.preset-summary(root.item.speakers, root.item.master);
                                font-size: Tokens.font-size-subheadline;
                                color: Tokens.secondary-text;
                                overflow: elide;
                                accessible-role: none;
                            }
                        }
                    }

                    FocusRing {
                        visible-focus: focus.has-focus;
                        border-radius: parent.border-radius;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    options := IconButton {
                        height: 24px;
                        glyph: Glyphs.more;
                        label: Strings.speaker-options(root.item.name);
                        glyph-color: Tokens.secondary-text;
                        opacity: hover.has-hover || focus.has-focus || root.options-focused || ScreenReader.on ? 1 : 0;
                        clicked => {
                            root.open-menu-under-options();
                        }
                        focus-changed(focused) => {
                            root.options-focused = focused;
                        }
                    }
                }
            }
        }
    }

    menu := PopupWindow {
        x: root.menu-x - MenuRoom.margin;
        y: root.menu-y - MenuRoom.margin;
        width: max(root.menu-width + 2 * MenuRoom.margin, panel.preferred-width);
        close-policy: close-on-click-outside;

        panel := MenuPanel {
            count: 3;
            close-requested => {
                menu.close();
            }

            MenuRow {
                index: 0;
                text: Strings.rename-preset;
                current <=> panel.current;
                keyboard <=> panel.keyboard;
                pulse: panel.pulse;
                done <=> panel.done;
                activated => {
                    menu.close();
                    root.rename();
                }
            }

            MenuRow {
                index: 1;
                text: Strings.update-preset;
                enabled: !root.item.current;
                step: panel.step;
                count: panel.count;
                current <=> panel.current;
                keyboard <=> panel.keyboard;
                pulse: panel.pulse;
                done <=> panel.done;
                activated => {
                    root.update();
                }
            }

            MenuDivider { }

            MenuRow {
                index: 2;
                text: Strings.delete-preset;
                current <=> panel.current;
                keyboard <=> panel.keyboard;
                pulse: panel.pulse;
                done <=> panel.done;
                activated => {
                    root.delete();
                }
            }
        }
    }
}

// The Presets row (spec S259, S264, S267): the name of the preset picked
// last, kept after a change until it is deleted, and a list that folds open
// under it as a zone does: one row per preset, then Save as Preset…. A
// click, Space or Return folds it open or shut; Escape folds it.
component PresetsCard inherits Rectangle {
    in property <[PresetItem]> presets;
    // The name of the preset picked last; empty while none is.
    in property <string> current;
    // False at the most presets the app keeps (spec S251).
    in property <bool> can-save: true;
    in-out property <bool> open;
    // The app asks for the focus after a delete; the row clears the request.
    in-out property <bool> focus-wanted;
    callback recall(string);
    callback rename(string);
    callback update(string);
    callback delete(string);
    callback save();
    // The name field in place of Save as Preset…, and the preset whose row
    // is a name field, as on the Mac (empty: none).
    in-out property <bool> saving;
    in-out property <string> renaming-id;
    // Under Save as Preset…: why it saved nothing (empty: no caption).
    in-out property <string> save-why;
    callback save-named(string);
    callback rename-named(string, string);
    // Set once Return or Escape ended the save, so the field's lost focus adds nothing.
    property <bool> save-done;
    // The column's width, which the list's wrapped captions are measured at.
    in property <length> width-given;
    property <string> note: root.save-why != "" ? root.save-why : root.can-save ? "" : Strings.presets-full;

    changed open => {
        if !root.open {
            root.saving = false;
            root.renaming-id = "";
            root.save-why = "";
        }
    }

    changed focus-wanted => {
        if root.focus-wanted {
            root.focus-wanted = false;
            focus.focus();
        }
    }

    // The whole block is tinted while it is open, as the Mac's openRowFill.
    border-radius: 8px;
    background: root.open ? Fluent.open-row : transparent;
    animate background { duration: Motion.on ? 250ms : 0ms; }

    VerticalLayout {
        Rectangle {
            min-height: 28px;
            border-radius: Fluent.radius-control;
            background: touch.pressed ? Fluent.pressed : touch.has-hover ? Fluent.hover : transparent;
            animate background { duration: Fluent.fast; }
            forward-focus: focus;
            accessible-role: button;
            accessible-label: Strings.presets;
            accessible-value: root.presets.length == 0 ? Strings.no-presets : root.current != "" ? root.current : Strings.choose-preset;
            accessible-description: root.open ? Strings.hide-preset-list : Strings.show-preset-list;
            accessible-action-default => {
                root.open = !root.open;
            }

            touch := TouchArea {
                clicked => {
                    root.open = !root.open;
                }

                focus := FocusScope {
                    focus-on-click: false;
                    key-pressed(event) => {
                        if event.text == " " || event.text == Key.Return {
                            root.open = !root.open;
                            return accept;
                        }
                        return reject;
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;

                        // The glyphs stay on the label's line when the name's line shows.
                        VerticalLayout {
                            alignment: center;
                            Glyph {
                                glyph: Glyphs.presets;
                                color: Tokens.text;
                                width: 20px;
                                height: label.preferred-height;
                            }

                            Rectangle {
                                height: name.min-height;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            label := Text {
                                text: Strings.presets;
                                color: Tokens.text;
                                accessible-role: none;
                            }

                            name := ChoiceLine {
                                text: root.current;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            // Turns a quarter with the 250 ms fold, as on the Mac.
                            Rectangle {
                                height: label.preferred-height;
                                transform-rotation: root.open ? 90deg : 0deg;
                                animate transform-rotation {
                                    duration: Motion.on ? 250ms : 0ms;
                                    easing: ease-in-out;
                                }

                                Glyph {
                                    glyph: Glyphs.chevron-right;
                                    font-size: Tokens.font-size-callout;
                                    color: Tokens.secondary-text;
                                }
                            }

                            Rectangle {
                                height: name.min-height;
                            }
                        }
                    }
                }
            }

            FocusRing {
                visible-focus: focus.has-focus;
                border-radius: parent.border-radius;
            }
        }

        list := FoldPane {
            open: root.open;

            // Above five presets the list scrolls inside its card, half a row
            // past the fifth showing that it goes on; a new one, or the name
            // field of one being saved, scrolls into view.
            if list.shown: scroll := OverlayScrollView {
                property <int> count: root.presets.length;
                property <int> seen;
                property <bool> saving: root.saving;
                // The new row is laid out a pass after the count changes.
                property <bool> to-end;
                height: root.presets.length > 5 ? 40px * 5.5 : rows.preferred-height;
                init => {
                    self.seen = self.count;
                }
                changed count => {
                    self.to-end = self.count > self.seen && self.count > 5;
                    self.seen = self.count;
                }
                changed saving => {
                    self.to-end = self.saving && self.count >= 5;
                }
                changed content-height => {
                    if self.to-end && self.content-height > self.visible-height {
                        self.to-end = false;
                        self.content-y = self.visible-height - self.content-height;
                    }
                }

                // The names start 36 px in, on the Presets label's column, as on the Mac.
                rows := VerticalLayout {
                    padding-left: 22px;
                    padding-right: 6px;
                    padding-bottom: 6px;

                    for preset in root.presets: PresetListRow {
                        item: preset;
                        renaming: preset.id == root.renaming-id;
                        recall => {
                            root.recall(preset.id);
                        }
                        rename => {
                            root.rename(preset.id);
                        }
                        renamed(text) => {
                            root.renaming-id = "";
                            root.rename-named(preset.id, text);
                        }
                        rename-ended => {
                            root.renaming-id = "";
                        }
                        update => {
                            root.update(preset.id);
                        }
                        delete => {
                            root.delete(preset.id);
                        }
                    }

                    if root.presets.length == 0: HorizontalLayout {
                        padding-left: 14px;
                        padding-top: 6px;
                        padding-bottom: 6px;

                        // Its width set, so the list's height counts every wrapped line.
                        empty-note := Text {
                            width: root.width-given - 42px;
                            text: Strings.no-presets-hint;
                            font-size: Tokens.font-size-caption;
                            color: Tokens.secondary-text;
                            wrap: word-wrap;
                        }
                    }

                    // While a preset is saved, its name field takes this row's
                    // place, as on the Mac.
                    Rectangle {
                        min-height: 40px;
                        border-radius: 6px;
                        background: !root.can-save || root.saving ? transparent : save-touch.pressed ? Fluent.pressed : save-touch.has-hover ? Fluent.row-hover : transparent;
                        animate background {
                            duration: save-touch.has-hover ? Fluent.row-hover-in : 0ms;
                            easing: linear;
                        }
                        opacity: root.can-save ? 1 : Tokens.disabled-opacity;
                        accessible-role: button;
                        accessible-label: Strings.save-preset;
                        accessible-description: root.note;
                        accessible-enabled: root.can-save;
                        accessible-action-default => {
                            root.save();
                        }

                        save-focus := FocusScope {
                            enabled: root.can-save;
                            focus-on-click: false;
                            key-pressed(event) => {
                                if event.text == " " || event.text == Key.Return {
                                    root.save();
                                    return accept;
                                }
                                return reject;
                            }
                        }

                        save-touch := TouchArea {
                            enabled: root.can-save && !root.saving;
                            clicked => {
                                root.save();
                            }
                        }

                        if !root.saving: save-label := Text {
                            x: 14px;
                            width: parent.width - 20px;
                            text: Strings.save-preset;
                            color: Tokens.text;
                            overflow: elide;
                            vertical-alignment: center;
                            accessible-role: none;
                        }

                        FocusRing {
                            visible-focus: save-focus.has-focus;
                            border-radius: parent.border-radius;
                        }

                        if root.saving: FocusScope {
                            x: 14px;
                            y: (parent.height - self.height) / 2;
                            width: parent.width - 20px;
                            height: 22px;
                            focus-on-click: false;
                            focus-on-tab-navigation: false;
                            capture-key-pressed(event) => {
                                if event.text == Key.Escape {
                                    root.save-done = true;
                                    root.saving = false;
                                    save-focus.focus();
                                    return accept;
                                }
                                return reject;
                            }

                            save-field := TextField {
                                compact: true;
                                font-size: Tokens.font-size-body;
                                placeholder-text: Strings.preset-placeholder;
                                accessible-label: Strings.preset-field-label;
                                init => {
                                    root.save-done = false;
                                    self.focus();
                                }
                                accepted(text) => {
                                    root.save-done = true;
                                    root.saving = false;
                                    save-focus.focus();
                                    root.save-named(text);
                                }
                                // Losing the focus saves only what was typed.
                                changed has-focus => {
                                    if !self.has-focus && !root.save-done {
                                        root.save-done = true;
                                        root.saving = false;
                                        if self.text != "" {
                                            root.save-named(self.text);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if root.note != "": HorizontalLayout {
                        padding-left: 14px;
                        padding-bottom: 6px;

                        save-note := Text {
                            width: root.width-given - 42px;
                            text: root.note;
                            font-size: Tokens.font-size-caption;
                            color: Tokens.secondary-text;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}

// The Equalizer card: opens the equalizer window and says whether it is on.
component EqualizerCard inherits Rectangle {
    in property <bool> on;
    // The picker's curve, or "Custom".
    in property <string> curve;
    callback clicked();
    callback focus-changed(bool);

    // A row on the window: the whole row is the button.
    min-height: 28px;
    background: touch.pressed ? Fluent.pressed : touch.has-hover ? Fluent.hover : transparent;
    animate background { duration: Fluent.fast; }
    border-radius: Fluent.radius-control;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: Strings.equalizer;
    accessible-value: root.on ? Strings.equalizer-card-on(root.curve) : Strings.off;
    accessible-action-default => {
        root.clicked();
    }

    focus := FocusScope {
        focus-on-click: false;
        changed has-focus => {
            root.focus-changed(self.has-focus);
        }
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;

        // The glyphs stay on the label's line when the curve's line shows.
        VerticalLayout {
            alignment: center;
            // Turned upright: the Mac's sliders stand, the icon font's lie.
            Rectangle {
                width: 20px;
                height: label.preferred-height;
                transform-rotation: 90deg;

                icon := Glyph {
                    glyph: Glyphs.equalizer;
                    color: Tokens.text;
                    width: 20px;
                    height: label.preferred-height;
                }
            }

            Rectangle {
                height: curve.min-height;
            }
        }

        // The curve under the name while the equalizer is on, as on the Mac.
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            label := Text {
                text: Strings.equalizer;
                color: Tokens.text;
                accessible-role: none;
            }

            curve := ChoiceLine {
                text: root.on ? root.curve : "";
            }
        }

        VerticalLayout {
            alignment: center;
            chevron := Glyph {
                glyph: Glyphs.chevron-right;
                font-size: Tokens.font-size-callout;
                color: Tokens.secondary-text;
                height: label.preferred-height;
            }

            Rectangle {
                height: curve.min-height;
            }
        }
    }

    FocusRing {
        visible-focus: focus.has-focus;
        border-radius: root.border-radius;
    }
}

// A row on the window that starts something, as the Mac's quick rows: a
// glyph, the name and a chevron. The whole row is the button.
component QuickRow inherits Rectangle {
    in property <string> glyph;
    in property <string> text;
    in property <string> description;
    // Shown on hover; empty for none.
    in property <string> tip;
    in property <bool> enabled: true;
    callback clicked();
    callback focus-changed(bool);

    min-height: 28px;
    border-radius: Fluent.radius-control;
    background: !root.enabled ? transparent : touch.pressed ? Fluent.pressed : touch.has-hover ? Fluent.row-hover : transparent;
    animate background {
        duration: touch.has-hover ? Fluent.row-hover-in : 0ms;
        easing: linear;
    }
    opacity: root.enabled ? 1 : Tokens.disabled-opacity;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.text;
    accessible-description: root.description;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        changed has-focus => {
            root.focus-changed(self.has-focus);
        }
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        clicked => {
            if root.enabled {
                root.clicked();
            }
        }

        if root.tip != "": Tooltip {
            Rectangle {
                width: min(tip-text.preferred-width + 16px, max(root.width, 280px));
                height: tip-text.preferred-height + 10px;
                border-radius: Fluent.radius-control;
                border-width: 1px;
                border-color: Fluent.stroke;
                background: Tokens.surface;
                drop-shadow-blur: 8px;
                drop-shadow-offset-y: 2px;
                drop-shadow-color: Tokens.text.with-alpha(0.18);
                accessible-role: none;

                tip-text := Text {
                    x: 8px;
                    width: parent.width - 16px;
                    text: root.tip;
                    font-size: Tokens.font-size-caption;
                    color: Tokens.text;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    accessible-role: none;
                }
            }
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;

        Glyph {
            glyph: root.glyph;
            color: Tokens.text;
            width: 20px;
        }

        Text {
            text: root.text;
            color: Tokens.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
            accessible-role: none;
        }

        Glyph {
            glyph: Glyphs.chevron-right;
            font-size: Tokens.font-size-callout;
            color: Tokens.secondary-text;
        }
    }

    FocusRing {
        visible-focus: focus.has-focus;
        border-radius: root.border-radius;
    }
}

// Calibrate All Speakers (spec S235 to S240): the left column's row, which
// opens CalibrateAllSheet, and why it is off (CalibrateAllViews.swift:6-54).
component CalibrationCard inherits VerticalLayout {
    in property <bool> can-start;
    // What the run does, or why it can't start.
    in property <string> status;
    // The status only says what a run does: it shows as the row's tooltip.
    in property <bool> status-is-hint;
    callback start();
    callback focus-changed(bool);

    accessible-role: groupbox;
    accessible-label: Strings.calibrate-all;

    public function focus-row() {
        calibrate-button.focus();
    }

    spacing: 6px;

    calibrate-button := QuickRow {
        focus-changed(has) => {
            root.focus-changed(has);
        }
        glyph: Glyphs.microphone;
        text: Strings.calibrate-all;
        enabled: root.can-start;
        description: root.status;
        tip: root.status;
        clicked => {
            root.start();
        }
    }

    // The hint is the row's description and tooltip; a reason also
    // fades in under the row, as on the Mac.
    if !root.status-is-hint: Rectangle {
        opacity: 0;
        init => {
            self.opacity = 1;
        }
        animate opacity { duration: Motion.on ? 250ms : 0ms; }

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;

            status-line := QuietText {
                text: root.status;
            }
        }
    }
}

// A "Before you start" row's 26 px icon: tinted on a 15% disc, or solid
// (CalibrateAllViews.swift:292-298).
component CheckIcon inherits Rectangle {
    in property <string> glyph;
    in property <color> tint;
    in property <bool> solid;

    width: 26px;
    height: 26px;
    border-radius: 13px;
    background: root.solid ? root.tint : root.tint.with-alpha(0.15);
    accessible-role: none;

    Glyph {
        glyph: root.glyph;
        font-size: 12px;
        color: root.solid ? Tokens.warn-background : root.tint;
        vertical-alignment: center;
        alignment: LayoutAlignment.center;
    }
}

// The reference's volume against the low line, 260 wide; the title says
// it, so Narrator skips it (CalibrateAllViews.swift:260-289).
component VolumeMeter inherits VerticalLayout {
    in property <int> percent;
    in property <bool> muted;
    // core::policy::device_volume::LOW_AT_MOST_PERCENT.
    property <int> low: 25;
    property <length> meter-width: 260px;

    padding-top: 5px;
    spacing: 3px;
    accessible-role: none;

    Rectangle {
        width: root.meter-width;
        height: 6px;
        border-radius: 3px;
        background: Tokens.separator;

        Rectangle {
            x: 0;
            width: root.meter-width * max(0, min(100, root.percent)) / 100;
            border-radius: 3px;
            background: Tokens.warn.with-alpha(root.muted ? 0.35 : 1);
        }

        Rectangle {
            x: root.meter-width * root.low / 100 - 1px;
            y: (parent.height - self.height) / 2;
            width: 2px;
            height: 12px;
            background: Tokens.text.with-alpha(0.55);
        }
    }

    Rectangle {
        width: root.meter-width;
        height: zero.preferred-height;

        zero := Text {
            x: 0;
            text: Strings.system-volume-percent(0);
            font-size: Tokens.font-size-caption2;
            color: Tokens.secondary-text;
        }

        Text {
            x: root.meter-width * root.low / 100 - 20px;
            width: 40px;
            horizontal-alignment: center;
            text: Strings.system-volume-percent(root.low);
            font-size: Tokens.font-size-caption2;
            color: Tokens.secondary-text;
        }

        Text {
            x: parent.width - self.width;
            text: Strings.system-volume-percent(100);
            font-size: Tokens.font-size-caption2;
            color: Tokens.secondary-text;
        }
    }
}

// Calibrate All's run and results (spec S238, S239), laid out as the Mac's
// 600 wide sheet: the run's progress with Cancel, each speaker's row with
// Measure Again, the AirPlay delay, then Undo, Close and Apply. Escape
// cancels a run or closes the results.
component CalibrateAllSheet inherits FocusScope {
    in property <bool> running;
    // The run's progress, or why it stopped.
    in property <string> status;
    in property <bool> results-shown;
    in property <[CalibrationRowItem]> rows;
    // The AirPlay delay's line, empty without AirPlay speakers.
    in property <string> airplay;
    // For a Calibrate Zone run: where to bring the PC; empty otherwise.
    in property <string> zone;
    // How the run or the last action on its results ended.
    in property <string> outcome;
    // The outcome is a failure or a refused Apply.
    in property <bool> outcome-problem;
    in property <bool> can-apply;
    in property <bool> applied;
    in property <bool> can-undo;
    // The results ended early: the sheet offers a new run instead of Apply
    // (CalibrateAllViews.swift:507).
    in property <bool> ended;
    in property <bool> can-run;
    // Why the sheet's Calibrate All Speakers is off, before a run.
    in property <string> blocker;
    // The outputs that sit out (CalibrateAllViews.swift:430-478), with
    // Include Anyway or Leave Out while a new run can start (`choosing`).
    in property <[LeftOutItem]> left-out;
    in property <bool> choosing;
    // Before a run: the reference's device volume when it is low or muted
    // (spec S197), and the reference's name for Narrator.
    in property <DeviceVolumeHint> volume;
    in property <int> volume-percent;
    in property <string> reference;
    // The microphone was blocked: Open Privacy Settings.
    in property <bool> privacy;
    // The height the sheet may take; only the rows scroll past it.
    in property <length> room;
    // The window's width, which the sheet keeps a margin inside.
    in property <length> room-width;
    callback cancel();
    callback start();
    callback include(string, bool);
    callback measure-again(int);
    callback apply();
    callback undo();
    callback close();
    callback focus-changed(bool);
    callback fix-volume();
    callback privacy-requested();
    // Set as a run ends with something to apply: Apply then takes the focus.
    property <bool> apply-takes-focus;
    // Set by a keyboard click on the volume fix, which goes once it works.
    property <bool> close-takes-focus;
    // Two or three rows stay readable in the smallest window.
    property <length> list-cap: max(120px, root.room - top.preferred-height - bottom.preferred-height - 2 * 14px - 2 * 20px);

    width: min(600px, root.room-width - 2 * Fluent.window-margin);
    height: min(layout.preferred-height, root.room);
    focus-on-click: false;
    focus-on-tab-navigation: false;
    accessible-role: groupbox;
    accessible-label: root.zone != "" ? Strings.calibrate-zone : Strings.calibrate-all;
    key-pressed(event) => {
        if event.text != Key.Escape {
            return reject;
        }
        if root.running {
            root.cancel();
        } else {
            root.close();
        }
        accept
    }

    sheet := Rectangle {
        background: Tokens.background;
        border-width: 1px;
        border-color: Fluent.stroke;
        border-radius: Tokens.radius-card;
        drop-shadow-blur: 16px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #00000040;
    }

    layout := VerticalLayout {
        padding: 20px;
        spacing: 14px;

        top := VerticalLayout {
            spacing: 14px;

            Text {
                text: root.zone != "" ? Strings.calibrate-zone : Strings.calibrate-all;
                font-size: Tokens.font-size-title3;
                font-weight: Fluent.weight-semibold;
                color: Tokens.text;
                accessible-role: none;
            }

            if root.zone != "": Text {
                text: root.zone;
                font-size: Tokens.font-size-body;
                color: Tokens.text;
                wrap: word-wrap;
            }

            // Before a run, as the Mac's (CalibrateAllViews.swift:110-111, 182-213).
            if !root.running && !root.results-shown: before-start := VerticalLayout {
                spacing: 6px;
                accessible-role: groupbox;
                accessible-label: Strings.calibrate-before-start;

                Text {
                    text: Strings.calibrate-before-start;
                    font-size: Tokens.font-size-caption;
                    font-weight: Fluent.weight-semibold;
                    color: Tokens.secondary-text;
                    accessible-role: none;
                }

                Rectangle {
                    background: Tokens.surface;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: Tokens.separator;
                    clip: true;

                    VerticalLayout {
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            spacing: 12px;

                            CheckIcon {
                                glyph: Glyphs.microphone;
                                tint: Tokens.teal-text;
                            }

                            VerticalLayout {
                                spacing: 2px;
                                alignment: center;
                                horizontal-stretch: 1;
                                accessible-role: text;
                                accessible-label: Strings.calibrate-microphone-check + ", " + Strings.calibrate-microphone-check-detail;

                                Text {
                                    text: Strings.calibrate-microphone-check;
                                    font-size: Tokens.font-size-body;
                                    font-weight: Fluent.weight-semibold;
                                    color: Tokens.text;
                                    accessible-role: none;
                                }

                                Text {
                                    text: Strings.calibrate-microphone-check-detail;
                                    font-size: Tokens.font-size-body;
                                    color: Tokens.secondary-text;
                                    wrap: word-wrap;
                                    accessible-role: none;
                                }
                            }
                        }

                        // The warning row with its fix (CalibrateAllViews.swift:205-250).
                        if root.volume != DeviceVolumeHint.none: Rectangle {
                            height: 1px;
                            background: Tokens.separator;
                        }

                        if root.volume != DeviceVolumeHint.none: Rectangle {
                            background: Tokens.warn-background;

                            Rectangle {
                                x: 0;
                                width: 3px;
                                background: Tokens.warn;
                            }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 10px;
                                padding-bottom: 10px;
                                spacing: 12px;

                                CheckIcon {
                                    glyph: Glyphs.device-volume(root.volume);
                                    tint: Tokens.warn;
                                    solid: true;
                                }

                                VerticalLayout {
                                    spacing: 2px;
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    accessible-role: text;
                                    accessible-label: Strings.device-volume-hint-label(root.reference, root.volume, root.volume-percent) + ", " + Strings.calibrate-volume-detail(root.volume, root.reference);

                                    Text {
                                        text: Strings.device-volume-hint(root.volume, root.volume-percent);
                                        font-size: Tokens.font-size-body;
                                        font-weight: Fluent.weight-semibold;
                                        color: Tokens.text;
                                        wrap: word-wrap;
                                        accessible-role: none;
                                    }

                                    Text {
                                        text: Strings.calibrate-volume-detail(root.volume, root.reference);
                                        font-size: Tokens.font-size-body;
                                        color: Tokens.text;
                                        wrap: word-wrap;
                                        accessible-role: none;
                                    }

                                    // The volume against the low line (CalibrateAllViews.swift:260-289).
                                    if root.volume == DeviceVolumeHint.low || root.volume == DeviceVolumeHint.muted-low: VolumeMeter {
                                        percent: root.volume-percent;
                                        muted: root.volume == DeviceVolumeHint.muted-low;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;

                                    volume-fix := Button {
                                        text: Strings.device-volume-fix(root.volume);
                                        accessible-label: Strings.device-volume-fix-label(root.reference, root.volume);
                                        changed has-focus => {
                                            root.focus-changed(self.has-focus);
                                        }
                                        clicked => {
                                            // The button goes once Windows reports the
                                            // fix, so the focus moves on first.
                                            if volume-fix.has-focus {
                                                root.close-takes-focus = true;
                                            }
                                            root.fix-volume();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Before the first results: the run's progress, centered in a box.
            if root.running && !root.results-shown: Rectangle {
                background: Tokens.surface;
                border-radius: 10px;
                border-width: 1px;
                border-color: Tokens.separator;

                progress := VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 26px;
                    padding-bottom: 26px;
                    spacing: 10px;
                    alignment: center;
                    accessible-role: text;
                    accessible-label: root.status + " " + Strings.calibrate-music-fades-back;

                    HorizontalLayout {
                        alignment: center;

                        Spinner {
                            indeterminate: true;
                            width: 24px;
                            height: 24px;
                            accessible-role: none;
                        }
                    }

                    Text {
                        text: root.status;
                        font-size: Tokens.font-size-body;
                        font-weight: Fluent.weight-semibold;
                        color: Tokens.text;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                        accessible-role: none;
                    }

                    Text {
                        text: Strings.calibrate-music-fades-back;
                        font-size: Tokens.font-size-caption;
                        color: Tokens.secondary-text;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                        accessible-role: none;
                    }
                }
            }
        }

        if root.results-shown || root.left-out.length > 0: OverlayScrollView {
            height: min(rows-list.preferred-height, root.list-cap);
            content-height: rows-list.preferred-height;
            accessible-role: groupbox;
            accessible-label: Strings.calibrate-all-results;

            rows-list := VerticalLayout {
                width: root.width - 40px;
                spacing: 8px;

                for row[index] in root.rows: Rectangle {
                    background: Tokens.surface;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: Tokens.separator;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 10px;
                        padding-bottom: 10px;
                        spacing: 12px;

                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;
                            accessible-role: text;
                            accessible-label: row.name + ", " + row.detail;

                            HorizontalLayout {
                                spacing: 6px;

                                Text {
                                    text: row.name;
                                    font-size: Tokens.font-size-body;
                                    font-weight: Fluent.weight-semibold;
                                    color: Tokens.text;
                                    overflow: elide;
                                    vertical-alignment: center;
                                    accessible-role: none;
                                }

                                if row.kind != "": Text {
                                    text: row.kind;
                                    font-size: Tokens.font-size-caption;
                                    color: Tokens.secondary-text;
                                    vertical-alignment: center;
                                    accessible-role: none;
                                }

                                if row.chip != "": VerticalLayout {
                                    alignment: center;

                                    Rectangle {
                                        background: (row.chip-warn ? Tokens.warn : Tokens.teal).with-alpha(0.15);
                                        border-radius: self.height / 2;
                                        border-width: row.chip-warn ? 1px : 0px;
                                        border-color: Tokens.warn;

                                        HorizontalLayout {
                                            padding-left: 7px;
                                            padding-right: 7px;
                                            padding-top: 1px;
                                            padding-bottom: 1px;

                                            Text {
                                                text: row.chip;
                                                font-size: Tokens.font-size-caption;
                                                font-weight: Fluent.weight-semibold;
                                                color: row.chip-warn ? Tokens.text : Tokens.teal-text;
                                                accessible-role: none;
                                            }
                                        }
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                }
                            }

                            if row.value != "": HorizontalLayout {
                                spacing: 6px;

                                Text {
                                    text: row.value;
                                    font-size: 15px;
                                    font-weight: Fluent.weight-semibold;
                                    color: row.clear ? Tokens.text : Tokens.secondary-text;
                                    accessible-role: none;
                                }

                                Text {
                                    text: row.was;
                                    font-size: Tokens.font-size-body;
                                    color: Tokens.secondary-text;
                                    vertical-alignment: TextVerticalAlignment.bottom;
                                    horizontal-stretch: 1;
                                    accessible-role: none;
                                }
                            }

                            if row.note != "": Text {
                                text: row.note;
                                font-size: Tokens.font-size-caption;
                                color: row.refused ? Tokens.error-text : Tokens.secondary-text;
                                wrap: word-wrap;
                                accessible-role: none;
                            }
                        }

                        if row.can-measure-again: VerticalLayout {
                            alignment: center;

                            Button {
                                changed has-focus => {
                                    root.focus-changed(self.has-focus);
                                }
                                text: Strings.calibrate-all-again;
                                enabled: !root.running;
                                accessible-label: Strings.calibrate-all-again-label(row.name);
                                accessible-description: row.detail;
                                clicked => {
                                    root.measure-again(index);
                                }
                            }
                        }
                    }
                }

                if root.airplay != "": Rectangle {
                    background: Tokens.teal.with-alpha(0.1);
                    border-radius: 10px;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 10px;
                        padding-bottom: 10px;

                        Text {
                            text: root.airplay;
                            font-size: Tokens.font-size-body;
                            color: Tokens.text;
                            wrap: word-wrap;
                        }
                    }
                }

                // The outputs that sit out, 14 under the results as on the
                // Mac (CalibrateAllViews.swift:121-124, 430-478).
                if root.left-out.length > 0: VerticalLayout {
                    padding-top: root.results-shown ? 6px : 0px;
                    spacing: 8px;
                    accessible-role: groupbox;
                    accessible-label: Strings.calibrate-all-left-out-title;

                    // The group's label says it to Narrator.
                    Text {
                        text: Strings.calibrate-all-left-out-title;
                        font-size: Tokens.font-size-caption;
                        font-weight: Fluent.weight-semibold;
                        color: Tokens.secondary-text;
                        accessible-role: none;
                    }

                    for item in root.left-out: HorizontalLayout {
                        spacing: 10px;

                        VerticalLayout {
                            spacing: 1px;
                            horizontal-stretch: 1;
                            accessible-role: text;
                            accessible-label: item.name + ", " + item.reason;

                            Text {
                                text: item.name;
                                font-size: Tokens.font-size-body;
                                color: item.included ? Tokens.text : Tokens.secondary-text;
                                wrap: word-wrap;
                                accessible-role: none;
                            }

                            Text {
                                text: item.reason;
                                font-size: Tokens.font-size-caption;
                                color: Tokens.secondary-text;
                                wrap: word-wrap;
                                accessible-role: none;
                            }
                        }

                        if root.choosing: VerticalLayout {
                            alignment: LayoutAlignment.start;

                            Button {
                                changed has-focus => {
                                    root.focus-changed(self.has-focus);
                                }
                                text: item.included ? Strings.leave-out : Strings.include-anyway;
                                accessible-label: item.included ? Strings.leave-out-label(item.name) : Strings.include-anyway-label(item.name);
                                accessible-description: item.included ? "" : item.help;
                                clicked => {
                                    root.include(item.id, !item.included);
                                }
                            }
                        }
                    }
                }
            }
        }

        bottom := VerticalLayout {
            spacing: 14px;

            // A Measure Again under way, under the rows.
            if root.running && root.results-shown: HorizontalLayout {
                spacing: 8px;

                Spinner {
                    indeterminate: true;
                    width: 16px;
                    height: 16px;
                    accessible-role: none;
                }

                Text {
                    text: root.status;
                    font-size: Tokens.font-size-body;
                    color: Tokens.text;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }

            if !root.results-shown && !root.running && root.outcome == "" && root.blocker != "": Text {
                text: root.blocker;
                font-size: Tokens.font-size-body;
                color: Tokens.secondary-text;
                wrap: word-wrap;
            }

            if root.outcome != "": Text {
                text: root.outcome;
                font-size: Tokens.font-size-body;
                color: root.outcome-problem ? Tokens.error-text : Tokens.secondary-text;
                wrap: word-wrap;
            }

            HorizontalLayout {
                alignment: LayoutAlignment.end;

                if root.running: HorizontalLayout {
                    cancel-button := Button {
                        text: Strings.calibration-cancel;
                        accessible-label: Strings.calibration-cancel;
                        changed has-focus => {
                            root.focus-changed(self.has-focus);
                        }
                        clicked => {
                            root.cancel();
                        }
                    }

                    // Cancel takes the focus as a run starts, once the popup
                    // has taken it from the window.
                    Timer {
                        interval: 1ms;
                        triggered => {
                            cancel-button.focus();
                            self.running = false;
                        }
                    }
                }

                // As a run ends, Apply takes the focus, or Close when
                // there is nothing to apply.
                if !root.running: HorizontalLayout {
                    spacing: 10px;
                    init => {
                        if root.can-apply && root.results-shown && !root.applied {
                            root.apply-takes-focus = true;
                        } else {
                            // Once the popup has taken the focus from the window.
                            root.close-takes-focus = true;
                        }
                    }

                    // Shown once Apply went dead, it takes the focus from it.
                    if root.can-undo: HorizontalLayout {
                        init => {
                            if root.applied {
                                undo-button.focus();
                            }
                        }

                        undo-button := Button {
                            changed has-focus => {
                                root.focus-changed(self.has-focus);
                            }
                            text: Strings.calibrate-all-undo;
                            accessible-label: Strings.calibrate-all-undo-label;
                            accessible-description: root.outcome != "" ? root.outcome + " " + Strings.calibrate-all-undo-help : Strings.calibrate-all-undo-help;
                            clicked => {
                                root.undo();
                                if !root.can-undo {
                                    close-button.focus();
                                }
                            }
                        }
                    }

                    // As on the Mac, the first of the buttons (CalibrateAllViews.swift:470-472).
                    if root.privacy: Button {
                        changed has-focus => {
                            root.focus-changed(self.has-focus);
                        }
                        text: Strings.open-microphone-settings;
                        accessible-label: Strings.open-microphone-settings;
                        clicked => {
                            root.privacy-requested();
                        }
                    }

                    close-button := Button {
                        changed has-focus => {
                            root.focus-changed(self.has-focus);
                        }
                        text: root.applied ? Strings.calibrate-all-done : Strings.calibrate-all-close;
                        accessible-label: root.applied ? Strings.calibrate-all-done-label : Strings.calibrate-all-close-label;
                        accessible-description: root.outcome;
                        clicked => {
                            root.close();
                        }
                    }

                    Timer {
                        interval: 1ms;
                        running: root.close-takes-focus;
                        triggered => {
                            root.close-takes-focus = false;
                            close-button.focus();
                        }
                    }

                    // A new run before any results or after ended ones, else Apply
                    // (CalibrateAllViews.swift:507-519).
                    if !root.results-shown || root.ended: start-button := Button {
                        changed has-focus => {
                            root.focus-changed(self.has-focus);
                        }
                        text: root.zone != "" ? Strings.calibrate-zone : Strings.calibrate-all;
                        accessible-label: self.text;
                        primary: true;
                        enabled: root.can-run;
                        clicked => {
                            root.start();
                        }
                    }

                    if root.results-shown && !root.ended && !root.applied: HorizontalLayout {
                        apply-button := Button {
                            changed has-focus => {
                                root.focus-changed(self.has-focus);
                            }
                            text: Strings.calibrate-all-apply;
                            accessible-label: Strings.calibrate-all-apply;
                            primary: true;
                            enabled: root.can-apply;
                            accessible-description: Strings.calibrate-all-apply-help;
                            clicked => {
                                root.apply();
                                if !root.can-undo {
                                    close-button.focus();
                                }
                            }
                        }

                        // After every init of the run's end, whatever their order.
                        Timer {
                            interval: 1ms;
                            running: root.apply-takes-focus;
                            triggered => {
                                root.apply-takes-focus = false;
                                apply-button.focus();
                            }
                        }
                    }
                }
            }
        }
    }
}

// The Now Playing card: the track of the media session that counts for the
// chosen source, with Previous, Play or Pause, and Next, as on the Mac.
component NowPlayingCard inherits VerticalLayout {
    // The cover's side, the column's inside width.
    in property <length> cover-size;
    // The pointer is over the block: Shuffle and Repeat show, as they do
    // while one of the buttons has the keyboard focus.
    in property <bool> revealed;
    in property <string> title;
    in property <string> subtitle;
    in property <bool> playing;
    in property <bool> has-artwork;
    in property <image> artwork;
    in property <AmbientLook> ambient;
    in property <SlideLook> slide;
    in property <OutgoingSong> outgoing;
    // Where the cover sits in the window, for the incoming cover above it.
    out property <length> tile-x: place.absolute-position.x;
    out property <length> tile-y: place.absolute-position.y;
    // As the player reports them, -1 where it doesn't take the command:
    // shuffle 0 off, 1 on; repeat 0 off, 1 all, 2 one.
    in property <int> shuffle: -1;
    in property <int> repeat: -1;
    // Which button has the keyboard focus (0 to 4), -1 for none: the app
    // hands the focus on before the card hides.
    in-out property <int> focused-button: -1;
    // 0 Previous, 1 Play or Pause, 2 Next, 3 Shuffle, 4 Repeat.
    callback transport(int);

    accessible-role: groupbox;
    accessible-label: Strings.now-playing;
    property <bool> morphing;
    property <duration> morph-start;
    property <IconLook> icon: TrackMotion.icon(root.morphing ? (animation-tick() - root.morph-start) / 1s : 1);
    changed playing => {
        if Motion.on {
            root.morph-start = animation-tick();
            root.morphing = true;
        }
    }

    Timer {
        interval: 100ms;
        running: root.morphing;
        triggered => {
            root.morphing = TrackMotion.icon((animation-tick() - root.morph-start) / 1s).moving;
        }
    }

    // Slint leaves nothing focused when the focused button goes.
    changed shuffle => {
        if root.shuffle < 0 && root.focused-button == 3 {
            root.focused-button = -1;
        }
    }
    changed repeat => {
        if root.repeat < 0 && root.focused-button == 4 {
            root.focused-button = -1;
        }
    }

    // The Mac's Reveal for Shuffle and Repeat: a fade with a 4 px slide
    // from the right over 440 ms; with animation effects off, a 150 ms fade.
    property <float> reveal: root.revealed || root.focused-button >= 0 ? 1 : 0;
    animate reveal {
        duration: Motion.on ? 440ms : 150ms;
        easing: Motion.on ? ease-out : linear;
    }

    VerticalLayout {
        padding-top: 2px;
        spacing: 4px;

        // Unscaled, so the incoming cover lands where the old one shrinks from.
        place := Rectangle {
            width: root.cover-size;
            height: root.cover-size;

            tile := Rectangle {
                property <bool> has-artwork: root.slide.sliding ? root.outgoing.has-artwork : root.has-artwork;
                width: root.cover-size;
                height: root.cover-size;
                border-radius: 10px;
                clip: true;
                background: Tokens.text.with-alpha(Tokens.secondary-text-opacity * 0.15);
                transform-scale: 1 - root.slide.old-shrink;
                opacity: 1 - root.slide.old-fade;

                if tile.has-artwork: Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.slide.sliding ? root.outgoing.artwork : root.artwork;
                    image-fit: cover;
                    accessible-role: none;
                }

                if !tile.has-artwork: Glyph {
                    width: parent.width;
                    height: parent.height;
                    glyph: Glyphs.music-note;
                    color: Tokens.secondary-text;
                    font-size: 28px;
                }

                Rectangle {
                    background: #000000.with-alpha(root.slide.old-dim);
                }
            }
        }

        VerticalLayout {
            padding-top: 3px;
            padding-bottom: 3px;

            AmbientArt {
                height: 22px;
                look: root.ambient;
            }
        }

        HorizontalLayout {
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;

                // At most the Mac's lines: Segoe UI's are 2 px taller, all of
                // it leading, which the default window has no room for.
                SlidLine {
                    max-height: 20px;
                    text: root.title;
                    old-text: root.outgoing.title;
                    sliding: root.slide.sliding;
                    font-size: Tokens.font-size-title3;
                    font-weight: Fluent.weight-semibold;
                    offset: root.slide.title-offset;
                    fade: root.slide.title-fade;
                    old-offset: root.slide.old-text-offset;
                    old-fade: root.slide.old-text-fade;
                }

                if root.subtitle != "" || (root.slide.sliding && root.outgoing.subtitle != ""): SlidLine {
                    max-height: 16px;
                    text: root.subtitle;
                    old-text: root.outgoing.subtitle;
                    sliding: root.slide.sliding;
                    font-size: Tokens.font-size-callout;
                    text-color: Tokens.secondary-text;
                    offset: root.slide.subtitle-offset;
                    fade: root.slide.subtitle-fade;
                    old-offset: root.slide.old-text-offset;
                    old-fade: root.slide.old-text-fade;
                }
            }
        }

        // The Mac's centres, 34 px apart with Shuffle and Repeat (Previous,
        // Pause and Next at 91, 125 and 159 in its frames) and 50 without
        // (WindowRules.swift:66). The Mac's row is 26 high (WindowRules.swift:62)
        // 6 under the artist (MainWindow.swift:463); its centres sit at y 429,
        // where the 32 px buttons land 2 px higher than centred on it.
        Rectangle {
            height: 26px + 6px;

            transport := HorizontalLayout {
                x: (parent.width - self.width) / 2;
                y: 1px;
                width: self.preferred-width;
                height: 32px;
                spacing: root.shuffle >= 0 || root.repeat >= 0 ? 2px : 18px;

                if root.shuffle >= 0: IconButton {
                    opacity: root.reveal;
                    glyph-shift: Motion.on ? (1 - root.reveal) * 4px : 0px;
                    glyph: Glyphs.shuffle;
                    glyph-size: 21px;
                    glyph-color: root.shuffle == 1 ? Tokens.teal-text : Tokens.secondary-text;
                    active: root.shuffle == 1;
                    label: Strings.shuffle;
                    value: root.shuffle == 1 ? Strings.on : Strings.off;
                    clicked => {
                        root.transport(3);
                    }
                    focus-changed(has) => {
                        root.note-focus(3, has);
                    }
                }

                // As wide as the Mac's 16 pt backward.fill and forward.fill.
                IconButton {
                    glyph: Glyphs.previous;
                    glyph-size: 21px;
                    label: Strings.previous-track;
                    clicked => {
                        root.transport(0);
                    }
                    focus-changed(has) => {
                        root.note-focus(0, has);
                    }
                }

                IconButton {
                    glyph: root.playing != root.icon.shows-old ? Glyphs.pause : Glyphs.play;
                    glyph-size: 22px;
                    glyph-scale: root.icon.scale;
                    glyph-opacity: root.icon.opacity;
                    label: root.playing ? Strings.pause : Strings.play;
                    clicked => {
                        root.transport(1);
                    }
                    focus-changed(has) => {
                        root.note-focus(1, has);
                    }
                }

                IconButton {
                    glyph: Glyphs.next;
                    glyph-size: 21px;
                    label: Strings.next-track;
                    clicked => {
                        root.transport(2);
                    }
                    focus-changed(has) => {
                        root.note-focus(2, has);
                    }
                }

                if root.repeat >= 0: IconButton {
                    opacity: root.reveal;
                    glyph-shift: Motion.on ? (1 - root.reveal) * 4px : 0px;
                    glyph: root.repeat == 2 ? Glyphs.repeat-one : Glyphs.repeat-all;
                    glyph-size: 21px;
                    glyph-color: root.repeat > 0 ? Tokens.teal-text : Tokens.secondary-text;
                    active: root.repeat > 0;
                    label: Strings.repeat;
                    value: root.repeat == 2 ? Strings.repeat-one : root.repeat == 1 ? Strings.on : Strings.off;
                    clicked => {
                        root.transport(4);
                    }
                    focus-changed(has) => {
                        root.note-focus(4, has);
                    }
                }
            }
        }
    }

    function note-focus(button: int, has: bool) {
        if has {
            root.focused-button = button;
        } else if root.focused-button == button {
            root.focused-button = -1;
        }
    }
}

export component MainWindow inherits Window {
    in property <bool> running;
    // The header's mark breathes (mark_breath in src/window_rules.rs).
    in property <bool> mark-breathes;
    in property <string> status;
    in property <[string]> sources;
    // Each source's section and icon, in the order of sources.
    in property <[SourceLook]> source-looks;
    in property <int> source-index;
    // The chosen input device's channel pairs; none up to two channels.
    in property <[string]> input-pairs;
    in property <int> input-pair-index;
    in property <bool> source-is-input;
    // The level meter under the source, while an input device is captured.
    in property <bool> input-meter-shown;
    in property <float> input-level;
    // The level as Narrator reads it, in steps of 10 percent.
    in property <int> input-level-spoken;
    // The note under the source while an input device plays through an
    // AirPlay speaker; empty hides it.
    in property <string> live-input-hint;
    // The Several Apps submenu at the end of the source menu.
    in property <[MixAppItem]> mix-apps;
    in property <bool> mix-all-except;
    in property <float> master-volume;
    in property <int> master-volume-waves;
    in property <bool> equalizer-on;
    in property <string> equalizer-curve;
    // The Now Playing card, while a media session counts for the source.
    in property <bool> now-playing-shown;
    in property <string> now-playing-title;
    in property <string> now-playing-subtitle;
    in property <bool> now-playing-playing;
    in property <bool> now-playing-has-artwork;
    in property <image> now-playing-artwork;
    in property <AmbientLook> now-playing-ambient;
    in property <SlideLook> now-playing-slide;
    // While a slide moves, each frame takes its look at its own tick.
    in property <bool> now-playing-moving;
    property <SlideLook> now-playing-look: root.now-playing-moving ? TrackMotion.slide(animation-tick()) : root.now-playing-slide;
    in property <OutgoingSong> now-playing-outgoing;
    property <length> now-playing-tile-x;
    property <length> now-playing-tile-y;
    in property <int> now-playing-shuffle: -1;
    in property <int> now-playing-repeat: -1;
    in-out property <int> now-playing-focused-button: -1;
    in property <[SpeakerItem]> this-pc;
    in property <[SpeakerItem]> connected;
    in property <[ZoneItem]> zones;
    in property <[NoticeItem]> notices;
    // The notices not fading out.
    in property <int> notices-staying;
    in property <[PresetItem]> presets;
    in property <bool> can-save-preset: true;
    // The current preset's name; empty while none is current.
    in property <string> current-preset;
    // After a delete the Presets row takes the focus back.
    in-out property <bool> focus-presets;
    // The Presets row's list is open; saved across launches, it starts folded.
    in-out property <bool> presets-open;
    callback presets-open-changed();
    changed presets-open => {
        root.presets-open-changed();
    }
    // What Narrator says about a new notice, while the app wants it said
    // here (empty otherwise).
    in property <string> notice-announcement;
    // Settings > Show Virtual Devices: virtual outputs are listed even while off.
    in property <bool> show-virtual-devices;
    in property <Appearance> appearance;
    in property <bool> switch-source-on-quit;
    in property <bool> switch-source-on-quit-available;
    in property <bool> resume-after-sleep;
    // Settings > Launch at Sign-In: what the Run key says, read again by Rust.
    in property <bool> launch-at-login;
    // A release build that updates itself shows the updater's menu items.
    in property <bool> updater-available;
    in property <bool> check-updates-automatically;
    // Settings > Volume Keys Control AudioSync (spec S429); Windows only.
    in property <bool> volume-keys-available;
    in property <bool> volume-keys;
    // The AirPlay delay, shown while an AirPlay sender runs: what its field
    // shows (the applied value, or what is being typed).
    in property <bool> airplay-delay-shown;
    // Connected Speakers lists nothing only because Show Virtual Devices is
    // off and its outputs are virtual.
    in property <bool> connected-virtual-hidden;
    // A section holds a hidden speaker that is present: when it lists
    // nothing, its note says its speakers are hidden.
    in property <bool> this-pc-all-hidden;
    in property <bool> connected-all-hidden;
    // A section lists nothing because each of its speakers is in a zone.
    in property <[SpeakerItem]> this-pc-zoned;
    in property <[SpeakerItem]> connected-zoned;
    // Go to Zone: the zone card that scrolls into view.
    property <string> reveal-zone-id;
    function go-to-zone(id: string) {
        root.focus-zone-part = RowPart.toggle;
        root.focus-zone-id = id;
        root.reveal-zone-id = id;
    }
    // Settings > Hidden Speakers.
    in property <[HiddenItem]> hidden-speakers;
    // AirPlay discovery runs but has found no speaker for 20 seconds.
    in property <bool> airplay-none-found;
    // AirPlay discovery runs and has listed no speaker yet, short of those 20 seconds.
    in property <bool> airplay-searching;
    // Streaming is on with every speaker off.
    in property <bool> no-speaker-on;
    // What the Google Cast search says while it lists no speaker.
    in property <CastList> cast-list;
    // A Google Cast sender runs, so Add by Address… can list a speaker.
    in property <bool> cast-by-address;
    in property <string> airplay-delay-text;
    // The AirPlay delay's pane shows its steps and field; its value, beside the name.
    in property <bool> airplay-delay-open;
    in property <string> airplay-delay-value;
    // The AirPlay delay field holds typing not yet applied.
    in property <bool> airplay-delay-pending;
    // The AirPlay delay field holds a number out of range: the range and
    // what Enter applies; empty otherwise.
    in property <string> airplay-delay-range-hint;
    // A delay field, a speaker's or the AirPlay one, holds typing not yet
    // applied: Ctrl+S applies it only then.
    in property <bool> delay-typing;
    // Calibrate All Speakers (see CalibrationCard).
    in property <bool> calibrate-all-running;
    in property <bool> calibrate-all-can-start;
    in property <bool> calibrate-all-can-run;
    in property <bool> calibrate-all-shown;
    in property <bool> calibrate-all-ended;
    in property <bool> calibrate-all-choosing;
    in property <string> calibrate-all-blocker;
    in property <string> calibrate-all-status;
    in property <bool> calibrate-all-status-is-hint;
    in property <bool> calibrate-all-privacy;
    in property <bool> calibrate-all-results-shown;
    in property <[CalibrationRowItem]> calibrate-all-rows;
    in property <[LeftOutItem]> calibrate-all-left-out;
    in property <string> calibrate-all-airplay;
    in property <string> calibrate-all-zone;
    in property <string> calibrate-all-outcome;
    in property <bool> calibrate-all-outcome-problem;
    in property <bool> calibrate-all-can-apply;
    in property <bool> calibrate-all-applied;
    in property <bool> calibrate-all-can-undo;
    in property <DeviceVolumeHint> calibrate-all-volume;
    in property <int> calibrate-all-volume-percent;
    // The speaker ID the fix goes to.
    in property <string> calibrate-all-volume-id;
    in property <string> calibrate-all-reference;

    callback power-toggled(bool);
    callback source-selected(int);
    callback input-pair-selected(int);
    callback mix-app-toggled(int);
    callback mix-mode-selected(bool);
    callback master-volume-changed(float);
    callback master-mute-toggled();
    callback equalizer-requested();
    // A Now Playing button: 0 Previous, 1 Play or Pause, 2 Next.
    callback now-playing-transport(int);
    // The media sessions made a reading for the card.
    callback now-playing-read();
    callback speaker-toggled(string);
    callback speaker-volume-changed(string, float);
    callback speaker-volume-editing(string, bool);
    callback sync-toggled(string);
    callback delay-stepped(string, int);
    callback delay-edited(string, string);
    // Enter in the speaker's delay field: apply what was typed.
    callback delay-committed(string);
    // Escape in the speaker's sync controls: drop every typed delay.
    callback delay-cancelled(string);
    callback airplay-delay-stepped(int);
    callback airplay-delay-edited(string);
    callback airplay-delay-committed();
    callback airplay-delay-cancelled();
    // A click on the window outside every speaker row: apply every typed
    // delay and close the sync controls.
    callback blank-clicked();
    // For the motion test: the opacity of the state line's new text and of
    // the text it replaces.
    out property <float> status-fade-in: root.status-b-front ? header-status-other.opacity : header-status.opacity;
    out property <float> status-fade-out: root.status-b-front ? header-status.opacity : header-status-other.opacity;
    // The state line's two texts: a switch flip writes the new state into the
    // hidden one and fades it in over the other, as the Mac's line does.
    property <string> status-a;
    property <string> status-b;
    property <bool> status-b-front;
    property <bool> status-was-running;
    // The latest flip's progress, stepped by frames rather than the clock: a
    // start that keeps the UI thread busy then delays the fade instead of
    // skipping it, as the Mac's runs on while its main thread is busy.
    property <float> status-progress: 1;
    property <float> status-eased: Motion.on ? root.status-progress * root.status-progress * (3 - 2 * root.status-progress) : root.status-progress;
    // For the layout tests (src/view.rs): the left column's content and its room.
    out property <length> left-content-height: left-column.content-height;
    out property <length> left-visible-height: left-column.visible-height;
    // Ctrl+S, wherever the focus is: apply every typed delay and keep the
    // sync controls open.
    callback delay-apply-requested();
    callback auto-connect-toggled(string, bool);
    // Rename… in a speaker's menu, or a double-click on its name.
    callback speaker-rename-requested(string);
    callback speaker-rename-edited(string, string);
    // Enter in a speaker's name field: apply the name.
    callback speaker-rename-committed(string);
    // Escape in a speaker's name field: keep the old name.
    callback speaker-rename-cancelled(string);
    // A double-click on a name in an In zones row, or F2 on its switch: the
    // speaker is renamed in that row.
    callback speaker-in-zones-rename-requested(string);
    callback forget-pairing-requested(string);
    // The fix under a speaker's device-volume hint.
    callback device-volume-fix-requested(string);
    // The reference row's System slider moved by the user, 0 to 100.
    callback system-volume-requested(string, float);
    // That slider is held (true) or let go (false).
    callback system-volume-editing-requested(string, bool);
    // A Google Cast speaker's Mute or Unmute, and its Resync.
    callback cast-muted-requested(string, bool);
    callback cast-resync-requested(string);
    // Open Network Settings under the no-speakers note.
    callback network-settings-requested();
    // The speaker list's Add by Address…, and Remove on a row added that way.
    callback cast-add-address-requested();
    callback cast-remove-requested(string);
    // Hide Speaker in a speaker's menu, and an entry of Hidden Speakers.
    callback speaker-hide-requested(string);
    callback speaker-unhide-requested(string);
    // Calibrate with Microphone on a speaker's row, and its Cancel.
    callback calibrate-requested(string);
    callback cancel-calibration-requested();
    callback calibration-privacy-requested();
    callback calibrate-all-requested();
    callback cancel-calibrate-all-requested();
    callback calibrate-all-again-requested(int);
    callback calibrate-all-include-requested(string, bool);
    callback calibrate-all-apply-requested();
    callback calibrate-all-undo-requested();
    callback calibrate-all-close-requested();
    // A preset row and Ctrl+1 to Ctrl+9 recall by ID.
    callback preset-recall-requested(string);
    callback preset-rename-requested(string);
    callback preset-update-requested(string);
    callback preset-delete-requested(string);
    callback save-preset-requested();
    // Save as Preset…'s name field in the list, the preset renamed in its
    // row (empty: none) and the caption under Save as Preset….
    in-out property <bool> preset-saving;
    in-out property <string> preset-renaming;
    in-out property <string> preset-save-note;
    callback preset-save-named(string);
    callback preset-rename-named(string, string);
    callback zone-toggled(string);
    callback zone-expanded-changed(string, bool);
    callback zone-volume-changed(string, float);
    // Rename… in a zone's menu, F2 or a double-click on its name: its header
    // shows a name field, which works like a speaker's.
    callback zone-rename-requested(string);
    callback zone-rename-edited(string, string);
    callback zone-rename-committed(string);
    callback zone-rename-cancelled(string);
    callback zone-deleted(string);
    // Calibrate Zone… in a zone's menu.
    callback zone-calibrate-requested(string);
    // Use <target> Instead in a zone's menu, by the member's ID.
    callback zone-use-target-requested(string);
    // The gear's New Zone from Active Speakers… (Ctrl+N).
    callback new-zone-requested();
    // Move to Zone, New Zone… and Remove from Zone in a speaker's menu.
    callback speaker-move-to-zone-requested(string, string);
    callback speaker-new-zone-requested(string);
    callback speaker-remove-from-zone-requested(string);
    // Only This Speaker in a zone member's menu under its zone.
    callback speaker-only-this-requested(string);
    callback refresh-devices();
    callback show-virtual-devices-toggled(bool);
    callback appearance-chosen(Appearance);
    callback switch-source-on-quit-toggled(bool);
    callback resume-after-sleep-toggled(bool);
    callback launch-at-login-toggled(bool);
    callback check-updates-automatically-toggled(bool);
    callback volume-keys-toggled(bool);
    callback check-for-updates-requested();
    // The gear's Web Remote…
    callback remote-requested();
    // Settings > Check Setup… (Windows only: its rows name Windows settings).
    callback setup-requested();
    callback notice-dismissed(int);
    callback notices-dismissed-all();
    // Show How on a notice: open its guide.
    callback notice-guide-requested(int);
    // Retry on a notice: start AirPlay again.
    callback notice-retry-requested(int);
    // Open Privacy Settings on a notice.
    callback notice-privacy-requested(int);
    callback notice-update-button-pressed(UpdateButton);
    callback close-requested();
    callback exit-requested();
    // The top row's drag area and resize edges, and the pointer on its
    // maximize button as Windows reports it.
    in property <bool> maximize-hovered;
    in property <bool> maximize-pressed;
    callback drag-requested();
    callback window-menu-requested(length, length);
    callback resize-requested(int);
    callback about-requested();
    // AudioSync Guide in the gear's menu (F1): open the Guide.
    callback help-requested();
    // Settings… in the gear's menu (Ctrl+,).
    callback settings-requested();

    // Slint leaves nothing focused when a refresh removes the focused
    // control (a notice dismissed with the keyboard, a speaker unplugged):
    // Narrator goes quiet and Tab starts over. So the rows report their
    // keyboard focus, and when a refresh rebuilds the list that has it, the
    // app (src/view.rs) asks for the focus back: on the notice at this
    // index, or the speaker row or zone header with this ID (the same row, or its
    // neighbour when it went), which takes it on the given part as it is
    // built and clears the request. A row of another list, which isn't
    // rebuilt, takes it when the request names it (a list's last row went:
    // the other list's first row). Else the streaming switch takes it.
    callback notice-focus-changed(int, bool);
    callback dismiss-all-focus-changed(bool);
    callback speaker-focus-changed(string, RowPart);
    callback zone-focus-changed(string, RowPart);
    callback in-zones-focus-changed(string, RowPart);
    callback control-focus-changed(MainControl, bool);
    in-out property <int> focus-notice-index: -1;
    in-out property <string> focus-speaker-id;
    in-out property <RowPart> focus-speaker-part;
    // An In zones row, apart from the speaker's row under its zone.
    in-out property <string> focus-in-zones-id;
    in-out property <RowPart> focus-in-zones-part;
    in-out property <string> focus-zone-id;
    in-out property <RowPart> focus-zone-part;

    public function focus-streaming-switch() {
        power.focus();
    }

    // The Now Playing card is about to hide with the focus on a button.
    public function focus-source() {
        source.focus();
    }

    // Several Apps… in the tray panel: the source menu, which ends in it.
    public function open-sources() {
        source.focus();
        source.open-menu();
    }

    // A test copy's name (`AUDIOSYNC_INSTANCE`), empty for the user's copy.
    in property <string> instance-label;
    title: Strings.main-window-title + root.instance-label;
    icon: @image-url("../res/audiosync-tile-256.png");
    no-frame: true;

    // Alt or F10 puts the focus on the gear, where a menu bar's would go.
    public function focus-gear() {
        gear.focus();
    }

    // The window's shortcuts, which a system menu bar took before the window
    // drew its own: true when `text` with Ctrl (`control`) and no other
    // modifier (`others`) ran one.
    public function shortcut(text: string, control: bool, others: bool) -> bool {
        if others {
            return false;
        }
        if !control {
            if text == Key.F1 {
                root.help-requested();
                return true;
            }
            if text == Key.F5 {
                root.refresh-devices();
                return true;
            }
            return false;
        }
        if text == "s" && root.delay-typing {
            root.delay-apply-requested();
            return true;
        }
        if text == "w" {
            root.close-requested();
            return true;
        }
        if text == "r" {
            root.refresh-devices();
            return true;
        }
        if text == "q" {
            root.exit-requested();
            return true;
        }
        if text == "n" {
            root.new-zone-requested();
            return true;
        }
        if text == "e" {
            root.equalizer-requested();
            return true;
        }
        if text == "," {
            root.settings-requested();
            return true;
        }
        if text.is-float() && text.to-float() >= 1 && text.to-float() <= 9 && text.to-float() <= root.presets.length && text.character-count == 1 {
            root.preset-recall-requested(root.presets[text.to-float() - 1].id);
            return true;
        }
        return false;
    }
    // The Mac's slim window (main_zoom in src/window_rules.rs), and short
    // enough for a 1366 x 768 screen at 150 % (both columns scroll).
    min-width: 696px;
    min-height: 440px;
    preferred-width: 696px;
    preferred-height: 632px;
    background: Fluent.main-window;
    default-font-family: Fluent.font;
    default-font-weight: Fluent.weight-regular;
    default-font-size: Tokens.font-size-body;

    property <length> content-max-width: Fluent.left-column-wide + Fluent.column-gap + scroll.max-width;
    // The window's width as its columns read it: kept by a handler, since a
    // binding on it would loop through the window's own size constraints.
    property <length> columns-width;
    init => {
        self.status-a = self.status;
        self.status-was-running = self.running;
        self.columns-width = self.width;
        MenuRoom.width = self.width;
        MenuRoom.height = self.height;
    }
    changed width => {
        self.columns-width = self.width;
        MenuRoom.width = self.width;
    }
    changed height => {
        MenuRoom.height = self.height;
    }
    // The columns draw no scroll bar, so nothing keeps clear of one.
    property <length> scroll-gutter: 0px;

    // Rust sets these; a user's click or drag replaces the controls' bindings,
    // so each control's handler also sets it back to the state after its
    // callback (a change the engine refused doesn't fire these).
    changed running => {
        power.checked = root.running;
    }
    Timer {
        interval: 16ms;
        running: root.status-progress < 1;
        triggered => {
            root.status-progress = min(1, root.status-progress + 16ms / (Motion.on ? 250ms : 150ms));
        }
    }
    changed status => {
        if root.running != root.status-was-running {
            root.status-was-running = root.running;
            root.status-progress = 1 - root.status-progress;
            if root.status-b-front {
                root.status-a = root.status;
            } else {
                root.status-b = root.status;
            }
            root.status-b-front = !root.status-b-front;
        } else if root.status-b-front {
            root.status-b = root.status;
        } else {
            root.status-a = root.status;
        }
    }

    MenuRepaint { }

    // Under everything else, so only clicks no control takes reach it. On the
    // header band a press drags the window, as the Mac's whole header does.
    TouchArea {
        clicked => {
            root.blank-clicked();
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left
                && self.mouse-y >= header.y && self.mouse-y < header.y + header.height {
                root.drag-requested();
            }
        }
    }

    VerticalLayout {
        padding: Fluent.window-margin;
        // The header as high as the Mac's at 1:1, a pixel into the top row.
        padding-top: title-row.height - 1px;
        // The notices and the columns bring their gap above them, so a
        // notice opens and closes its gap with it.
        spacing: 0px;
        // The columns run on under their faded bottom edge, as the Mac's.
        padding-bottom: Fluent.window-margin - 12px;

        // Header: the brand and the state on the left, the switch on the right.
        // It and the notices end with the speaker cards.
        header := HorizontalLayout {
            spacing: 12px;
            min-height: 36px;
            max-width: root.content-max-width;
            padding-right: root.scroll-gutter;
            vertical-stretch: 0;

            VerticalLayout {
                alignment: center;
                BrandMark {
                    running: root.running;
                    breathes: root.mark-breathes;
                    width: Fluent.mark;
                    height: Fluent.mark;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;

                Wordmark {
                    size: Fluent.wordmark;
                }

                // The Mac's line, as the track's lines; one slot, so the old
                // and the new state cross-fade in place.
                Rectangle {
                    preferred-width: max(header-status.preferred-width, header-status-other.preferred-width);
                    min-height: header-status.preferred-height;
                    accessible-role: text;
                    accessible-label: root.status;

                    header-status := QuietText {
                        text: root.status-a;
                        width: parent.width;
                        height: parent.height;
                        wrap: no-wrap;
                        overflow: elide;
                        font-size: Tokens.font-size-callout;
                        opacity: root.status-b-front ? 1 - root.status-eased : root.status-eased;
                    }

                    header-status-other := QuietText {
                        text: root.status-b;
                        width: parent.width;
                        height: parent.height;
                        wrap: no-wrap;
                        overflow: elide;
                        font-size: Tokens.font-size-callout;
                        opacity: root.status-b-front ? root.status-eased : 1 - root.status-eased;
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            VerticalLayout {
                alignment: center;
                // The Mac's borderless gear is 18 pt wide (MainWindow.swift:397-408);
                // the 32 px hit area reaches 7 px past that slot on each side.
                Rectangle {
                    width: 18px;
                    height: 32px;
                    gear := GearButton {
                        x: -7px;
                        glyph-size: 16px;
                        new-zone => {
                            root.new-zone-requested();
                        }
                        refresh => {
                            root.refresh-devices();
                        }
                        remote => {
                            root.remote-requested();
                        }
                        settings => {
                            root.settings-requested();
                        }
                        guide => {
                            root.help-requested();
                        }
                        about => {
                            root.about-requested();
                        }
                        exit => {
                            root.exit-requested();
                        }
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                power := PowerSwitch {
                    text: Strings.streaming-switch;
                    checked: root.running;
                    changed has-focus => {
                        root.control-focus-changed(MainControl.power, self.has-focus);
                    }
                    toggled => {
                        root.power-toggled(self.checked);
                        // Show what the engine did, even if it refused.
                        self.checked = root.running;
                    }
                }
            }
        }

        if root.notices.length > 0: NoticeStack {
            eased: true;
            staying: root.notices-staying;
            lead: Fluent.window-gap;
            max-width: root.content-max-width;
            padding-right: root.scroll-gutter;
            notices: root.notices;
            focus-index <=> root.focus-notice-index;
            notice-focus-changed(id, focused) => {
                root.notice-focus-changed(id, focused);
            }
            dismiss-all-focus-changed(focused) => {
                root.dismiss-all-focus-changed(focused);
            }
            dismissed(id) => {
                root.notice-dismissed(id);
            }
            dismissed-all => {
                root.notices-dismissed-all();
            }
            guide-requested(id) => {
                root.notice-guide-requested(id);
            }
            retry-requested(id) => {
                root.notice-retry-requested(id);
            }
            privacy-requested(id) => {
                root.notice-privacy-requested(id);
            }
            update-button-pressed(button) => {
                root.notice-update-button-pressed(button);
            }
        }

        HorizontalLayout {
            padding-top: Fluent.window-gap;
            spacing: Fluent.column-gap;
            vertical-stretch: 1;
            // Past the speaker list's widest, the extra width stays empty on the right.
            alignment: start;

            // Left column: what plays and how loud, each in its own card. It
            // scrolls when the window is shorter than its cards (a small
            // screen, or notices showing), as the speaker list does.
            left-column := FadeScrollView {
                blank-clicked => {
                    root.blank-clicked();
                }
                width: MainColumns.left(root.columns-width);
                fade-color: root.background;
                // The Presets and Equalizer rows reach 8 px past the column.
                bleed: 8px;
                // Slint scrolls the focused control into view on every resize; the
                // Mac's scroll view keeps its place, so a resize puts it back.
                property <length> kept-y;
                property <length> kept-height;
                changed content-y => {
                    if self.visible-height == self.kept-height {
                        self.kept-y = self.content-y;
                    }
                }
                changed visible-height => {
                    self.kept-height = self.visible-height;
                    self.content-y = max(min(0px, self.visible-height - self.content-height), min(0px, self.kept-y));
                }

                VerticalLayout {
                    alignment: start;

                    // One block on a faint fill holds the source and what plays.
                    Rectangle {
                        // Its own height, which the touch area under it doesn't pass on.
                        height: hero-content.preferred-height;
                        background: Fluent.hero;
                        border-radius: Tokens.radius-card;

                        hero-touch := TouchArea {
                            hero-content := VerticalLayout {
                                padding: 14px;
                                spacing: 8px;

                                source := SourceMenu {
                                    sources: root.sources;
                                    looks: root.source-looks;
                                    index: root.source-index;
                                    is-input: root.source-is-input;
                                    changed has-focus => {
                                        root.control-focus-changed(MainControl.source, self.has-focus);
                                    }
                                    chosen(i) => {
                                        root.source-selected(i);
                                    }
                                    mix-apps: root.mix-apps;
                                    mix-all-except: root.mix-all-except;
                                    mix-mode-selected(all-except) => {
                                        root.mix-mode-selected(all-except);
                                    }
                                    mix-app-toggled(i) => {
                                        root.mix-app-toggled(i);
                                    }
                                }

                                if root.input-pairs.length > 0: VerticalLayout {
                                    spacing: 4px;

                                    SecondaryText {
                                        text: Strings.input-channels-label;
                                    }

                                    PairPicker {
                                        model: root.input-pairs;
                                        chosen: root.input-pair-index;
                                        changed has-focus => {
                                            root.control-focus-changed(MainControl.input-pair, self.has-focus);
                                        }
                                        picked(index) => {
                                            root.input-pair-selected(index);
                                        }
                                    }
                                }

                                // Always laid out, so nothing below moves when it shows.
                                LevelMeter {
                                    visible: root.input-meter-shown;
                                    level: root.input-level;
                                    spoken-percent: root.input-level-spoken;
                                    label: Strings.input-level;
                                }

                                if root.live-input-hint != "": SecondaryText {
                                    text: root.live-input-hint;
                                }

                                if root.now-playing-shown: NowPlayingCard {
                                    cover-size: MainColumns.left(root.columns-width) - 28px;
                                    revealed: hero-touch.has-hover;
                                    title: root.now-playing-title;
                                    subtitle: root.now-playing-subtitle;
                                    playing: root.now-playing-playing;
                                    has-artwork: root.now-playing-has-artwork;
                                    artwork: root.now-playing-artwork;
                                    ambient: root.now-playing-ambient;
                                    slide: root.now-playing-look;
                                    outgoing: root.now-playing-outgoing;
                                    shuffle: root.now-playing-shuffle;
                                    repeat: root.now-playing-repeat;
                                    focused-button <=> root.now-playing-focused-button;
                                    changed focused-button => {
                                        root.control-focus-changed(MainControl.transport, self.focused-button >= 0);
                                    }
                                    init => {
                                        root.now-playing-tile-x = self.tile-x;
                                        root.now-playing-tile-y = self.tile-y;
                                    }
                                    changed tile-x => {
                                        root.now-playing-tile-x = self.tile-x;
                                    }
                                    changed tile-y => {
                                        root.now-playing-tile-y = self.tile-y;
                                    }
                                    transport(button) => {
                                        root.now-playing-transport(button);
                                    }
                                }
                            }
                        }
                    }

                    // Master Volume on the window, then a hairline over the rows.
                    VerticalLayout {
                        padding-top: 16px;
                        // The number ends on the rows' chevron edge.
                        padding-right: 2px;
                        spacing: 4px;

                        // The slider's own label names it for Narrator.
                        HorizontalLayout {
                            Text {
                                text: Strings.master-volume-title;
                                font-size: Tokens.font-size-subheadline;
                                color: Tokens.secondary-text;
                                // The Mac's line; Segoe UI's is 2 px taller, all of it
                                // leading, which the default window has no room for.
                                height: 14px;
                                accessible-role: none;
                            }
                        }

                        MasterVolume {
                            // Past the last digit's bearing, as on the Mac.
                            padding-right: 1px;
                            // 8 px clear of the knob at 100.
                            number-gap: 16px;
                            button-size: 24px;
                            // The Mac's 18 (MasterMuteButton and MasterSlider, MenuBar.swift:2958, :2976).
                            row-height: 18px;
                            // Its speaker centred over the rows' icons and the track
                            // starting on their labels' column.
                            padding-left: -2px;
                            spacing: -2px;
                            volume: root.master-volume;
                            waves: root.master-volume-waves;
                            mute-toggled => {
                                root.master-mute-toggled();
                            }
                            changed slider-focused => {
                                root.control-focus-changed(MainControl.master-volume, self.slider-focused);
                            }
                            changed(value) => {
                                root.master-volume-changed(value);
                            }
                        }
                    }

                    VerticalLayout {
                        padding-top: 11px;
                        padding-bottom: 5px;

                        Divider { }
                    }

                    // The rows reach 8 px past the column, as the Mac's do, so their
                    // icons and labels line up with the master volume above.
                    VerticalLayout {
                        spacing: 6px;
                        padding-left: -8px;
                        padding-right: -8px;

                        presets-card := PresetsCard {
                            width-given: MainColumns.left(root.columns-width) + 2 * 8px;
                            presets: root.presets;
                            current: root.current-preset;
                            can-save: root.can-save-preset;
                            focus-wanted <=> root.focus-presets;
                            open <=> root.presets-open;
                            recall(id) => {
                                root.preset-recall-requested(id);
                            }
                            rename(id) => {
                                root.preset-rename-requested(id);
                            }
                            update(id) => {
                                root.preset-update-requested(id);
                            }
                            delete(id) => {
                                root.preset-delete-requested(id);
                            }
                            save => {
                                root.save-preset-requested();
                            }
                            saving <=> root.preset-saving;
                            renaming-id <=> root.preset-renaming;
                            save-why <=> root.preset-save-note;
                            save-named(text) => {
                                root.preset-save-named(text);
                            }
                            rename-named(id, text) => {
                                root.preset-rename-named(id, text);
                            }
                        }

                        equalizer-card := EqualizerCard {
                            on: root.equalizer-on;
                            curve: root.equalizer-curve;
                            clicked => {
                                root.equalizer-requested();
                            }
                            focus-changed(has) => {
                                root.control-focus-changed(MainControl.equalizer, has);
                            }
                        }

                        calibration-card := CalibrationCard {
                            can-start: root.calibrate-all-can-start;
                            status: root.calibrate-all-status;
                            status-is-hint: root.calibrate-all-status-is-hint;
                            start => {
                                root.calibrate-all-requested();
                            }
                            focus-changed(has) => {
                                root.control-focus-changed(MainControl.calibration, has);
                            }
                        }
                    }
                }
            }

            // Speakers: this PC first (few, stable rows), then zones, then
            // every connected speaker in no zone by name.
            scroll := FadeScrollView {
                blank-clicked => {
                    root.blank-clicked();
                }
                fade-color: root.background;
                horizontal-stretch: 1;
                preferred-width: Fluent.speaker-list-full;
                max-width: Fluent.speaker-list-full;

                speaker-list := VerticalLayout {
                    spacing: Tokens.spacing-section-gap;
                    padding-bottom: 4px;
                    padding-right: root.scroll-gutter;
                    // Rows keep their height when the list is shorter than the view.
                    alignment: start;

                    if root.no-speaker-on && (root.this-pc.length > 0 || root.this-pc-zoned.length > 0 || root.connected.length > 0 || root.connected-zoned.length > 0): HorizontalLayout {
                        padding-left: 4px;
                        SecondaryText {
                            text: Strings.no-speaker-on;
                            font-size: Tokens.font-size-callout;
                        }
                    }

                    SpeakerSection {
                        title: Strings.this-pc-section;
                        speakers: root.this-pc;
                        focus-id <=> root.focus-speaker-id;
                        focus-part <=> root.focus-speaker-part;
                        zoned: root.this-pc-zoned;
                        in-zones-focus-id <=> root.focus-in-zones-id;
                        in-zones-focus-part <=> root.focus-in-zones-part;
                        in-zones-rename-requested(id) => {
                            root.speaker-in-zones-rename-requested(id);
                        }
                        in-zones-focus-changed(id, part) => {
                            root.in-zones-focus-changed(id, part);
                        }
                        note: root.this-pc.length > 0 || root.this-pc-zoned.length > 0 ? "" : root.this-pc-all-hidden ? Strings.all-speakers-hidden : Strings.this-pc-none;
                        go-to-zone(id) => {
                            root.go-to-zone(id);
                        }
                        toggled(id) => {
                            root.speaker-toggled(id);
                        }
                        volume-changed(id, value) => {
                            root.speaker-volume-changed(id, value);
                        }
                        volume-editing(id, on) => {
                            root.speaker-volume-editing(id, on);
                        }
                        sync-toggled(id) => {
                            root.sync-toggled(id);
                        }
                        delay-stepped(id, delta) => {
                            root.delay-stepped(id, delta);
                        }
                        delay-edited(id, text) => {
                            root.delay-edited(id, text);
                        }
                        delay-committed(id) => {
                            root.delay-committed(id);
                        }
                        delay-cancelled(id) => {
                            root.delay-cancelled(id);
                        }
                        auto-connect-toggled(id, on) => {
                            root.auto-connect-toggled(id, on);
                        }
                        forget-pairing(id) => {
                            root.forget-pairing-requested(id);
                        }
                        device-volume-fix(id) => {
                            root.device-volume-fix-requested(id);
                        }
                        system-volume-changed(id, value) => {
                            root.system-volume-requested(id, value);
                        }
                        system-volume-editing(id, on) => {
                            root.system-volume-editing-requested(id, on);
                        }
                        rename-requested(id) => {
                            root.speaker-rename-requested(id);
                        }
                        rename-edited(id, text) => {
                            root.speaker-rename-edited(id, text);
                        }
                        rename-committed(id) => {
                            root.speaker-rename-committed(id);
                        }
                        rename-cancelled(id) => {
                            root.speaker-rename-cancelled(id);
                        }
                        cast-muted(id, muted) => {
                            root.cast-muted-requested(id, muted);
                        }
                        cast-resync(id) => {
                            root.cast-resync-requested(id);
                        }
                        cast-remove(id) => {
                            root.cast-remove-requested(id);
                        }
                        hide-requested(id) => {
                            root.speaker-hide-requested(id);
                        }
                        calibrate(id) => {
                            root.calibrate-requested(id);
                        }
                        move-to-zone(id, zone) => {
                            root.speaker-move-to-zone-requested(id, zone);
                        }
                        new-zone(id) => {
                            root.speaker-new-zone-requested(id);
                        }
                        remove-from-zone(id) => {
                            root.speaker-remove-from-zone-requested(id);
                        }
                        focus-changed(id, part) => {
                            root.speaker-focus-changed(id, part);
                        }
                        blank-clicked => {
                            root.blank-clicked();
                        }
                        cancel-calibration => {
                            root.cancel-calibration-requested();
                        }
                        calibration-privacy => {
                            root.calibration-privacy-requested();
                        }
                    }

                    if root.zones.length > 0: zone-list := VerticalLayout {
                        // The zone whose header is under the pointer.
                        property <string> hovered;
                        accessible-role: groupbox;
                        accessible-label: Strings.zones;

                        CardTitle {
                            text: Strings.zones;
                            padding-bottom: 4px;
                        }

                        for zone[index] in root.zones: ListEase {
                            fresh: zone.fresh;
                            leaving: zone.leaving;

                            ZoneCard {
                                item: zone;
                                follows-zone: index > 0;
                                divider-hidden: zone-list.hovered == zone.id || (index > 0 && zone-list.hovered == root.zones[index - 1].id && !root.zones[index - 1].expanded);
                                changed header-hovered => {
                                    if self.header-hovered {
                                        zone-list.hovered = zone.id;
                                    } else if zone-list.hovered == zone.id {
                                        zone-list.hovered = "";
                                    }
                                }
                                focus-zone-id <=> root.focus-zone-id;
                                focus-zone-part <=> root.focus-zone-part;
                                reveal-zone-id <=> root.reveal-zone-id;
                                // The card's top at the top of the list.
                                revealed(y) => {
                                    scroll.content-y = max(min(0px, scroll.visible-height - scroll.content-height), min(0px, speaker-list.absolute-position.y - y));
                                }
                                only-this(id) => {
                                    root.speaker-only-this-requested(id);
                                }
                                focus-id <=> root.focus-speaker-id;
                                focus-part <=> root.focus-speaker-part;
                                zone-toggled => {
                                    root.zone-toggled(zone.id);
                                }
                                zone-expanded-changed(open) => {
                                    root.zone-expanded-changed(zone.id, open);
                                }
                                zone-volume-changed(value) => {
                                    root.zone-volume-changed(zone.id, value);
                                }
                                zone-rename => {
                                    root.zone-rename-requested(zone.id);
                                }
                                zone-rename-edited(text) => {
                                    root.zone-rename-edited(zone.id, text);
                                }
                                zone-rename-committed => {
                                    root.zone-rename-committed(zone.id);
                                }
                                zone-rename-cancelled => {
                                    root.zone-rename-cancelled(zone.id);
                                }
                                zone-delete => {
                                    root.zone-deleted(zone.id);
                                }
                                zone-calibrate => {
                                    root.zone-calibrate-requested(zone.id);
                                }
                                zone-use-target(member) => {
                                    root.zone-use-target-requested(member);
                                }
                                zone-focus-changed(part) => {
                                    // A leaving zone hands the focus on to a neighbour.
                                    if zone.leaving && part != RowPart.none {
                                        root.focus-zone-part = part;
                                        root.focus-zone-id = zone.hand-off;
                                    } else {
                                        root.zone-focus-changed(zone.id, part);
                                    }
                                }
                                toggled(id) => {
                                    root.speaker-toggled(id);
                                }
                                volume-changed(id, value) => {
                                    root.speaker-volume-changed(id, value);
                                }
                                volume-editing(id, on) => {
                                    root.speaker-volume-editing(id, on);
                                }
                                sync-toggled(id) => {
                                    root.sync-toggled(id);
                                }
                                delay-stepped(id, delta) => {
                                    root.delay-stepped(id, delta);
                                }
                                delay-edited(id, text) => {
                                    root.delay-edited(id, text);
                                }
                                delay-committed(id) => {
                                    root.delay-committed(id);
                                }
                                delay-cancelled(id) => {
                                    root.delay-cancelled(id);
                                }
                                auto-connect-toggled(id, on) => {
                                    root.auto-connect-toggled(id, on);
                                }
                                forget-pairing(id) => {
                                    root.forget-pairing-requested(id);
                                }
                                device-volume-fix(id) => {
                                    root.device-volume-fix-requested(id);
                                }
                                system-volume-changed(id, value) => {
                                    root.system-volume-requested(id, value);
                                }
                                system-volume-editing(id, on) => {
                                    root.system-volume-editing-requested(id, on);
                                }
                                rename-requested(id) => {
                                    root.speaker-rename-requested(id);
                                }
                                rename-edited(id, text) => {
                                    root.speaker-rename-edited(id, text);
                                }
                                rename-committed(id) => {
                                    root.speaker-rename-committed(id);
                                }
                                rename-cancelled(id) => {
                                    root.speaker-rename-cancelled(id);
                                }
                                cast-muted(id, muted) => {
                                    root.cast-muted-requested(id, muted);
                                }
                                cast-resync(id) => {
                                    root.cast-resync-requested(id);
                                }
                                cast-remove(id) => {
                                    root.cast-remove-requested(id);
                                }
                                hide-requested(id) => {
                                    root.speaker-hide-requested(id);
                                }
                                calibrate(id) => {
                                    root.calibrate-requested(id);
                                }
                                move-to-zone(id, zone) => {
                                    root.speaker-move-to-zone-requested(id, zone);
                                }
                                new-zone(id) => {
                                    root.speaker-new-zone-requested(id);
                                }
                                remove-from-zone(id) => {
                                    root.speaker-remove-from-zone-requested(id);
                                }
                                focus-changed(id, part) => {
                                    if zone.leaving && part != RowPart.none {
                                        root.focus-zone-part = RowPart.options;
                                        root.focus-zone-id = zone.hand-off;
                                    } else {
                                        root.speaker-focus-changed(id, part);
                                    }
                                }
                                blank-clicked => {
                                    root.blank-clicked();
                                }
                                cancel-calibration => {
                                    root.cancel-calibration-requested();
                                }
                                calibration-privacy => {
                                    root.calibration-privacy-requested();
                                }
                            }
                        }
                    }

                    SpeakerSection {
                        title: Strings.connected-section;
                        speakers: root.connected;
                        zoned: root.connected-zoned;
                        in-zones-focus-id <=> root.focus-in-zones-id;
                        in-zones-focus-part <=> root.focus-in-zones-part;
                        in-zones-rename-requested(id) => {
                            root.speaker-in-zones-rename-requested(id);
                        }
                        in-zones-focus-changed(id, part) => {
                            root.in-zones-focus-changed(id, part);
                        }
                        go-to-zone(id) => {
                            root.go-to-zone(id);
                        }
                        focus-id <=> root.focus-speaker-id;
                        focus-part <=> root.focus-speaker-part;
                        // Linux has no Settings page to open.
                        show-network-settings: root.airplay-none-found && Platform.os != OperatingSystemType.linux;
                        network-settings => {
                            root.network-settings-requested();
                        }
                        show-add-address: root.cast-by-address;
                        focus-add-address: root.cast-sheet-closed;
                        add-address => {
                            root.cast-add-address-requested();
                        }
                        // While AirPlay finds nothing, the note says what to
                        // check, after the hidden virtual outputs' note; until
                        // then an empty list says it looks, as the tray flyout
                        // does. The Google Cast search's note comes last, or one
                        // sentence when neither finds a speaker.
                        property <bool> both-none: root.airplay-none-found && root.cast-list == CastList.none-found;
                        property <string> none-found: self.both-none ? Strings.network-none-found : Strings.airplay-none-found;
                        property <string> list-note: root.airplay-none-found ? (root.connected-virtual-hidden ? Strings.connected-none-virtual-hidden + "\n" + self.none-found : self.none-found) : root.connected.length > 0 || root.connected-zoned.length > 0 ? "" : root.connected-all-hidden ? Strings.all-speakers-hidden : root.airplay-searching ? (root.cast-list == CastList.none-found || root.cast-list == CastList.failed ? Strings.looking-for-airplay-speakers : Strings.looking-for-speakers) : root.connected-virtual-hidden ? Strings.connected-none-virtual-hidden + "\n" + Strings.connected-none : Strings.connected-none;
                        property <string> cast-note: self.both-none || self.list-note == Strings.looking-for-speakers ? "" : Strings.cast-list(root.cast-list);
                        note: self.cast-note == "" ? self.list-note : self.list-note == "" || self.list-note == Strings.connected-none ? self.cast-note : self.list-note + " " + self.cast-note;
                        toggled(id) => {
                            root.speaker-toggled(id);
                        }
                        volume-changed(id, value) => {
                            root.speaker-volume-changed(id, value);
                        }
                        volume-editing(id, on) => {
                            root.speaker-volume-editing(id, on);
                        }
                        sync-toggled(id) => {
                            root.sync-toggled(id);
                        }
                        delay-stepped(id, delta) => {
                            root.delay-stepped(id, delta);
                        }
                        delay-edited(id, text) => {
                            root.delay-edited(id, text);
                        }
                        delay-committed(id) => {
                            root.delay-committed(id);
                        }
                        delay-cancelled(id) => {
                            root.delay-cancelled(id);
                        }
                        auto-connect-toggled(id, on) => {
                            root.auto-connect-toggled(id, on);
                        }
                        forget-pairing(id) => {
                            root.forget-pairing-requested(id);
                        }
                        device-volume-fix(id) => {
                            root.device-volume-fix-requested(id);
                        }
                        system-volume-changed(id, value) => {
                            root.system-volume-requested(id, value);
                        }
                        system-volume-editing(id, on) => {
                            root.system-volume-editing-requested(id, on);
                        }
                        rename-requested(id) => {
                            root.speaker-rename-requested(id);
                        }
                        rename-edited(id, text) => {
                            root.speaker-rename-edited(id, text);
                        }
                        rename-committed(id) => {
                            root.speaker-rename-committed(id);
                        }
                        rename-cancelled(id) => {
                            root.speaker-rename-cancelled(id);
                        }
                        cast-muted(id, muted) => {
                            root.cast-muted-requested(id, muted);
                        }
                        cast-resync(id) => {
                            root.cast-resync-requested(id);
                        }
                        cast-remove(id) => {
                            root.cast-remove-requested(id);
                        }
                        hide-requested(id) => {
                            root.speaker-hide-requested(id);
                        }
                        calibrate(id) => {
                            root.calibrate-requested(id);
                        }
                        move-to-zone(id, zone) => {
                            root.speaker-move-to-zone-requested(id, zone);
                        }
                        new-zone(id) => {
                            root.speaker-new-zone-requested(id);
                        }
                        remove-from-zone(id) => {
                            root.speaker-remove-from-zone-requested(id);
                        }
                        focus-changed(id, part) => {
                            root.speaker-focus-changed(id, part);
                        }
                        blank-clicked => {
                            root.blank-clicked();
                        }
                        cancel-calibration => {
                            root.cancel-calibration-requested();
                        }
                        calibration-privacy => {
                            root.calibration-privacy-requested();
                        }

                        delay-pane := FoldPane {
                            open: root.airplay-delay-shown;

                            if delay-pane.shown: VerticalLayout {
                                // From the names, as between speaker rows (MainWindow.swift:636).
                                if root.connected.length > 0: HorizontalLayout {
                                    padding-left: Fluent.name-inset;
                                    Divider { }
                                }

                                AirPlayDelayControls {
                                    width-given: scroll.width - root.scroll-gutter;
                                    delay-text: root.airplay-delay-text;
                                    open: root.airplay-delay-open;
                                    value: root.airplay-delay-value;
                                    toggled => {
                                        root.sync-toggled("airplay-delay");
                                    }
                                    pending: root.airplay-delay-pending;
                                    range-hint: root.airplay-delay-range-hint;
                                    stepped(delta) => {
                                        root.airplay-delay-stepped(delta);
                                    }
                                    edited(text) => {
                                        root.airplay-delay-edited(text);
                                    }
                                    committed => {
                                        root.airplay-delay-committed();
                                    }
                                    cancelled => {
                                        root.airplay-delay-cancelled();
                                    }
                                    focus-changed(has) => {
                                        root.control-focus-changed(MainControl.airplay-delay, has);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.now-playing-shown && root.now-playing-look.sliding: IncomingCover {
        look: root.now-playing-look;
        at-x: root.now-playing-tile-x;
        at-y: root.now-playing-tile-y;
        size: MainColumns.left(root.columns-width) - 28px;
        surface-width: root.width;
        corner: 10px;
        base: Fluent.main-window;
        fill: Tokens.text.with-alpha(Tokens.secondary-text-opacity * 0.15);
        has-artwork: root.now-playing-has-artwork;
        artwork: root.now-playing-artwork;
        glyph: Glyphs.music-note;
        glyph-size: 28px;
    }

    Announcer {
        said: root.notice-announcement;
    }

    // Calibrate All's run and results, over everything under the top row:
    // a popup, so Tab stays in the sheet.
    // A run that failed or stopped before any results keeps the sheet open
    // with its line, as the Mac's (CalibrateAllViews.swift:145-148).
    property <bool> calibrate-sheet-shown: root.calibrate-all-shown || root.calibrate-all-running || root.calibrate-all-results-shown || root.calibrate-all-outcome != "";
    changed calibrate-sheet-shown => {
        if self.calibrate-sheet-shown {
            calibrate-sheet.show();
        } else {
            calibrate-sheet.close();
            // Calibrate All disabled: the card above takes the focus.
            if root.calibrate-all-can-start {
                calibration-card.focus-row();
            } else {
                equalizer-card.focus();
            }
        }
    }

    calibrate-sheet := PopupWindow {
        x: 0;
        y: title-row.height;
        width: root.width;
        height: root.height - title-row.height;
        close-policy: no-auto-close;

        // Takes the clicks meant for the window under the sheet.
        TouchArea {
            Rectangle {
                background: #00000033;
            }
        }

        CalibrateAllSheet {
            x: (parent.width - self.width) / 2;
            // A gap under the title row, so the sheet's top edge shows.
            y: Fluent.window-margin / 2;
            room: parent.height - Fluent.window-margin;
            room-width: parent.width;
            running: root.calibrate-all-running;
            status: root.calibrate-all-status;
            results-shown: root.calibrate-all-results-shown;
            rows: root.calibrate-all-rows;
            airplay: root.calibrate-all-airplay;
            zone: root.calibrate-all-zone;
            outcome: root.calibrate-all-outcome;
            outcome-problem: root.calibrate-all-outcome-problem;
            can-apply: root.calibrate-all-can-apply;
            applied: root.calibrate-all-applied;
            can-undo: root.calibrate-all-can-undo;
            volume: root.calibrate-all-volume;
            volume-percent: root.calibrate-all-volume-percent;
            reference: root.calibrate-all-reference;
            privacy: root.calibrate-all-privacy;
            ended: root.calibrate-all-ended;
            can-run: root.calibrate-all-can-run;
            blocker: root.calibrate-all-blocker;
            left-out: root.calibrate-all-left-out;
            choosing: root.calibrate-all-choosing;
            start => {
                root.calibrate-all-requested();
            }
            include(id, included) => {
                root.calibrate-all-include-requested(id, included);
            }
            fix-volume => {
                root.device-volume-fix-requested(root.calibrate-all-volume-id);
            }
            privacy-requested => {
                root.calibration-privacy-requested();
            }
            cancel => {
                root.cancel-calibrate-all-requested();
            }
            measure-again(row) => {
                root.calibrate-all-again-requested(row);
            }
            apply => {
                root.calibrate-all-apply-requested();
            }
            undo => {
                root.calibrate-all-undo-requested();
            }
            close => {
                root.calibrate-all-close-requested();
            }
            focus-changed(has) => {
                root.control-focus-changed(MainControl.calibration, has);
            }
        }
    }

    // Add by Address, as the Mac's sheet: centred over the window under a
    // scrim that blocks the whole window, its top row too, and a popup so Tab
    // stays in it. Closing hands the focus back to Add by Address….
    property <bool> cast-sheet-shown: CastSheet.shown;
    property <int> cast-sheet-closed;
    changed cast-sheet-shown => {
        if self.cast-sheet-shown {
            cast-sheet.show();
        } else {
            cast-sheet.close();
            self.cast-sheet-closed += 1;
        }
    }

    cast-sheet := PopupWindow {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        close-policy: no-auto-close;

        // Takes the clicks meant for the window under the sheet.
        cast-scrim := TouchArea {
            Rectangle {
                background: Tokens.dark ? #00000066 : #00000030;
            }
        }

        CastAddressSheet {
            x: (parent.width - self.width) / 2;
            y: max(0px, (parent.height - self.height) / 2);
        }
    }

    // The top row in place of the system title bar, as the Mac's transparent
    // one: room to drag the window by and the window's own buttons
    // (src/title_bar.rs hit-tests the same sizes for Windows).
    title-row := HorizontalLayout {
        y: 0;
        height: 32px;

        TouchArea {
            horizontal-stretch: 1;
            double-clicked => {
                root.maximized = !root.maximized;
            }
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    root.drag-requested();
                }
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                    root.window-menu-requested(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
        }

        WindowButton {
            shape: "minimize";
            label: Strings.window-minimize;
            clicked => {
                root.minimized = true;
            }
        }

        WindowButton {
            shape: root.maximized ? "restore" : "maximize";
            label: root.maximized ? Strings.window-restore : Strings.window-maximize;
            system-hover: root.maximize-hovered;
            system-pressed: root.maximize-pressed;
            clicked => {
                root.maximized = !root.maximized;
            }
        }

        WindowButton {
            shape: "close";
            label: Strings.window-close;
            clicked => {
                root.close-requested();
            }
        }
    }

    // On top of everything, along the edges, in title_bar::Edge's order.
    if !root.maximized: Rectangle {
        ResizeEdge {
            edge: 0;
            x: 8px;
            y: 8px;
            width: parent.width - 16px;
            height: 8px;
            mouse-cursor: ns-resize;
            resize(edge) => {
                root.resize-requested(edge);
            }
        }

        ResizeEdge {
            edge: 1;
            x: 8px;
            y: parent.height - 8px;
            width: parent.width - 16px;
            height: 8px;
            mouse-cursor: ns-resize;
            resize(edge) => {
                root.resize-requested(edge);
            }
        }

        ResizeEdge {
            edge: 2;
            x: parent.width - 8px;
            y: 8px;
            width: 8px;
            height: parent.height - 16px;
            mouse-cursor: ew-resize;
            resize(edge) => {
                root.resize-requested(edge);
            }
        }

        ResizeEdge {
            edge: 3;
            x: 0;
            y: 8px;
            width: 8px;
            height: parent.height - 16px;
            mouse-cursor: ew-resize;
            resize(edge) => {
                root.resize-requested(edge);
            }
        }

        ResizeEdge {
            edge: 4;
            x: parent.width - 8px;
            y: 0;
            width: 8px;
            height: 8px;
            mouse-cursor: nesw-resize;
            resize(edge) => {
                root.resize-requested(edge);
            }
        }

        ResizeEdge {
            edge: 5;
            x: 0;
            y: 0;
            width: 8px;
            height: 8px;
            mouse-cursor: nwse-resize;
            resize(edge) => {
                root.resize-requested(edge);
            }
        }

        ResizeEdge {
            edge: 6;
            x: parent.width - 8px;
            y: parent.height - 8px;
            width: 8px;
            height: 8px;
            mouse-cursor: nwse-resize;
            resize(edge) => {
                root.resize-requested(edge);
            }
        }

        ResizeEdge {
            edge: 7;
            x: 0;
            y: parent.height - 8px;
            width: 8px;
            height: 8px;
            mouse-cursor: nesw-resize;
            resize(edge) => {
                root.resize-requested(edge);
            }
        }
    }
}
